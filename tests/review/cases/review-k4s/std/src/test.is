(, (= syntax (/ i syntax)) (= int (/ std int)))
(, tests test skip only fails suite each)
(= tests Nil)
(= text
  (-> (, x) _
    (|> ((. syntax node) x)
        (| (-> (, ((. syntax Text) s)) _ s)
          (-> (, _) _ (panic "test name must be a string literal"))))))
(= _entry
  (-> (, name body mode) (<- _ (, (: items (. syntax Items))))
    {(= target `generated_test)
     ((. items add) `tests target [(, "name" (text name)) (, "mode" mode)] name)
     `(= ~target (-> (,) _ {(~body)}))}))
(@ macro
  (= test
    (-> (, name body) (<- _ (, (: items (. syntax Items))))
      (_entry name body "test"))))
(@ macro
  (= skip
    (-> (, name body) (<- _ (, (: items (. syntax Items))))
      (_entry name body "skip"))))
(@ macro
  (= only
    (-> (, name body) (<- _ (, (: items (. syntax Items))))
      (_entry name body "only"))))
(@ macro
  (= fails
    (-> (, name body) (<- _ (, (: items (. syntax Items))))
      (_entry name body "fails"))))
(= append
  (-> (, xs ys) _
    (|> xs
        (| (-> (, []) _ ys) (-> (, [x .. rest]) _ [x .. (append rest ys)])))))
(= statements_of
  (-> (, body) _
    (|> body
        (| (-> (, `(-> (,) _ {~..statements})) _ statements)
          (-> (, `(-> (,) _ ~statement)) _ [statement])
          (-> (, _) _ (panic "suite body must be a zero-argument function"))))))
(= provide
  (-> (, target env) _
    (|> env
        (| (-> (, []) _ target)
          (-> (, [services .. rest]) _
            (provide `(<- ~target ~services) rest))))))
(= suite_statement
  (-> (, prefix statement env) _
    (|>
     statement
     (| (-> (, `(<- ~target ~services)) _
          (|> target
              (| (-> (, `{~..children}) _
                   (suite_items prefix children [services .. env]))
                (-> (, _) _
                  (suite_statement prefix target [services .. env])))))
       (-> (, `(suite ~name ~body)) _
         (suite_items (<> (<> prefix (text name)) " / ")
                      (statements_of body)
                      env))
       (-> (, `((. ~module suite) ~name ~body)) _
         (suite_items (<> (<> prefix (text name)) " / ")
                      (statements_of body)
                      env))
       (-> (, `(~callee ~name ~cases ~body)) _
         {(= full
            ((. syntax make) ((. syntax Text) (<> prefix (text name))) name))
          (= wrapped `(-> (, case_value) _ ~(provide `(~body case_value) env)))
          [`(~callee ~full ~cases ~wrapped)]})
       (-> (, `(~callee ~name ~body)) _
         {(= full
            ((. syntax make) ((. syntax Text) (<> prefix (text name))) name))
          (= wrapped `(-> (,) _ ~(provide `(~body) env)))
          [`(~callee ~full ~wrapped)]})
       (-> (, _) _
         (panic
          "suite body expects tests, suites, and environment statements"))))))
(= suite_items
  (-> (, prefix statements env) _
    (|> statements
        (| (-> (, []) _ [])
          (-> (, [statement .. rest]) _
            (append (suite_statement prefix statement env)
                    (suite_items prefix rest env)))))))
(@ macro
  (= suite
    (-> (, name body) _
      `{~..(suite_items (<> (text name) " / ") (statements_of body) [])})))
(= case_items
  (-> (, prefix cases body index) (<- _ (, (: items (. syntax Items))))
    (|> cases
        (| (-> (, []) _ [])
          (-> (, [case .. rest]) _
            (|> case
                (| (-> (, `(, ~name ~value)) _
                     {(= full
                        ((. syntax make)
                         ((. syntax Text) (<> (<> prefix " / ") (text name)))
                         name))
                      (= target
                        ((. syntax make)
                         ((. syntax Name)
                          (<> "generated_test_" ((. int to_string) index)))
                         `generated_test))
                      ((. items add)
                       `tests
                       target
                       [(, "name" (text full)) (, "mode" "test")]
                       name)
                      [`(= ~target (-> (,) _ {(~body ~value)}))
                       ..
                       (case_items prefix rest body (+ index 1))]})
                  (-> (, _) _
                    (panic "each case must be a (name, value) tuple")))))))))
(@ macro
  (= each
    (-> (, name cases body) (<- _ (, (: items (. syntax Items))))
      (|> cases
          (| (-> (, `[~..values]) _
               `{~..(case_items (text name) values body 0)})
            (-> (, _) _ (panic "each expects a list of cases")))))))
