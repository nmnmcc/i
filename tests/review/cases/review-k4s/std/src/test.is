(, (= syntax (/ i syntax)) (= int (/ std int)))
(, tests test skip only fails suite each)
(= tests Nil)
(= text
  (-> (, x) _
    (|> ((. syntax node) x)
        (| (-> (, ((. syntax Node) ((. syntax Text) s))) _ s)
          (-> (, _) _ (panic "test name must be a string literal"))))))
(= _entry
  (-> (, name body mode) (<- _ (, (: items (. syntax Items))))
    {(= target `generated_test)
     ((. items add) `tests target [(, "name" (text name)) (, "mode" mode)] name)
     `(= ~target (-> (,) _ {(~body)}))}))
(@ macro
  (= test
    (-> (, name body) (<- _ (, (: items (. syntax Items))))
      (_entry name body "test"))))
(@ macro
  (= skip
    (-> (, name body) (<- _ (, (: items (. syntax Items))))
      (_entry name body "skip"))))
(@ macro
  (= only
    (-> (, name body) (<- _ (, (: items (. syntax Items))))
      (_entry name body "only"))))
(@ macro
  (= fails
    (-> (, name body) (<- _ (, (: items (. syntax Items))))
      (_entry name body "fails"))))
(= append
  (-> (, xs ys) _
    (|> xs
        (| (-> (, []) _ ys) (-> (, [x .. rest]) _ [x .. (append rest ys)])))))
(= suite_items
  (-> (, prefix statements env) _
    (|>
     statements
     (| (-> (, []) _ [])
       (-> (, [statement .. rest]) _
         (|>
          statement
          (| (-> (, `(! ~service ~value)) _
               (suite_items prefix rest (append env [statement])))
            (-> (, `(suite ~name (-> (,) _ {~..children}))) _
              (append
               (suite_items (<> (<> prefix (text name)) " / ") children env)
               (suite_items prefix rest env)))
            (-> (, `((. ~module suite) ~name (-> (,) _ {~..children}))) _
              (append
               (suite_items (<> (<> prefix (text name)) " / ") children env)
               (suite_items prefix rest env)))
            (-> (, `(~callee ~name ~cases ~body)) _
              {(= full
                 ((. syntax make)
                  ((. syntax Node) ((. syntax Text) (<> prefix (text name))))
                  name))
               (= wrapped `(-> (, case_value) _ {~..env (~body case_value)}))
               [`(~callee ~full ~cases ~wrapped)
                ..
                (suite_items prefix rest env)]})
            (-> (, `(~callee ~name ~body)) _
              {(= full
                 ((. syntax make)
                  ((. syntax Node) ((. syntax Text) (<> prefix (text name))))
                  name))
               (= wrapped `(-> (,) _ {~..env (~body)}))
               [`(~callee ~full ~wrapped) .. (suite_items prefix rest env)]})
            (-> (, _) _
              (panic
               "suite body expects tests, suites, and environment statements")))))))))
(@ macro
  (= suite
    (-> (, name body) _
      (|> body
          (| (-> (, `(-> (,) _ {~..statements})) _
               `{~..(suite_items (<> (text name) " / ") statements [])})
            (-> (, _) _
              (panic "suite body must be a zero-argument function")))))))
(= case_items
  (-> (, prefix cases body index) (<- _ (, (: items (. syntax Items))))
    (|> cases
        (| (-> (, []) _ [])
          (-> (, [case .. rest]) _
            (|> case
                (| (-> (, `(, ~name ~value)) _
                     {(= full
                        ((. syntax make)
                         ((. syntax Node) ((. syntax Text) (<> (<> prefix " / ") (text name))))
                         name))
                      (= target
                        ((. syntax make)
                         ((. syntax Node)
                          ((. syntax Name)
                           (<> "generated_test_" ((. int to_string) index))))
                         `generated_test))
                      ((. items add)
                       `tests
                       target
                       [(, "name" (text full)) (, "mode" "test")]
                       name)
                      [`(= ~target (-> (,) _ {(~body ~value)}))
                       ..
                       (case_items prefix rest body (+ index 1))]})
                  (-> (, _) _
                    (panic "each case must be a (name, value) tuple")))))))))
(@ macro
  (= each
    (-> (, name cases body) (<- _ (, (: items (. syntax Items))))
      (|> cases
          (| (-> (, `[~..values]) _
               `{~..(case_items (text name) values body 0)})
            (-> (, _) _ (panic "each expects a list of cases")))))))
