A(N) = (() <- N -> Int)
B(N) = (() <- N -> Int)
ua = <N>() <- (s: A(N)) {
	A(f) = s
	f()
}
ub = <N>() <- (s: B(N)) {
	B(f) = s
	f()
}
bad1 = () { 1 <- (A(() { ub() + 1 })) }
mk = () -> A(B(A(Never))) { A(() { ub() + 1 }) }
bad2 = () { 2 <- (B(() { ua() }), A(() { ub() + 1 })) }
bad3 = () { ua() <- (B(() { ua() }), A(() { ub() + 1 })) }
