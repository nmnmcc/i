fn main() {
 for path in std::env::args().skip(1) {
  println!("PROJECT {path}");
  let (graph, mut diags) = ilang_package::load(std::path::Path::new(&path));
  let checked = ilang_check::check(&graph);
  if let (Some(p),Some(ts)) = (&checked.program,&checked.types) {
   for (i,m) in p.modules.iter().enumerate() {
    if Some(m.package)==graph.root {
     for line in ts.lines(p, ilang_check::hir::ModuleId(i as u32)) { println!("{line}"); }
    }
   }
  }
  diags.extend(checked.diags);
  for d in diags { println!("{}",graph.sources.render(&d)); }
 }
}
