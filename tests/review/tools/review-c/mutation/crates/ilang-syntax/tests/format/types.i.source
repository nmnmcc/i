Alias(a) = (a) -> { (Int) -> Int } ! Assert | Nil

Wide(a, b) = (first_parameter_type: List(a), second_parameter_type: Dict(a, b), third: Int) -> Bool

Handler = { (Int) -> Int } | { (String) -> String }

@external("env", "log")
log: (String) -> Nil

apply = (f: (Int) -> Int ? E ! N, x: Int | Float - Nil & Any) -> Int ? E ! N { f(x) }
