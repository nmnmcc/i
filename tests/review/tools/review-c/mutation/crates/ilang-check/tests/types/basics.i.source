// Rule 2: literals; rule 6: tuples and lists; rule 8: operators.
one = 1
pi = 3.14
hello = "hello"
pair = (1, "a")
unit = ()
ints = [1, 2, 3]
mixed = [1, "a"]
empty = []
sum = 1 + 2 * 3
ratio = 1.0 /. 2.0
neg = -1
both = True && False
cmp = 1 < 2
text = "a" <> "b"
same = 1 == "a"

// Rule 4: functions; rule 3: names.
id = (x) { x }
const = (x, y) { x }
add = (x, y) { x + y }
inc = (x) { x + 1  x }
apply = (f, x) { f(x) }
compose = (f, g) { (x) { f(g(x)) } }
twice = (f, x) { f(f(x)) }
ignore = (x) { 1 }
