use ilang_host::{Program, HostOptions, HostImports, Value, block_on};
fn main() {
    for name in ["missing-continue", "missing-resume"] {
        let program = Program::from_bytes(&std::fs::read(format!("/tmp/review-c/{name}.wasm")).unwrap()).unwrap();
        let mut imports = HostImports::default();
        imports.async_service("test:work/v1", "work", |_| async { Ok(Ok(Value::Nil)) }).unwrap();
        let mut instance = program.instantiate(HostOptions::new(imports)).unwrap();
        let result = block_on(instance.call_async("app/run", &[]));
        println!("{name}: {result:?}; unusable={:?}", instance.unusable());
        println!("sync call: {:?}",instance.call("app/sync", &[]));
    }
}
