+    const { instantiate, hostImports, gateService, fold, requestSignal, GuestError } = await eval(loader)();
+    const module = await WebAssembly.compile(await (await fetch("/tests/browser/fixtures/host-abi.wasm")).arrayBuffer());
+    const wrong = [];
