import {readFile} from 'node:fs/promises';
import {instantiate} from '/home/agent/Programming/i/.rd/note-js/bindings/javascript/ilang.mjs';
const mem = new Uint8Array(65536), view = new DataView(mem.buffer);
const live = new Map(); let next=1024, output=[];
const root = {
  alloc(size) { const p=next; next += Number(size)+8; live.set(p,Number(size)); return BigInt(p); },
  free(address,size) { if(live.get(Number(address))!==Number(size))throw Error('invalid free');live.delete(Number(address)); },
  store(address,bits) { mem.set(bits.bytes,Number(address)); },
  load(address,size) { return {bytes:mem.slice(Number(address),Number(address+size)),bitLength:Number(size)*8}; },
  fd_write(fd,buffers,count,written) {
    if(fd!==1n)throw Error('wrong fd');
    let n=0, budget=2;
    for(let k=0;k<Number(count)&&budget;k++) {
      const a=view.getUint32(Number(buffers)+8*k,true);
      const len=Math.min(view.getUint32(Number(buffers)+8*k+4,true),budget);
      output.push(...mem.slice(a,a+len)); n+=len;budget-=len;
    }
    view.setUint32(Number(written),n,true);return 0n;
  }
};
const app=await instantiate(await readFile('/tmp/review-js/write.wasm'),{imports:{'probe:wasi/v1':root}});
await app.run();
console.log(JSON.stringify({output:new TextDecoder().decode(Uint8Array.from(output)),liveAllocations:live.size}));
