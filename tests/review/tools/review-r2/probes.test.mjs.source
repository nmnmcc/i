import test from 'node:test';
import assert from 'node:assert/strict';
import {readFile,writeFile} from 'node:fs/promises';
import * as sdk from '/home/agent/Programming/i/.rd/b/bindings/javascript/ilang.mjs';
const cases={
 lifetime:['body','child','after'],
 cancel_send:['inner','outer','outer-done','Error("boom")'],
 cancel_choose:['withdrawn','clean'],
 shield_nested:['cleanup-start','fresh-child','fresh-final','cleanup-end','Error("outer")'],
 join_failure:['parent-final','child-final','Error("boom")'],
 race_tie:['left-final','right-final','1'],
 choice_commit:['mapper','once'],
 local_capture:['pinned'],senders_32:['fifo-ok'],
 request_groups:[],request_reuse:[],
 // Record observed behavior of the suspect cases; these assertions confirm reproduction, not correctness.
 cancel_normal_final:['final-start','Error("boom")'],
 cancel_error_final:['final-start','Error("parent")'],
 determinism:null,
};
const observed={};
for(const [name,expected] of Object.entries(cases)) test(`independent ${name} O0/O2`,async()=>{
 let previous;
 for(const opt of [0,2]) {
  const stem=`/tmp/review-r2/${name}/o${opt}`;
  const bytes=await readFile(stem+'.wasm');const plan=JSON.parse(await readFile(stem+'.bindings.json','utf8'));
  const bindings=await sdk.authorizeBindings(bytes,plan,()=>true);const printed=[];
  const value=await sdk.instantiate(bindings.module,{bindings,imports:{'i:io/v1':{print:s=>{printed.push(s);}},'test:async/v1':{echo:s=>Promise.resolve(s)}}});
  await value.run();
  if(expected)assert.deepEqual(printed,expected);
  if(previous)assert.deepEqual(printed,previous);
  previous=printed;
  observed[name+opt]=printed;
  value.dispose();
 }
 await writeFile('/tmp/review-r2/node-observed.json',JSON.stringify(observed,null,2));
});
for (const name of ['borrow_owned','wait_any_unlisted','pure_fake','request_stop']) test(`independent request lifecycle ${name}`,async()=>{
 for (const opt of [0,2]) {
  const stem=`/tmp/review-r2/${name}/o${opt}`;
  const bytes=await readFile(stem+'.wasm');const plan=JSON.parse(await readFile(stem+'.bindings.json','utf8'));
  const bindings=await sdk.authorizeBindings(bytes,plan,()=>true); const starts=[];
  const value=await sdk.instantiate(bindings.module,{bindings,contextImports:{'test:async/v1':{echo(context,s){starts.push({context,signal:sdk.requestSignal(),s});return name==='request_stop'?new Promise(()=>{}):Promise.resolve(s);}}}});
  assert.equal(value.abi.entry.async,name!=='pure_fake');
  if(name==='request_stop') await assert.rejects(async()=>value.run(),e=>e instanceof sdk.Stop&&e.stopMessage.startsWith('panic: stop-before-answer'));
  else await value.run();
  assert(starts.every(s=>!s.context.live));
  if(name==='request_stop') assert.equal(starts[0].signal.aborted,true);
  if(name==='borrow_owned')assert.equal(starts.find(s=>s.s==='own').signal.aborted,true);
  value.dispose();
 }
});
