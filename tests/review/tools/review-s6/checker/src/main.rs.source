fn main() {
    let dir = std::env::args().nth(1).unwrap();
    let (graph, diags) = ilang_package::load(std::path::Path::new(&dir));
    for d in &diags { println!("{}", graph.sources.render(d)); }
    let checked = ilang_check::check(&graph);
    for d in &checked.diags { println!("{}", graph.sources.render(d)); }
    if let (Some(p), Some(t)) = (&checked.program, &checked.types) {
        for (i, m) in p.modules.iter().enumerate() {
            if Some(m.package) == graph.root {
                for line in t.lines(p, ilang_check::hir::ModuleId(i as u32)) { println!("{line}"); }
            }
        }
    }
}
