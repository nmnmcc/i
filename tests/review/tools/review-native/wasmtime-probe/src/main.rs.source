use wasmtime::{Config, Engine, Instance, Module, Store};
fn main() -> wasmtime::Result<()> {
    let mut config = Config::new();
    config.wasm_gc(true).wasm_function_references(true)
        .wasm_tail_call(true).wasm_exceptions(true)
        .collector(wasmtime::Collector::Copying);
    let engine = Engine::new(&config)?;
    let path = "/tmp/review-native/probe.cwasm";
    #[cfg(feature = "compiler")]
    {
        let wat = r#"(module
          (type $box (struct (field i32)))
          (func (export "answer") (result i32)
            (struct.get $box 0 (struct.new $box (i32.const 42)))))"#;
        std::fs::write(path, engine.precompile_module(wat.as_bytes())?)?;
        println!("precompiled WasmGC artifact");
    }
    // Only bytes generated above by this exact pinned Wasmtime are accepted.
    let module = unsafe { Module::deserialize(&engine, std::fs::read(path)?)? };
    let mut store = Store::new(&engine, ());
    let instance = Instance::new(&mut store, &module, &[])?;
    let answer = instance.get_typed_func::<(), i32>(&mut store, "answer")?.call(&mut store, ())?;
    assert_eq!(answer, 42);
    println!("compiler_feature={} answer={answer}", cfg!(feature = "compiler"));
    // Store is transferable when not executing; it is not permanently thread-bound.
    let answer = std::thread::spawn(move || {
        instance.get_typed_func::<(), i32>(&mut store, "answer").unwrap().call(&mut store, ()).unwrap()
    }).join().unwrap();
    assert_eq!(answer, 42);
    println!("moved idle Store to another thread: answer={answer}");
    #[cfg(feature = "compiler")]
    std::fs::write("/tmp/review-native/fake.cwasm", engine.precompile_module(&std::fs::read("/tmp/review-native/fake.wasm")?)?)?;
    let actual = unsafe { Module::deserialize(&engine, std::fs::read("/tmp/review-native/fake.cwasm")?)? };
    let mut linker = wasmtime::Linker::<()>::new(&engine);
    linker.func_wrap("ilang:host/v1", "panic", |_address: i32, _length: i32| -> wasmtime::Result<()> {
        Err(wasmtime::Error::msg("i program stopped"))
    })?;
    linker.func_wrap("ilang:host/v1", "reference_id", |reference: Option<wasmtime::Rooted<wasmtime::ExternRef>>| -> i64 {
        assert!(reference.is_none(), "probe program must not use host references");
        0
    })?;
    let mut store = Store::new(&engine, ());
    let instance = linker.instantiate(&mut store, &actual)?;
    instance.get_typed_func::<(), ()>(&mut store, "ilang_start")?.call(&mut store, ())?;
    instance.get_typed_func::<(), ()>(&mut store, "review/main.main")?.call(&mut store, ())?;
    println!("actual i WasmGC module start+main passed, compiler_feature={}", cfg!(feature = "compiler"));
    Ok(())
}
