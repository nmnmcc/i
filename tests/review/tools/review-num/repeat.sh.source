#!/usr/bin/env bash
set -euo pipefail
export PYTHONDONTWRITEBYTECODE=1
py=/home/agent/Programming/i/.rd/note-std3/target/std3-prof-env/bin/python
for level in 0 2; do
 target/release/i build --project target/numeric/project --opt "$level" --out "/tmp/review-num/o${level}.wasm"
 wasm-tools print "/tmp/review-num/o${level}.wasm" > "/tmp/review-num/o${level}.wat"
 "$py" /tmp/review-num/count.py "$level"
done
for run in 1 2 3 4 5; do
 for level in 0 2; do
  "$py" /tmp/review-num/measure.py "/tmp/review-num/o${level}.wasm" "timing-o${level}-${run}.json"
 done
 NUM_PREFIX='' "$py" /tmp/review-num/measure.py /tmp/review-num/scalar.wasm "timing-scalar-${run}.json"
done
