spec/environment.check : (got: String, want: String) -> Nil
spec/environment.show : (x: A) -> String
spec/environment.elapsed : (start: Int) -> Int ! Clock
spec/environment.fixed : () -> Int
spec/environment.name : () -> String ! Name
spec/environment.both : ((Int, Int)) -> (Int, String) ! Clock | Name
spec/environment.made_here : () -> () -> String ! Name
spec/environment.call_elsewhere : (f: () -> A ? E ! N) -> A ? E ! N - Name
spec/environment.scoped : () -> (String, String)
spec/environment.shadowed : () -> String
spec/environment.from_outside : () -> String
spec/environment.count : (n: Int, acc: Int, name: Name) -> Int
spec/environment.deep : (n: Int) -> String ! Name
spec/environment.apply : (f: (A) -> B ? E ! N, n: A) -> B ? E ! N
spec/environment.stored : () -> Clock ! Clock
spec/environment.read : () -> A ! State(B & A)
spec/environment.example : () -> Nil
spec/environment.parameters : () -> Nil
spec/environment.dynamic_scoping : () -> Nil
spec/environment.blocks : () -> Nil
spec/environment.tail_calls : () -> Nil
spec/environment.generic : () -> Nil
