spec/assert.check : (got: String, want: String) -> Nil
spec/assert.show : (x: A) -> String
spec/assert.assert_true : () -> Nil ! Assert
spec/assert.catch_assert : () -> Nil
spec/assert.first : (r: Result(A, B)) -> A ! Assert
spec/assert.param : (Result(Int, A), (Int, Int)) -> Int ! Assert
spec/assert.failing_patterns : () -> Nil ! Assert
spec/assert.add : (Pair) -> Int
spec/assert.can_not_fail : () -> Nil
spec/assert.own_assert : () -> Nil
