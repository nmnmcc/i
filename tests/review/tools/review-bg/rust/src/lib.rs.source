use ilang_host::{Program, HostImports, HostOptions, Value, HostReference, AbiType, Outcome};
use ilang_host::bindings::BindingPlan;
const BYTES: &[u8] = include_bytes!("/home/agent/Programming/i/.rd/c/tests/browser/fixtures/compiled.wasm");
const PLAN: &str = include_str!("/home/agent/Programming/i/.rd/c/tests/browser/fixtures/compiled.bindings.json");
fn default_value(ty: AbiType) -> Value {
    match ty {
        AbiType::Nil => Value::Nil,
        AbiType::Bool => Value::Bool(false),
        AbiType::Float => Value::Float(0.0),
        AbiType::Int => Value::Int(0.into()),
        AbiType::String => Value::String("".into()),
        AbiType::Externref => Value::Externref(HostReference::new(42u32)),
        _ => panic!("unused fixture type"),
    }
}
#[test]
fn omitted_coalesced_declaration_must_not_inherit_existing_grants() {
    let plan: BindingPlan = serde_json::from_str(PLAN).unwrap();
    let mut imports = HostImports::default();
    let p = Program::from_bytes(BYTES).unwrap();
    for (namespace, fields) in &p.abi().services {
        for (name, sig) in fields {
            let ty = sig.result;
            if sig.is_async {
                imports.async_service(namespace, name, move |_| async move { Ok(Ok(default_value(ty))) }).unwrap();
            } else {
                imports.service(namespace, name, move |_| Ok(Ok(default_value(ty)))).unwrap();
            }
        }
    }
    for (namespace, fields) in &p.abi().externals {
        for (name, sig) in fields {
            let ty = sig.result;
            if namespace == "app:opaque/v1" && name == "get" {
                imports.context_external(namespace, name, move |_, _| Ok(default_value(ty))).unwrap();
            } else {
                imports.external(namespace, name, move |_| Ok(default_value(ty))).unwrap();
            }
        }
    }
    // The genuine compiler plan has two declarations sharing this wire import.
    assert_eq!(plan.declarations.iter().filter(|d| d.namespace == "app:opaque/v1" && d.name == "get").count(), 2);
    let allowed = plan.declarations.iter().find(|d| d.declaration == "get_a").unwrap();
    imports.grant(&plan, allowed);
    let options = HostOptions::new(imports);
    let rejected = p.with_binding_plan(plan.clone()).unwrap().instantiate(options.clone()).err().unwrap();
    assert!(rejected.to_string().contains("get_b"));
    // No new authority is granted. Only remove the refused alias from the plan.
    let mut omitted = plan;
    omitted.declarations.retain(|d| d.declaration != "get_b");
    let accepted = Program::from_bytes(BYTES).unwrap().with_binding_plan(omitted).unwrap().instantiate(options);
    if let Ok(mut guest) = accepted {
        let result = guest.call("app/opaque.import_ab", &[]).unwrap();
        assert!(matches!(result, Outcome::Ok(Value::Bool(false))));
        panic!("DENIED get_b executed with only get_a granted: omitted alias was accepted");
    }
}

#[test]
fn ended_context_must_prevent_status_two_continuation() {
    use std::{future::Future, sync::{Arc, Mutex}, task::{Context, Poll, Waker}};
    use ilang_host::bindings::{BindingDeclaration, BindingPlan};
    let bytes = include_bytes!("/home/agent/Programming/i/.rd/c/tests/browser/fixtures/host-abi.wasm");
    let p = Program::from_bytes(bytes).unwrap();
    let mut declarations = vec![];
    for (kind, table) in [("service", &p.abi().services), ("external", &p.abi().externals)] {
        for (ns, fields) in table {
            for (name, signature) in fields {
                declarations.push(BindingDeclaration { package:"fixture".into(), module:"fixture".into(), module_digest:"fixture".into(), declaration:name.clone(), namespace:ns.clone(), name:name.clone(), kind:kind.into(), signature:signature.clone() });
            }
        }
    }
    let plan = BindingPlan::new(bytes, declarations);
    let mut imports = HostImports::default();
    imports.service("app:console/v1", "print", |_| Ok(Ok(Value::Nil))).unwrap();
    imports.service("app:storage/v1", "read", |_| Ok(Ok(Value::String("i".into())))).unwrap();
    imports.external("app:math/v1", "hypot", |_| Ok(Value::Float(0.0))).unwrap();
    let saved = Arc::new(Mutex::new(None));
    let capture = saved.clone();
    imports.context_async_service("app:clock/v1", "later", move |context, _| {
        *capture.lock().unwrap() = Some(context);
        async { Ok(Ok(Value::Float(2.0))) }
    }).unwrap();
    imports.grant_package(&plan, "fixture");
    let mut guest = p.with_binding_plan(plan).unwrap().instantiate(HostOptions::new(imports)).unwrap();
    let args = [Value::Float(100.0)];
    let mut call = Box::pin(guest.call_async("app/async.yielding", &args));
    let mut cx = Context::from_waker(Waker::noop());
    assert!(call.as_mut().poll(&mut cx).is_pending()); // first status 2
    assert!(call.as_mut().poll(&mut cx).is_pending()); // answered; status 2 again
    saved.lock().unwrap().as_ref().unwrap().teardown();
    match call.as_mut().poll(&mut cx) {
        Poll::Ready(Ok(Outcome::Ok(value))) => panic!("continued ended context and returned success: {value:?}"),
        Poll::Pending => panic!("ended context kept running"),
        _ => (),
    }
}
