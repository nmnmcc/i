import test from 'node:test';
import assert from 'node:assert/strict';
import { readFile } from 'node:fs/promises';
import { ResourceHost, instantiate, GuestError } from '/home/agent/Programming/i/.rd/c/bindings/javascript/ilang.mjs';
import { customAbi, customImports, hostImports } from '/home/agent/Programming/i/.rd/c/tests/browser/fixture-abi.mjs';
const root = '/home/agent/Programming/i/.rd/c/tests/browser/fixtures/';

test('sync opaque thenable is returned unchanged and is not executed', async () => {
  const bytes = await readFile(root + 'host-abi.wasm');
  const guest = await instantiate(bytes, {imports: hostImports(GuestError)});
  let invoked = false;
  const reference = {then() { invoked = true; }};
  const result = guest.call('opaque_roundtrip', [reference]);
  assert.equal(result, reference);
  assert.equal(invoked, false);
});

test('dispose during status 2 must prevent continuation and successful return', async () => {
  const guest = await instantiate(await readFile(root + 'host-abi.wasm'), {imports: hostImports(GuestError)});
  const pending = guest.callAsync('app/async.yielding', [3]);
  guest.dispose();
  await assert.rejects(pending, /disposed|ended/);
});

test('teardown gate rejects lease commits from cancellation callbacks', async () => {
  const context = new ResourceHost().context();
  const id = context.insert('file', {}, () => {});
  const lease = context.acquire(id, 'file', 'read');
  let committed = false;
  context.ownRequest(() => {
    assert.equal(context.live, false);
    try { lease.commit(42); committed = true; } catch (e) { assert.equal(e.code, 'closed'); }
  });
  await context.teardown();
  assert.equal(committed, false);
});

test('throwing cancellation does not skip resource cleanup', async () => {
  const context = new ResourceHost().context();
  let cleaned = false;
  const id = context.insert('file', {}, () => { cleaned = true; });
  context.ownRequest(() => { throw new Error('cancel failed'); });
  try { await context.teardown(); } catch {}
  assert.equal(cleaned, true);
  assert.throws(() => context.acquire(id, 'file', 'read'), /closed/);
});

test('baseline control: same opaque thenable returns unchanged', async () => {
  const baseline = await import('./baseline-ilang.mjs');
  const guest = await baseline.instantiate(await readFile(root + 'host-abi.wasm'), {imports: hostImports(baseline.GuestError)});
  const reference = {then() { throw new Error('must not execute'); }};
  assert.equal(guest.call('opaque_roundtrip', [reference]), reference);
});

test('JS authorization control: editing the source plan cannot remove a denied coalesced declaration', async () => {
  const {authorizeBindings} = await import('/home/agent/Programming/i/.rd/c/bindings/javascript/ilang.mjs');
  const {compiledImports} = await import('/home/agent/Programming/i/.rd/c/tests/browser/fixture-abi.mjs');
  const bytes = await readFile(root + 'compiled.wasm');
  const plan = JSON.parse(await readFile(root + 'compiled.bindings.json', 'utf8'));
  const bindings = await authorizeBindings(bytes, plan, d => d.declaration !== 'get_b');
  plan.declarations = plan.declarations.filter(d => d.declaration !== 'get_b');
  const imports = compiledImports(GuestError);
  delete imports['app:opaque/v1'].get;
  await assert.rejects(instantiate(bindings.module, {
    imports, bindings,
    contextImports: {'app:opaque/v1': {get: () => null}},
  }), /ungranted host import.*get_b/);
});
