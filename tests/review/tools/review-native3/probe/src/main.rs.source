fn main() {
 for dir in std::env::args().skip(1) {
  println!("PROJECT {dir}");
  let (g, mut ds) = ilang_package::load(std::path::Path::new(&dir));
  let c = ilang_check::check(&g);
  ds.extend(c.diags);
  for d in g.sources.render_all(&ds) { println!("{d}"); }
  if ds.iter().any(|d| d.is_error()) { println!("REJECTED"); continue; }
  println!("ACCEPTED");
  let bytes = ilang_wasm::compile(&g, c.program.as_ref().unwrap(), c.types.as_ref().unwrap(), ilang_wasm::Options { target: ilang_wasm::Target::Wasi, ..Default::default() }).unwrap();
  std::fs::write(format!("{dir}/probe.wasm"), bytes).unwrap();
 }
}
