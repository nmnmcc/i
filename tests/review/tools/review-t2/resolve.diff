+                let def = self.p.ty(*id);
+                let TypeBody::Alias(body) = &def.body else {
+                    unreachable!()
+                };
+                if value_dependent(&self.p, body) {
+                    return false;
+                }
+                let map = def
+                    .params
+                    .iter()
+                    .map(|(_, v)| *v)
+                    .zip(parts.iter().cloned())
