fn main(){let e=wasmtime::Engine::default();for p in std::env::args().skip(1){let b=wat::parse_file(&p).unwrap();ilang_wasm::validate(&b).unwrap();let m=wasmtime::Module::new(&e,b).unwrap();let mut s=wasmtime::Store::new(&e,());let i=wasmtime::Instance::new(&mut s,&m,&[]).unwrap();let f=i.get_typed_func::<(),i32>(&mut s,"answer").unwrap();println!("{p}: {}",f.call(&mut s,()).unwrap());}}
