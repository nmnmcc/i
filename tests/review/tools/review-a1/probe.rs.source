use std::{env,fs,path::Path};
fn main(){
 let a:Vec<String>=env::args().collect(); let path=Path::new(&a[1]); let mode=&a[2];
 let src=fs::read_to_string(path.join("src/main.i")).unwrap();
 let (ast,pd)=if mode=="old" {ilang_syntax::parse_module_old(&src)} else {ilang_syntax::parse_module(&src)};
 let print=ilang_syntax::print::print_module(&ast);
 let (again,ad)=if mode=="old" {ilang_syntax::parse_module_old(&print)} else {ilang_syntax::parse_module(&print)};
 let shape=ilang_syntax::shape::shape(&ast);
 let roundtrip=pd.is_empty()&&ad.is_empty()&&shape==ilang_syntax::shape::shape(&again);
 let (graph, mut errors)=ilang_package::load(path);
 let mut parsed=Vec::new();
 for (package,p) in graph.packages.iter().enumerate(){for m in &p.modules {
  let text=&graph.sources.get(m.source).text;
  let (ast,ds)=if mode=="old"{ilang_syntax::parse_module_old(text)}else{ilang_syntax::parse_module(text)};
  errors.extend(ds.into_iter().map(|d|ilang_package::Diagnostic::error(d.code.as_str(),Some(m.source),d.span,d.message)));
  parsed.push(ilang_check::Parsed{package,path:m.path.clone(),source:m.source,kind:m.kind,ast});
 }}
 let mut wat=false;
 if !errors.iter().any(|d|d.is_error()) {
 let (mut p,ds)=ilang_check::resolve::resolve(&graph,&parsed); errors.extend(ds);
 ilang_check::order::order(&mut p,&mut errors);
 if !errors.iter().any(|d|d.is_error()) {
 let (t,ds)=ilang_check::types::check(&p,&graph.sources); errors.extend(ds);
 if !errors.iter().any(|d|d.is_error()) {match ilang_wasm::compile_wat(&graph,&p,&t,ilang_wasm::Options{tests:false,target:ilang_wasm::Target::Ilang}) {Ok(w)=>{fs::write(&a[3],w).unwrap();wat=true},Err(e)=>eprintln!("wat error {e}")}}
 }}
 println!("{}",serde_json::json!({"parse":pd.iter().map(|d|format!("{}: {}",d.code.as_str(),d.message)).collect::<Vec<_>>(),"check":errors.iter().map(|d|format!("{}: {}",d.code,d.message)).collect::<Vec<_>>(),"roundtrip":roundtrip,"wat":wat}));
}
