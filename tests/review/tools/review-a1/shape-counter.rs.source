fn main(){let old="f = () { \"@1..2\" }\n";let out="f = () { \"@3..4\" }\n";let(m,d)=ilang_syntax::parse_module_old(old);assert!(d.is_empty());let p=ilang_syntax::migrate::plan(&m,&ilang_syntax::migrate::Env::new(&m));println!("{:?}",ilang_syntax::migrate::check_written(&m,&p,out));println!("canon equal = {}",ilang_syntax::shape::canon(&m)==ilang_syntax::shape::canon(&ilang_syntax::parse_module(out).0));}
