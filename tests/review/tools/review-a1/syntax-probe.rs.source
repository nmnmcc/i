use std::io::{self,BufRead};
fn main(){for line in io::stdin().lock().lines(){let src=line.unwrap();let v:serde_json::Value=serde_json::from_str(&src).unwrap();let src=v["source"].as_str().unwrap();let old=v["old"].as_bool().unwrap_or(false);let (m,d)=if old{ilang_syntax::parse_module_old(src)}else{ilang_syntax::parse_module(src)};let f=if old{ilang_syntax::format::format_from_old(src)}else{ilang_syntax::format::format(src)};let val=match f{Ok(out)=>{let(_,ds)=ilang_syntax::parse_module(&out);let twice=ilang_syntax::format::format(&out);serde_json::json!({"out":out,"parse_out":format!("{ds:?}"),"idem":twice.as_ref().is_ok_and(|s|s==&out),"twice":format!("{twice:?}")})},Err(ds)=>serde_json::json!({"error":format!("{ds:?}")})};let (_,b)=ilang_syntax::parse_module(src);println!("{}",serde_json::json!({"parse":format!("{d:?}"),"both":format!("{b:?}"),"old_shape":ilang_syntax::shape::shape(&m),"format":val}));}}
