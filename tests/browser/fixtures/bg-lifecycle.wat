;; BG host gates. Linear-memory counters can be inspected without entering Wasm:
;; 0 continuation, 4 result, 8 allocation, 12 body, 24 free.
;; Flags 16/20 end the context from allocation/free respectively.
(module
  (import "bg:control/v1" "capture" (func $capture))
  (import "bg:control/v1" "end" (func $end))
  (import "bg:work/v1" "wait" (func $wait (param i32)))
  (memory (export "memory") 1)
  (global $next (mut i32) (i32.const 128))
  (func $count (param $at i32)
    (i32.store (local.get $at) (i32.add (i32.load (local.get $at)) (i32.const 1))))
  (func (export "ilang_start"))
  (func (export "ilang_alloc") (param $size i32) (result i32) (local $ptr i32)
    (call $count (i32.const 8))
    (if (i32.load (i32.const 16)) (then (call $end)))
    (local.set $ptr (global.get $next))
    (global.set $next (i32.add (global.get $next) (local.get $size)))
    (local.get $ptr))
  (func (export "ilang_free") (param i32 i32)
    (call $count (i32.const 24))
    (if (i32.load (i32.const 20)) (then (call $end))))
  (func (export "runnable") (result i32) (call $capture) (i32.const 2))
  (func (export "entry") (result i32) (call $capture) (i32.const 2))
  (func (export "immediate") (result i32) (call $capture) (i32.const 0))
  (func (export "leftover") (result i32)
    (call $capture) (call $wait (i32.const 0)) (i32.const 0))
  (func (export "ilang_continue") (result i32)
    (call $count (i32.const 0)) (i32.const 0))
  (func (export "ilang_resume:bg:work/v1:wait") (param i32) (result i32) (i32.const 0))
  (func $result (call $count (i32.const 4)))
  (export "ilang_result:runnable" (func $result))
  (export "ilang_result:entry" (func $result))
  (export "ilang_result:immediate" (func $result))
  (export "ilang_result:leftover" (func $result))
  (func (export "sync") (call $capture) (call $count (i32.const 12)))
  (func (export "bits") (param $ptr i32) (param $len i32) (result i32 i32)
    (call $count (i32.const 12)) (local.get $ptr) (local.get $len))
  (func (export "buffers") (param i32 i32 i32 i32) (call $count (i32.const 12)))
)
