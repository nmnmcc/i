(, (= syntax (/ i syntax)) (= fail (/ i fail)))
(, m)
(@ macro (: m (-> [A] (, A) A)))
(@ macro
  (= m
    (-> (, value) _
      {(= s ((. syntax signature)))
       (|> ((. syntax subtype) s s)
           (| (-> (, (. syntax Yes)) _ value)
             (-> (, _) _
               ((. fail raise)
                ((. syntax SyntaxError)
                 (= message "signature must be reflexive")
                 (= at value))))))})))
