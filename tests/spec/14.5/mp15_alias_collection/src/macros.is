(, (= syntax (/ i syntax)))
(, entries entry register)
(= entries Nil)
(@ macro (= entry (-> (, at) (<- _ (, (: items (. syntax Items))))
  {(= target `generated)
   ((. items add) `entries target [] at)
   `(= ~target (-> (,) _ Nil))})))
(@ macro (= register (-> (, target) (<- _ (, (: items (. syntax Items))))
  {((. items add) `entries target [] target) `{}})))
