{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "i",
  "scopeName": "source.i",
  "fileTypes": ["i"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#attribute" },
    { "include": "#import" },
    { "include": "#type-definition" },
    { "include": "#const-definition" },
    { "include": "#function-definition" },
    { "include": "#expression" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.module.i",
          "match": "////.*$"
        },
        {
          "name": "comment.line.documentation.i",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.i",
          "match": "//.*$"
        }
      ]
    },

    "attribute": {
      "comment": "@external(wasm, \"module\", \"fn\"), @target(wasm), @deprecated(\"...\"), @internal",
      "begin": "(@)([a-z][A-Za-z0-9_]*)\\s*(\\()",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.annotation.i" },
        "2": { "name": "entity.name.function.decorator.i" },
        "3": { "name": "punctuation.section.arguments.begin.i" }
      },
      "end": "\\)",
      "endCaptures": {
        "0": { "name": "punctuation.section.arguments.end.i" }
      },
      "name": "meta.annotation.i",
      "patterns": [
        { "include": "#comments" },
        { "include": "#string" },
        { "include": "#number" },
        {
          "name": "constant.language.target.i",
          "match": "\\b(wasm|javascript|erlang)\\b"
        },
        {
          "name": "variable.parameter.attribute.i",
          "match": "\\b[a-z][A-Za-z0-9_]*\\b"
        },
        { "name": "punctuation.separator.comma.i", "match": "," }
      ]
    },
    "attribute-bare": {
      "match": "(@)([a-z][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "punctuation.definition.annotation.i" },
        "2": { "name": "entity.name.function.decorator.i" }
      },
      "name": "meta.annotation.i"
    },

    "import": {
      "comment": "import a/b/c.{type T, Ctor, fun} as alias",
      "begin": "\\b(import)\\s+([a-z][A-Za-z0-9_]*(?:/[a-z][A-Za-z0-9_]*)*)",
      "beginCaptures": {
        "1": { "name": "keyword.control.import.i" },
        "2": { "name": "entity.name.namespace.i" }
      },
      "end": "(?=$|//)",
      "name": "meta.import.i",
      "patterns": [
        {
          "begin": "\\.\\s*(\\{)",
          "beginCaptures": {
            "1": { "name": "punctuation.section.braces.begin.i" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.section.braces.end.i" }
          },
          "patterns": [
            { "include": "#comments" },
            {
              "match": "\\b(type)\\s+([A-Z][A-Za-z0-9_]*)",
              "captures": {
                "1": { "name": "storage.type.i" },
                "2": { "name": "entity.name.type.i" }
              }
            },
            {
              "match": "\\b(as)\\b",
              "name": "keyword.control.as.i"
            },
            { "include": "#constructor" },
            { "name": "entity.name.function.i", "match": "\\b[a-z][A-Za-z0-9_]*\\b" },
            { "name": "punctuation.separator.comma.i", "match": "," }
          ]
        },
        {
          "match": "\\b(as)\\s+([a-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.as.i" },
            "2": { "name": "entity.name.namespace.alias.i" }
          }
        },
        { "match": "\\b(as)\\b", "name": "keyword.control.as.i" }
      ]
    },

    "type-definition": {
      "comment": "pub opaque type Name(a, b) / type Alias = ...",
      "match": "\\b(?:(pub)\\s+)?(?:(opaque)\\s+)?(type)\\s+([A-Z][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.modifier.pub.i" },
        "2": { "name": "storage.modifier.opaque.i" },
        "3": { "name": "storage.type.type.i" },
        "4": { "name": "entity.name.type.i" }
      }
    },

    "const-definition": {
      "match": "\\b(?:(pub)\\s+)?(const)\\s+([a-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.modifier.pub.i" },
        "2": { "name": "storage.type.const.i" },
        "3": { "name": "variable.other.constant.i" }
      }
    },

    "function-definition": {
      "match": "\\b(?:(pub)\\s+)?(fn)\\s+([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "storage.modifier.pub.i" },
        "2": { "name": "storage.type.function.i" },
        "3": { "name": "entity.name.function.i" }
      }
    },

    "expression": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#attribute-bare" },
        { "include": "#string" },
        { "include": "#number" },
        { "include": "#bit-array" },
        { "include": "#keywords" },
        { "include": "#function-definition" },
        { "include": "#type-definition" },
        { "include": "#const-definition" },
        { "include": "#tuple-start" },
        { "include": "#label" },
        { "include": "#module-access" },
        { "include": "#function-call" },
        { "include": "#constructor" },
        { "include": "#discard" },
        { "include": "#field-access" },
        { "include": "#variable" },
        { "include": "#operators" },
        { "include": "#punctuation" }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "comment": "let assert",
          "match": "\\b(let)\\s+(assert)\\b",
          "captures": {
            "1": { "name": "storage.type.let.i" },
            "2": { "name": "keyword.control.assert.i" }
          }
        },
        {
          "name": "keyword.control.conditional.i",
          "match": "\\b(case|if|else)\\b"
        },
        {
          "name": "keyword.control.i",
          "match": "\\b(use|assert|echo|as)\\b"
        },
        {
          "name": "keyword.other.todo.i",
          "match": "\\btodo\\b"
        },
        {
          "name": "keyword.control.panic.i",
          "match": "\\bpanic\\b"
        },
        {
          "name": "keyword.control.import.i",
          "match": "\\bimport\\b"
        },
        {
          "name": "storage.type.let.i",
          "match": "\\blet\\b"
        },
        {
          "name": "storage.type.function.i",
          "match": "\\bfn\\b"
        },
        {
          "name": "storage.type.i",
          "match": "\\b(type|const)\\b"
        },
        {
          "name": "storage.modifier.i",
          "match": "\\b(pub|opaque)\\b"
        },
        {
          "comment": "Reserved for future use by the lexer",
          "name": "keyword.other.reserved.i",
          "match": "\\b(auto|delegate|derive|implement|macro|test)\\b"
        }
      ]
    },

    "string": {
      "name": "string.quoted.double.i",
      "begin": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.i" }
      },
      "end": "\"",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.i" }
      },
      "patterns": [
        {
          "name": "constant.character.escape.unicode.i",
          "match": "\\\\u\\{[0-9A-Fa-f]{1,6}\\}"
        },
        {
          "name": "constant.character.escape.i",
          "match": "\\\\[fnrt\"\\\\]"
        },
        {
          "name": "invalid.illegal.escape.i",
          "match": "\\\\."
        }
      ]
    },

    "number": {
      "patterns": [
        {
          "name": "constant.numeric.hex.i",
          "match": "(?<![A-Za-z0-9_])-?0[xX][0-9A-Fa-f](?:_?[0-9A-Fa-f])*\\b"
        },
        {
          "name": "constant.numeric.octal.i",
          "match": "(?<![A-Za-z0-9_])-?0[oO][0-7](?:_?[0-7])*\\b"
        },
        {
          "name": "constant.numeric.binary.i",
          "match": "(?<![A-Za-z0-9_])-?0[bB][01](?:_?[01])*\\b"
        },
        {
          "name": "constant.numeric.float.i",
          "match": "(?<![A-Za-z0-9_.])-?[0-9](?:_?[0-9])*\\.(?:[0-9](?:_?[0-9])*)?(?:[eE]-?[0-9](?:_?[0-9])*)?"
        },
        {
          "name": "constant.numeric.integer.i",
          "match": "(?<![A-Za-z0-9_.])-?[0-9](?:_?[0-9])*\\b"
        }
      ]
    },

    "bit-array": {
      "comment": "<<a:size(8), b:utf8>>",
      "begin": "<<",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.bit-array.begin.i" }
      },
      "end": ">>",
      "endCaptures": {
        "0": { "name": "punctuation.definition.bit-array.end.i" }
      },
      "name": "meta.bit-array.i",
      "patterns": [
        {
          "comment": "Segment options after a colon or dash, e.g. :size(8), -little, :unit(8)",
          "match": "(?<=[:\\-])\\s*(bits|bit_array|bytes|int|float|utf8|utf16|utf32|utf8_codepoint|utf16_codepoint|utf32_codepoint|signed|unsigned|big|little|native|size|unit)\\b",
          "captures": {
            "1": { "name": "support.type.bit-array-option.i" }
          }
        },
        {
          "comment": "Segment value followed by its options: `name:utf8`",
          "match": "\\b([a-z][A-Za-z0-9_]*)\\s*(:)",
          "captures": {
            "1": { "name": "variable.other.i" },
            "2": { "name": "punctuation.separator.segment-options.i" }
          }
        },
        {
          "match": ":",
          "name": "punctuation.separator.segment-options.i"
        },
        {
          "comment": "Option separator: `little-unit(8)`",
          "match": "(?<=[a-z0-9)])-(?=[a-z])",
          "name": "punctuation.separator.segment-options.i"
        },
        { "include": "#expression" }
      ]
    },

    "tuple-start": {
      "match": "#(?=\\()",
      "name": "punctuation.definition.tuple.i"
    },

    "label": {
      "patterns": [
        {
          "comment": "Labelled parameter in a function head: `of exponent: Float`",
          "match": "\\b(?!(?:let|assert|use|case|if|else|fn|pub|type|const|import|as|echo|panic|todo|opaque)\\b)([a-z][A-Za-z0-9_]*)\\s+([a-z_][A-Za-z0-9_]*)\\s*(:)",
          "captures": {
            "1": { "name": "variable.parameter.label.i" },
            "2": { "name": "variable.parameter.i" },
            "3": { "name": "punctuation.separator.colon.i" }
          }
        },
        {
          "comment": "Labelled argument, record field or annotated name: `label: value`",
          "match": "\\b([a-z][A-Za-z0-9_]*)\\s*(:)",
          "captures": {
            "1": { "name": "variable.parameter.label.i" },
            "2": { "name": "punctuation.separator.colon.i" }
          }
        }
      ]
    },

    "module-access": {
      "comment": "module.function(...), module.Constructor, module.value",
      "patterns": [
        {
          "match": "\\b([a-z][A-Za-z0-9_]*)(\\.)([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.namespace.i" },
            "2": { "name": "punctuation.accessor.i" },
            "3": { "name": "entity.name.function.call.i" }
          }
        },
        {
          "match": "\\b([a-z][A-Za-z0-9_]*)(\\.)([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.namespace.i" },
            "2": { "name": "punctuation.accessor.i" },
            "3": { "name": "entity.name.type.i" }
          }
        }
      ]
    },

    "function-call": {
      "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.call.i" }
      }
    },

    "constructor": {
      "patterns": [
        {
          "name": "constant.language.boolean.i",
          "match": "\\b(True|False)\\b"
        },
        {
          "name": "constant.language.nil.i",
          "match": "\\bNil\\b"
        },
        {
          "name": "entity.name.type.i",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },

    "discard": {
      "name": "comment.unused.discard.i",
      "match": "\\b_[A-Za-z0-9_]*\\b"
    },

    "field-access": {
      "match": "(\\.)([a-z][A-Za-z0-9_]*|[0-9]+)\\b",
      "captures": {
        "1": { "name": "punctuation.accessor.i" },
        "2": { "name": "variable.other.property.i" }
      }
    },

    "variable": {
      "name": "variable.other.i",
      "match": "\\b[a-z][A-Za-z0-9_]*\\b"
    },

    "operators": {
      "patterns": [
        { "name": "keyword.operator.pipe.i", "match": "\\|>" },
        { "name": "keyword.operator.arrow.i", "match": "->|<-" },
        { "name": "keyword.operator.spread.i", "match": "\\.\\." },
        { "name": "keyword.operator.string.concat.i", "match": "<>" },
        { "name": "keyword.operator.logical.i", "match": "&&|\\|\\|" },
        { "name": "keyword.operator.comparison.i", "match": "==|!=" },
        {
          "name": "keyword.operator.comparison.float.i",
          "match": "<=\\.|>=\\.|<\\.|>\\."
        },
        { "name": "keyword.operator.comparison.i", "match": "<=|>=|<|>" },
        {
          "name": "keyword.operator.arithmetic.float.i",
          "match": "\\+\\.|-\\.|\\*\\.|/\\."
        },
        { "name": "keyword.operator.arithmetic.i", "match": "\\+|-|\\*|/|%" },
        { "name": "keyword.operator.logical.not.i", "match": "!" },
        { "name": "keyword.operator.assignment.i", "match": "=" },
        { "name": "keyword.operator.alternative.i", "match": "\\|" }
      ]
    },

    "punctuation": {
      "patterns": [
        { "name": "punctuation.separator.comma.i", "match": "," },
        { "name": "punctuation.separator.colon.i", "match": ":" },
        { "name": "punctuation.accessor.i", "match": "\\." },
        { "name": "punctuation.section.braces.i", "match": "[{}]" },
        { "name": "punctuation.section.brackets.i", "match": "[\\[\\]]" },
        { "name": "punctuation.section.parens.i", "match": "[()]" }
      ]
    }
  }
}
