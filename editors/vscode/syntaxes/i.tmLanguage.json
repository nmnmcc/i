{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "i",
  "scopeName": "source.i",
  "fileTypes": ["i"],
  "comment": "The syntax of docs/spec.md, §1 to §8.",
  "patterns": [{ "include": "#code" }],
  "repository": {
    "code": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#attributes" },
        { "include": "#import" },
        { "include": "#keywords" },
        { "include": "#bit-array" },
        { "include": "#numbers" },
        { "include": "#definition" },
        { "include": "#label" },
        { "include": "#call" },
        { "include": "#field" },
        { "include": "#constants" },
        { "include": "#builtin-types" },
        { "include": "#up-name" },
        { "include": "#discard" },
        { "include": "#name" },
        { "include": "#operators" },
        { "include": "#punctuation" }
      ]
    },

    "comments": {
      "comment": "§1.2: `////` documents the module, `///` the item after it.",
      "patterns": [
        {
          "name": "comment.line.documentation.module.i",
          "match": "(////).*$",
          "captures": { "1": { "name": "punctuation.definition.comment.i" } }
        },
        {
          "name": "comment.line.documentation.i",
          "match": "(///).*$",
          "captures": { "1": { "name": "punctuation.definition.comment.i" } }
        },
        {
          "name": "comment.line.double-slash.i",
          "match": "(//).*$",
          "captures": { "1": { "name": "punctuation.definition.comment.i" } }
        }
      ]
    },

    "strings": {
      "comment": "§1.6: a string may go over more than one line.",
      "name": "string.quoted.double.i",
      "begin": "\"",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.i" } },
      "end": "\"",
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.i" } },
      "patterns": [
        {
          "name": "constant.character.escape.unicode.i",
          "match": "\\\\u\\{[0-9a-fA-F]{1,6}\\}"
        },
        {
          "name": "constant.character.escape.i",
          "match": "\\\\[nrtf\"\\\\]"
        },
        {
          "name": "invalid.illegal.escape.i",
          "match": "\\\\(?:u\\{[^}\"]*\\}?|.)?"
        }
      ]
    },

    "attributes": {
      "comment": "§2.2: @external, @host, @main, @test, @deprecated. Others are compile errors.",
      "patterns": [
        {
          "match": "(@)(external|host|main|test|deprecated)\\b",
          "captures": {
            "0": { "name": "storage.type.annotation.i" },
            "1": { "name": "punctuation.definition.annotation.i" }
          }
        },
        {
          "match": "(@)([a-z_][A-Za-z0-9_]*)?",
          "captures": {
            "0": { "name": "invalid.illegal.annotation.i" },
            "1": { "name": "punctuation.definition.annotation.i" }
          }
        }
      ]
    },

    "import": {
      "comment": "§2.3: `import (i/fail  decode = json/decode  opt = (Option, Some) = std/option)`.",
      "begin": "\\b(import)\\s*(\\()",
      "beginCaptures": {
        "1": { "name": "keyword.control.import.i" },
        "2": { "name": "punctuation.brackets.round.i" }
      },
      "end": "\\)",
      "endCaptures": { "0": { "name": "punctuation.brackets.round.i" } },
      "name": "meta.import.i",
      "patterns": [
        { "include": "#comments" },
        {
          "name": "entity.name.namespace.i",
          "match": "\\b_?[a-z][a-z0-9_]*(?:/_?[a-z][a-z0-9_]*)+"
        },
        {
          "comment": "The names that an import puts into the module.",
          "begin": "\\(",
          "beginCaptures": { "0": { "name": "punctuation.brackets.round.i" } },
          "end": "\\)",
          "endCaptures": { "0": { "name": "punctuation.brackets.round.i" } },
          "patterns": [
            { "include": "#comments" },
            { "include": "#builtin-types" },
            { "include": "#up-name" },
            { "include": "#name" },
            { "include": "#punctuation" }
          ]
        },
        {
          "name": "entity.name.namespace.alias.i",
          "match": "\\b_?[a-z][a-z0-9_]*\\b"
        },
        { "name": "keyword.operator.assignment.i", "match": "=" },
        { "include": "#punctuation" }
      ]
    },

    "keywords": {
      "comment": "§1.4.",
      "patterns": [
        {
          "name": "keyword.control.import.i",
          "match": "\\b(?:import|export)\\b"
        },
        {
          "name": "keyword.control.conditional.i",
          "match": "\\b(?:case|if)\\b"
        }
      ]
    },

    "numbers": {
      "comment": "§1.6. After `.`, digits are a decimal, never a float: `t.0.1`.",
      "patterns": [
        {
          "name": "constant.numeric.integer.hexadecimal.i",
          "match": "\\b0x[0-9a-fA-F][0-9a-fA-F_]*\\b"
        },
        {
          "name": "constant.numeric.integer.octal.i",
          "match": "\\b0o[0-7][0-7_]*\\b"
        },
        {
          "name": "constant.numeric.integer.binary.i",
          "match": "\\b0b[01][01_]*\\b"
        },
        {
          "name": "constant.numeric.float.i",
          "match": "(?<![\\w.])[0-9][0-9_]*\\.(?!\\.)(?:[0-9][0-9_]*)?(?:e-?[0-9][0-9_]*)?"
        },
        {
          "name": "constant.numeric.integer.decimal.i",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },

    "bit-array": {
      "comment": "§8: `<<a, b: u16be, s: utf8>>`. The formats are fixed words.",
      "begin": "<<",
      "beginCaptures": { "0": { "name": "punctuation.definition.bit-array.begin.i" } },
      "end": ">>",
      "endCaptures": { "0": { "name": "punctuation.definition.bit-array.end.i" } },
      "patterns": [
        {
          "match": "(?<=:)\\s*([ui][0-9]+(?:be|le)?|[ui](?=\\s*\\()|f(?:16|32|64)(?:be|le)|bits|bytes|utf8|utf16(?:be|le)|utf32(?:be|le)|utf8_codepoint|utf16(?:be|le)_codepoint|utf32(?:be|le)_codepoint)\\b",
          "captures": {
            "1": { "name": "storage.type.format.i" }
          }
        },
        { "include": "#code" }
      ]
    },

    "definition": {
      "comment": "A binding whose value is a function: `name = (a, b) {` or `name = (a) -> T {`.",
      "match": "^\\s*(_?[a-z][a-z0-9_]*)\\s*(=)(?!=)(?=\\s*\\([^()]*(?:\\([^()]*\\)[^()]*)*\\)\\s*(?:->|\\{))",
      "captures": {
        "1": { "name": "entity.name.function.definition.i" },
        "2": { "name": "keyword.operator.assignment.i" }
      }
    },

    "label": {
      "comment": "A label or a type annotation: `name: T`, and labelled arguments `f(in: s)`.",
      "match": "\\b(_?[a-z][a-z0-9_]*)\\s*(:)(?!:)",
      "captures": {
        "1": { "name": "variable.parameter.i" },
        "2": { "name": "punctuation.separator.annotation.i" }
      }
    },

    "call": {
      "comment": "§6.6: `f(…)`, `m.f(…)`.",
      "match": "\\b(_?[a-z][a-z0-9_]*)(?=\\()",
      "captures": { "1": { "name": "entity.name.function.call.i" } }
    },

    "field": {
      "comment": "§6.7: `v.f` and `m.x`; `t.0` is a number.",
      "match": "(?<=[\\w)\\]}])(\\.)(_?[a-z][a-z0-9_]*)\\b(?!\\s*\\()",
      "captures": {
        "1": { "name": "punctuation.accessor.i" },
        "2": { "name": "variable.other.property.i" }
      }
    },

    "constants": {
      "name": "constant.language.i",
      "match": "\\b(?:True|False|Nil)\\b"
    },

    "builtin-types": {
      "comment": "§4.2, §9.4, §9.6, §12.",
      "name": "support.type.builtin.i",
      "match": "\\b(?:Int|Float|String|List|BitArray|UtfCodepoint|Never|Bool|Result|Boundary|Continuation|Assert|AssertionFailure)\\b"
    },

    "up-name": {
      "comment": "§1.3: an UpName is a type or a constructor.",
      "patterns": [
        {
          "name": "entity.name.type.i",
          "match": "\\b[A-Z][A-Za-z0-9]*\\b"
        }
      ]
    },

    "discard": {
      "comment": "§1.3: `_` and `__name` bind nothing.",
      "name": "variable.language.discard.i",
      "match": "\\b(?:_|__[a-z0-9_]*)\\b"
    },

    "name": {
      "name": "variable.other.i",
      "match": "\\b_?[a-z][a-z0-9_]*\\b"
    },

    "operators": {
      "comment": "§1.5, §6.9. Longer tokens first.",
      "patterns": [
        {
          "name": "keyword.operator.comparison.float.i",
          "match": "<=\\.|>=\\.|<\\.|>\\."
        },
        {
          "name": "keyword.operator.arithmetic.float.i",
          "match": "\\+\\.|-\\.|\\*\\.|/\\."
        },
        { "name": "keyword.operator.pipe.i", "match": "\\|>" },
        { "name": "keyword.operator.arrow.i", "match": "->" },
        { "name": "keyword.operator.spread.i", "match": "\\.\\." },
        { "name": "keyword.operator.logical.i", "match": "&&|\\|\\|" },
        { "name": "keyword.operator.concat.i", "match": "<>" },
        { "name": "keyword.operator.comparison.i", "match": "==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.arithmetic.i", "match": "\\+|-|\\*|/|%" },
        { "name": "keyword.operator.error.i", "match": "\\?" },
        { "name": "keyword.operator.environment.i", "match": "!" },
        { "name": "keyword.operator.type.intersection.i", "match": "&" },
        { "name": "keyword.operator.choice.i", "match": "\\|" },
        { "name": "keyword.operator.assignment.i", "match": "=" },
        { "name": "punctuation.separator.annotation.i", "match": ":" }
      ]
    },

    "punctuation": {
      "patterns": [
        { "name": "punctuation.separator.comma.i", "match": "," },
        { "name": "punctuation.accessor.i", "match": "\\." },
        { "name": "punctuation.brackets.round.i", "match": "[()]" },
        { "name": "punctuation.brackets.square.i", "match": "[\\[\\]]" },
        { "name": "punctuation.brackets.curly.i", "match": "[{}]" }
      ]
    }
  }
}
