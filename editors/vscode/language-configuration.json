{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["<<", ">>"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "<<", "close": ">>", "notIn": ["string", "comment"] },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "folding": {
    "offSide": false,
    "markers": {
      "start": "^\\s*//\\s*#?region\\b",
      "end": "^\\s*//\\s*#?endregion\\b"
    }
  },
  "wordPattern": "_?[A-Za-z][A-Za-z0-9_]*|_|-?\\d[\\d_]*(?:\\.[\\d_]*(?:[eE]-?\\d[\\d_]*)?)?",
  "indentationRules": {
    "increaseIndentPattern": "^.*(\\{[^}\"']*|\\([^)\"']*|\\[[^\\]\"']*|->)\\s*(//.*)?$",
    "decreaseIndentPattern": "^\\s*[}\\])].*$"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*////.*$",
      "action": { "indent": "none", "appendText": "//// " }
    },
    {
      "beforeText": "^\\s*///(?!/).*$",
      "action": { "indent": "none", "appendText": "/// " }
    }
  ]
}
