a = 1 + 2 * 3

b = 1 * 2 + 3

c = a || b && c == d

d = a < b == c

e = "a" <> "b" |> f

f = x + 1 |> g

g = -a.b(c)

h = -x * y

i = a - b - c

j = a - { b - c }

k = { a + b } * c

l = a == b != c

m = 1.0 +. 2.0 *. 3.0 <. 4.0

n = x |> f(y) |> g

o = a % b / c

p = -.x -. -.y

q = a <= b || c >=. d && e >. f

r = a - -1
--- explicit ---
a = 1 + { 2 * 3 }
b = { 1 * 2 } + 3
c = a || { b && { c == d } }
d = { a < b } == c
e = { "a" <> "b" } |> f
f = { x + 1 } |> g
h = { -x } * y
i = { a - b } - c
l = { a == b } != c
m = { 1.0 +. { 2.0 *. 3.0 } } <. 4.0
n = { x |> f(y) } |> g
o = { a % b } / c
p = { -.x } -. { -.y }
q = { a <= b } || { { c >=. d } && { e >. f } }
r = a - { -1 }
