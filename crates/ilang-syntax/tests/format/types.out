Alias(A) = (A) -> { (Int) -> Int } ! Assert | Nil

Wide(A, B) = (
	first_parameter_type:  List(A)
	second_parameter_type: Dict(A, B)
	third:                 Int
) -> Bool

Handler = { (Int) -> Int } | (String) -> String

@external("env", "log")
log: (String) -> Nil

apply = (f: (Int) -> Int ^ E ! N, x: Int | Float - Nil & Any) -> Int ^ E ! N {
	f(x)
}
