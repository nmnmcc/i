pair : (t: (A, B)) -> A
pair_written : (t: (Int, String)) -> String
first : (r: Result(A, B)) -> A ! Assert
annotated : () -> Int
literal : (n: A & Int) -> A ! Assert
single : (u: User) -> String
only_ok : (r: Result(Int, Never)) -> Int
nested : (p: (Result(Int, Never), Bool)) -> Int
from_value : () -> 1
list : (xs: List(A)) -> A ! Assert
list_rest : (xs: List(A)) -> List(A)
prefix : (s: String) -> String
prefix_some : (s: String) -> String ! Assert
named : (r: Result(A, B)) -> Result(A, B) ! Assert
typed_part : (p: (Int, A)) -> A
bits : (b: BitArray) -> Int ! Assert
float : (f: A & Float) -> A ! Assert
type_var : (x: A) -> A
param_tuple : ((A, B)) -> A
param_user : (User) -> String
param_ctor : (Result(A, B)) -> A ! Assert
param_literal : (Int) -> 1 ! Assert
param_list : (List(A)) -> 1 ! Assert
