i/prelude.panic : (message: String) -> Never
i/prelude.assert : (c: Bool) -> Nil ! Assert
i/fail.raise : (error: A) -> Never ? A
i/fail.catch : (body: () -> A ? E ! N) -> Result(A, E) ! N
i/fail.from_result : (result: Result(A, B)) -> A ? B
i/fail.map_error : (body: () -> A ? E ! N, with: (E) -> B ! N) -> A ? B ! N
i/control.boundary : (body: (b: Boundary(A, B, C)) -> A ? B ! C) -> A ? B ! C
i/control.suspend : (b: Boundary(A, B, C), f: (k: Continuation(D, A, B, C)) -> A ? B ! C) -> D
i/control.resume : (k: Continuation(A, B, C, D), value: A) -> B ? C ! D
i/control.cancel : (k: Continuation(A, B, C, D)) -> Nil ! D
i/control.keep_env : (f: (x: A) -> B ? E ! N) -> { (x: A) -> B ? E } ! N
i/resource.ensure : (body: () -> A ? E ! N, with: () -> Nil ! N) -> A ? E ! N
i/resource.acquire : (open: () -> A ? E ! N, release: (A) -> Nil ! N, use: (A) -> B ? E ! N) -> B ? E ! N
i/assertion.catch : (body: () -> A ? E ! N) -> Result(A, AssertionFailure) ? E ! N - Assert
i/request.new_root : (parent: Key(Nil)) -> Key(Nil)
i/request.end_root : (root: Key(Nil)) -> Nil
i/request.new_owner : (root: Key(Nil)) -> Key(Nil)
i/request.end_owner : (owner: Key(Nil)) -> Nil
i/request.group_count : (owner: Key(Nil)) -> Int
i/request.root_count : (root: Key(Nil)) -> Int
i/request.cancel_group : (owner: Key(Nil)) -> Nil
i/request.cancel_root : (root: Key(Nil)) -> Nil
i/request.observe_owner : (owner: Key(Nil)) -> Request(Nil)
i/request.observe_root : (root: Key(Nil)) -> Request(Nil)
i/request.open_root : () -> Root ! Root
i/request.close_root : (root: Root) -> Nil
i/request.open_owner : () -> Owner ! Root
i/request.close_owner : (owner: Owner) -> Nil
i/request.count : (owner: Owner) -> Int
i/request.count_root : (root: Root) -> Int
i/request.settled_owner : (owner: Owner) -> Bool
i/request.settled_root : (root: Root) -> Bool
i/request.cancel_all : (owner: Owner) -> Nil
i/request.cancel_all_root : (root: Root) -> Nil
i/request.retain : (value: A) -> A
i/request.within : (body: () -> A ? E ! N) -> A ? E ! Root | N - Owner
i/request.wait_none : (owner: Owner) -> Nil ! Await
i/request.wait_none_root : (root: Root) -> Nil ! Await
i/request.ready : (value: A) -> Request(A)
i/request.ticket : (r: Request(A)) -> Ticket
i/request.read_state : (r: Request(A)) -> Result(A, Int)
i/request.take : (r: Request(A)) -> A
i/request.settled : (r: Ticket) -> Bool
i/request.cancel : (r: Ticket) -> Nil
i/request.state : (r: Request(A)) -> RequestState(A)
i/request.await : (r: Request(A)) -> A ! Await
i/request.await_owned : (r: Request(A)) -> A ! Await
i/request.wait_any : (rs: List(Ticket)) -> Nil
i/request.poll : () -> Nil
i/request.entry_root : () -> Key(Nil)
i/request.entry_end : () -> Nil
i/request.entry : (body: () -> A ? E ! N) -> A ? E ! N - Await - Owner - Root
i/key.new : () -> Key(A)
i/key.wrap : (k: Key(A), value: A) -> Keyed
i/key.read : (k: Key(A), value: Keyed) -> Result(A, Nil)
i/key.unwrap : (k: Key(A), x: Keyed) -> Lookup(A)
i/core.not : (Bool) -> Bool
i/core.to_float : (Int) -> Float
i/core.truncate : (Float) -> Int
i/core.floor : (Float) -> Float
i/core.ceiling : (Float) -> Float
i/core.sqrt : (Float) -> Float
i/core.float_to_bits : (Float) -> Int
i/core.float_from_bits : (Int) -> Float
i/core.bit_and : (Int, Int) -> Int
i/core.bit_or : (Int, Int) -> Int
i/core.bit_xor : (Int, Int) -> Int
i/core.bit_not : (Int) -> Int
i/core.shift_left : (Int, Int) -> Int
i/core.shift_right : (Int, Int) -> Int
i/core.concat : (List(String)) -> String
i/core.byte_size : (String) -> Int
i/core.byte_slice : (String, start: Int, length: Int) -> Result(String, Nil)
i/core.codepoints : (String) -> List(UtfCodepoint)
i/core.from_codepoints : (List(UtfCodepoint)) -> String
i/core.codepoint_to_int : (UtfCodepoint) -> Int
i/core.int_to_codepoint : (Int) -> Result(UtfCodepoint, Nil)
i/core.to_upper : (String) -> String
i/core.to_lower : (String) -> String
i/core.index_of : (in: String, find: String, from: Int) -> Result(Int, Nil)
i/core.bit_size : (BitArray) -> Int
i/core.bit_array_to_string : (BitArray) -> Result(String, Nil)
i/core.bit_array_concat : (List(BitArray)) -> BitArray
i/core.inspect : (A) -> String
i/core.hash : (A) -> Int
i/core.portable : (value: A) -> Bool
i/random.word_size : () -> Int
i/random.mask : (x: Int) -> Int
i/random.xor_shift : (x: Int, n: Int) -> Int
i/random.mix : (x: Int) -> Int
i/random.variant : (x: Int) -> Int
i/random.popcount : (x: Int, count: Int) -> Int
i/random.mix_gamma : (x: Int) -> Int
i/random.from_seed : (seed: Int) -> Generator
i/random.word : (g: Generator) -> (Int, Generator)
i/random.space_for : (below: Int, space: Int) -> Int
i/random.word_group : (g: Generator, space: Int, scale: Int, value: Int) -> (Int, Generator)
i/random.bounded : (g: Generator, below: Int, space: Int, limit: Int) -> (Int, Generator)
i/random.int : (g: Generator, below: Int) -> (Int, Generator) ? RandomError
i/random.float : (g: Generator) -> (Float, Generator)
i/random.native_split : (h: State) -> (State, State)
i/random.edge : (h: State, bit: Int) -> State
i/random.split : (g: Generator) -> (Generator, Generator)
i/random.valid_path : (path: List(Int)) -> Bool
i/random.binary : (n: Int, bits: List(Int), length: Int) -> (List(Int), Int)
i/random.zeros : (h: State, count: Int) -> State
i/random.follow : (h: State, bits: List(Int)) -> State
i/random.derive_path : (g: Generator, path: List(Int)) -> Generator
i/random.at_path : (g: Generator, path: List(Int)) -> Generator ? RandomError
