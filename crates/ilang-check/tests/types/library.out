i/fail.from_result : (result: Result(A, B)) -> A ? B
i/fail.map_error : (body: () -> A ? E ! N, with: (E) -> B ! N) -> A ? B ! N
i/control.boundary : (body: (b: Boundary(A, B, C)) -> A ? B ! C) -> A ? B ! C
i/control.suspend : (b: Boundary(A, B, C), f: (k: Continuation(D, A, B, C)) -> A ? B ! C) -> D
i/control.resume : (k: Continuation(A, B, C, D), value: A) -> B ? C ! D
i/control.cancel : (k: Continuation(A, B, C, D)) -> Nil ! D
i/resource.ensure : (body: () -> A ? E ! N, with: () -> Nil ! N) -> A ? E ! N
i/resource.acquire : (open: () -> A ? E ! N, release: (A) -> Nil ! N, use: (A) -> B ? E ! N) -> B ? E ! N
i/assertion.catch : (body: () -> A ? E ! N) -> Result(A, AssertionFailure) ? E ! N - Assert
