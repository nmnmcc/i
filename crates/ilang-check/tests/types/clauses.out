one : (n: A) -> A
many : (A) -> 1 | 2
blocks : List((A) -> 0 | 1 | 2 | 3)
loop : (Int) -> Done
local : () -> Done
mutual : () -> (Bool, Bool)
get : (opt: Option(User)) -> String ! Assert
map : (opts: List(Option(User))) -> List(String)
list_map : (xs: List(A), f: (A) -> B) -> List(B)
expected : () -> String
f : (x: Int) -> Int
subject_scope : () -> Int
empty : (x: Never) -> Never
