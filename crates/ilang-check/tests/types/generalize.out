param : (f: (1 | "a") -> A & B ? E ! N) -> (A, B) ? E ! N
fact : (n: Int) -> Int
loop : (x: A) -> Never
even : (n: Int) -> Bool
odd : (n: Int) -> Bool
f : (x: A) -> Never
g : (x: A) -> Never
uses : (Bool, Never, Never)
