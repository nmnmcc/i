apply : (f: (User) -> A, x: User) -> A
map : (xs: List(A), f: (A) -> B) -> List(B)
flip : (f: (A) -> B, xs: List(A)) -> List(B)
u : User
left_fn : String
left_fn_later : List(Int)
pair : (p: ((User) -> Int, Int)) -> ((User) -> Int, Int)
left_tuple : ((User) -> Int, Int)
unknown : (g: ((u: (name: A)) -> A) -> B ? E ! N) -> B ? E ! N
