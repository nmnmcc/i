 (local.set $n (call $wa_uint (local.get $id) (i64.const 9223372036854775807)))
 (local.set $f (global.get $wa_files))
 (block $done (loop $each
  (br_if $done (ref.is_null (local.get $f)))
  (if (i64.eq (struct.get $wa_file 0 (ref.as_non_null (local.get $f))) (local.get $n)) (then (return (local.get $f))))
  (local.set $f (struct.get $wa_file 3 (ref.as_non_null (local.get $f)))) (br $each)))
 (ref.null $wa_file))
(func $wa_fd (param $id eqref) (result i32)
 (local $f (ref null $wa_file)) (local.set $f (call $wa_file_find (local.get $id)))
 (if (ref.is_null (local.get $f)) (then (call $wa_fail {{closed}})))
 (if (i32.eqz (struct.get $wa_file 2 (ref.as_non_null (local.get $f)))) (then (call $wa_fail {{closed}})))
 (struct.get $wa_file 1 (ref.as_non_null (local.get $f))))
(func $wa_fs_close (param $id eqref) (result eqref)
 (local $f (ref null $wa_file)) (local.set $f (call $wa_file_find (local.get $id)))
 (if (ref.is_null (local.get $f)) (then (return (ref.null eq))))
 (if (struct.get $wa_file 2 (ref.as_non_null (local.get $f))) (then
  (struct.set $wa_file 2 (ref.as_non_null (local.get $f)) (i32.const 0))
  (drop (call $wa_raw_fd_close (struct.get $wa_file 1 (ref.as_non_null (local.get $f)))))))
