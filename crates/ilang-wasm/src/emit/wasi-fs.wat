      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $compare)))
     (if (i32.and (i32.lt_u (local.get $len) (local.get $n)) (i32.ne (i32.load8_u (i32.add (local.get $p) (local.get $len))) (i32.const 47))) (then
      (if (i32.eqz (i32.and (i32.eq (local.get $len) (i32.const 1)) (i32.eq (i32.load8_u (local.get $name)) (i32.const 47)))) (then (local.set $match (i32.const 0))))))))))
  (if (i32.and (local.get $match) (i32.or (i32.eq (local.get $best) (i32.const -1)) (i32.ge_u (local.get $len) (local.get $bestlen)))) (then
   (local.set $best (local.get $fd)) (local.set $bestlen (local.get $len))))
