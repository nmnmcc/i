;; Resolve against the longest matching preopen. WASI enforces relative-path confinement.
;; The returned string is copied; no address escapes the checked kernel.
(func $wa_path (param $path eqref) (result i32 eqref)
 (local $fd i32) (local $best i32) (local $bestlen i32) (local $match i32)
 (local $scratch i32) (local $name i32) (local $len i32) (local $p i32) (local $n i32) (local $i i32) (local $e i32) (local $r eqref)
 (local.set $n (call $string_length_bytes (local.get $path)))
 (if (i32.eqz (local.get $n)) (then (call $wa_fail {{invalid}})))
 (local.set $p (call $string_to_mem (local.get $path)))
 (block $end (loop $scan
  (br_if $end (i32.eq (local.get $i) (local.get $n)))
  (if (i32.eqz (i32.load8_u (i32.add (local.get $p) (local.get $i)))) (then
   (call $free (local.get $p) (i32.const 0)) (call $wa_fail {{invalid}})))
  (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $scan)))
 (local.set $scratch (call $alloc (i32.const 8))) (local.set $fd (i32.const 3)) (local.set $best (i32.const -1))
 (block $done (loop $each
  (local.set $e (call $wa_raw_fd_prestat_get (local.get $fd) (local.get $scratch)))
  (br_if $done (i32.eq (local.get $e) (i32.const 8)))
  (if (local.get $e) (then
   (call $free (local.get $scratch) (i32.const 8)) (call $free (local.get $p) (i32.const 0)) (call $wa_errno (local.get $e))))
  (local.set $len (i32.load offset=4 (local.get $scratch)))
  (local.set $name (call $alloc (local.get $len)))
  (local.set $e (call $wa_raw_fd_prestat_dir_name (local.get $fd) (local.get $name) (local.get $len)))
  (if (local.get $e) (then
   (call $free (local.get $name) (i32.const 0)) (call $free (local.get $scratch) (i32.const 8)) (call $free (local.get $p) (i32.const 0)) (call $wa_errno (local.get $e))))
  (local.set $match (i32.const 0))
  (if (i32.and (i32.eq (local.get $len) (i32.const 1)) (i32.eq (i32.load8_u (local.get $name)) (i32.const 46))) (then
   (if (i32.ne (i32.load8_u (local.get $p)) (i32.const 47)) (then (local.set $match (i32.const 1)) (local.set $len (i32.const 0)))))
   (else
    (if (i32.le_u (local.get $len) (local.get $n)) (then
