(func $wa_open (param $path eqref) (param $flags i32) (param $rights i64) (param $fdflags i32) (result i32)
 (local $fd i32) (local $rel eqref) (local $p i32) (local $out i32) (local $e i32) (local $result i32)
 (call $wa_path (local.get $path)) (local.set $rel) (local.set $fd)
 (local.set $p (call $string_to_mem (local.get $rel))) (local.set $out (call $alloc (i32.const 4)))
 (local.set $e (call $wa_raw_path_open (local.get $fd) (i32.const 1) (local.get $p) (call $string_length_bytes (local.get $rel))
  (local.get $flags) (local.get $rights) (i64.const 0) (local.get $fdflags) (local.get $out)))
 (local.set $result (i32.load (local.get $out)))
 (call $free (local.get $out) (i32.const 4)) (call $free (local.get $p) (i32.const 0))
 (call $wa_errno (local.get $e)) (local.get $result))
(func $wa_fs_open (param $path eqref) (param $mode eqref) (result eqref)
 (local $flags i32) (local $rights i64) (local $fdflags i32) (local $fd i32)
 (if (call $equal (local.get $mode) {{read}}) (then (local.set $rights (i64.const 2)))
 (else (if (call $equal (local.get $mode) {{truncate}}) (then (local.set $flags (i32.const 9)) (local.set $rights (i64.const 64)))
 (else (if (call $equal (local.get $mode) {{append}}) (then (local.set $flags (i32.const 1)) (local.set $fdflags (i32.const 1)) (local.set $rights (i64.const 64)))
 (else (if (call $equal (local.get $mode) {{read_write}}) (then (local.set $flags (i32.const 1)) (local.set $rights (i64.const 66)))
 (else (call $wa_fail {{invalid}})))))))))
 (local.set $fd (call $wa_open (local.get $path) (local.get $flags) (local.get $rights) (local.get $fdflags)))
