;; Live file tokens are distinct from WASI descriptor numbers and never reused.
(type $wa_file (struct (field i64) (field i32) (field (mut i32)) (field (ref null $wa_file))))
(global $wa_files (mut (ref null $wa_file)) (ref.null $wa_file))
(global $wa_next (mut i64) (i64.const 0))
(func $wa_file_find (param $id eqref) (result (ref null $wa_file))
