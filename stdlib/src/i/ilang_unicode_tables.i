fn range_lookup(table: BitArray, cp: Int, low: Int, high: Int) -> Int {
  case low >= high {
    True -> 0
    False -> {
      let middle = { low + high } / 2
      let offset = middle * 9
      let assert <<_:size(offset)-bytes, start:32, end:32, value:8, _:bits>> =
        table
      case cp < start {
        True -> range_lookup(table, cp, low, middle)
        False -> {
          case cp > end {
            True -> range_lookup(table, cp, middle + 1, high)
            False -> value
          }
        }
      }
    }
  }
}

fn case_lookup(table: BitArray, cp: Int, low: Int, high: Int) -> List(Int) {
  case low >= high {
    True -> [cp]
    False -> {
      let middle = { low + high } / 2
      let offset = middle * 17
      let assert <<
        _:size(offset)-bytes,
        scalar:32,
        count:8,
        first:32,
        second:32,
        third:32,
        _:bits,
      >> = table
      case cp < scalar {
        True -> case_lookup(table, cp, low, middle)
        False -> {
          case cp > scalar {
            True -> case_lookup(table, cp, middle + 1, high)
            False -> {
              case count {
                1 -> [first]
                2 -> [first, second]
                _ -> [first, second, third]
              }
            }
          }
        }
      }
    }
  }
}
