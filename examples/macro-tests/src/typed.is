(, (= syntax (/ i syntax)) (= fail (/ i fail)) (= core (/ i core)))
(, to_text assert_eq)
(= int_text (-> (, (: value Int)) String ((. core inspect) value)))
/// Convert an Int or String expression, checking its type at expansion time.
(@ macro (: to_text (-> [A] (, A) String)))
(@ macro
  (= to_text
    (-> (, value) _
      {(= t ((. syntax type_of) value))
       (|> ((. syntax subtype) t `Int)
           (| (-> (, (. syntax Yes)) _ `(int_text ~value))
             (-> (, _) _
               (|>
                ((. syntax subtype) t `String)
                (| (-> (, (. syntax Yes)) _ value)
                  (-> (, (. syntax NotKnown)) _
                    ((. fail raise)
                     ((. syntax SyntaxError)
                      (= message
                        "typed to_text cannot choose inside a generic binding")
                      (= at value))))
                  (-> (, (. syntax No)) _
                    ((. fail raise)
                     ((. syntax SyntaxError)
                      (= message "typed to_text expects Int or String")
                      (= at value)))))))))})))
/// Compare two checked arguments using ordinary runtime assertion code.
(@ macro (: assert_eq (-> [A] (, A A) (<- Nil (, Assert)))))
(@ macro (= assert_eq (-> (, left right) _ `(assert (== ~left ~right)))))
