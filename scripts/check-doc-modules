#!/usr/bin/env python3
"""Check that library modules the documentation names exist in the release.

The site is read by people who install the newest `stdlib-v*` tag, because
that is what `i new` writes. A module the docs promise but that tag does not
have is a page nobody can run. A page about the next release says so with a
visible first line `> **Unpublished.** ...` and is left out.

Only `i/<module>` claims are checked in the user-facing pages. Design notes
and the standard are left out: both may name modules before the library ships
them.
"""
import argparse
import os
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
DOCS = ('README.md', 'docs/**/*.md', 'docs/**/*.mdx')
SKIP = ('docs/content/docs/standard', 'docs/design', 'docs/spec.md')
CLAIM = re.compile(r'(?<![\w./-])i/([a-z][a-z0-9_]*(?:/[a-z][a-z0-9_]*)*)')
UNPUBLISHED = re.compile(r'(?m)^>\s*\*\*Unpublished\.')


def modules(root, tag):
    """The modules of the library the site documents.

    `tag` names a released library and is read from that commit. Without a
    tag the site documents the working tree, so the working tree is the
    baseline too: one value, one source.
    """
    names = set()
    if tag is None:
        for directory in ('src', 'test'):
            for path in (root / 'stdlib' / directory).iterdir():
                if path.suffix in ('.i', '.is'):
                    names.add(path.stem)
        return names
    for directory in ('src', 'test'):
        out = subprocess.run(
            ['git', '-C', str(root), 'ls-tree', '--name-only', f'{tag}:stdlib/{directory}'],
            capture_output=True, text=True, check=True,
        ).stdout.split()
        names.update(name.rsplit('.', 1)[0] for name in out if name.endswith(('.i', '.is')))
    return names


def check_file(root, path, known, label):
    text = path.read_text(errors='replace')
    if UNPUBLISHED.search(text):
        return []
    errors = []
    for number, line in enumerate(text.splitlines(), 1):
        for match in CLAIM.finditer(line):
            module = match.group(1)
            if module not in known:
                errors.append(f'{path.relative_to(root)}:{number}: i/{module} is not in {label}')
    return errors


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--root', type=Path, default=ROOT)
    args = parser.parse_args()
    root = args.root.resolve()
    tag = os.environ.get('LIBRARY_TAG') or None
    label = tag or 'the working tree'
    known = modules(root, tag)
    files = []
    for pattern in DOCS:
        files.extend(sorted(root.glob(pattern)))
    errors = []
    checked = 0
    for path in files:
        if not path.is_file() or {'node_modules', 'dist', '.astro'} & set(path.parts):
            continue
        relative = str(path.relative_to(root))
        if relative.startswith(SKIP):
            continue
        checked += 1
        errors.extend(check_file(root, path, known, label))
    if errors:
        print('\n'.join(errors), file=sys.stderr)
        print(f'{len(errors)} documented library modules are not in {label}.', file=sys.stderr)
        return 1
    print(f'Documented library modules checked in {checked} files against {label}.')
    return 0


if __name__ == '__main__':
    sys.exit(main())
