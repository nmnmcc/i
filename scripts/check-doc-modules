#!/usr/bin/env python3
"""Check that library modules the documentation names exist in the release.

The site is read by people whose project pins the library version this
compiler pairs with, because `i new` writes it. While that release is not
published, the checkout is the only library that checks; the check names the
source it read. A page about the next release says so with a
visible first line `> **Unpublished.** ...` and is left out.

Only `i/<module>` claims are checked in the user-facing pages. Design notes
and the standard are left out: both may name modules before the library ships
them.
"""
import argparse
import re
import subprocess
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
DOCS = ('README.md', 'docs/**/*.md', 'docs/**/*.mdx')
SKIP = ('docs/content/docs/standard', 'docs/design', 'docs/spec.md')
CLAIM = re.compile(r'(?<![\w./-])i/([a-z][a-z0-9_]*(?:/[a-z][a-z0-9_]*)*)')
UNPUBLISHED = re.compile(r'(?m)^>\s*\*\*Unpublished\.')


def modules(root):
    names = set()
    for directory in ('src', 'test'):
        names.update(path.stem for path in (root / 'stdlib' / directory).glob('*')
                     if path.suffix in ('.i', '.is'))
    return names


def check_file(root, path, known):
    text = path.read_text(errors='replace')
    if UNPUBLISHED.search(text):
        return []
    errors = []
    for number, line in enumerate(text.splitlines(), 1):
        for match in CLAIM.finditer(line):
            module = match.group(1)
            if module not in known:
                errors.append(f'{path.relative_to(root)}:{number}: i/{module} is not in the development tree')
    return errors


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--root', type=Path, default=ROOT)
    args = parser.parse_args()
    root = args.root.resolve()
    known = modules(root)
    files = []
    for pattern in DOCS:
        files.extend(sorted(root.glob(pattern)))
    errors = []
    checked = 0
    for path in files:
        if not path.is_file() or {'node_modules', 'dist', '.astro'} & set(path.parts):
            continue
        relative = str(path.relative_to(root))
        if relative.startswith(SKIP):
            continue
        checked += 1
        errors.extend(check_file(root, path, known))
    if errors:
        print('\n'.join(errors), file=sys.stderr)
        print(f'{len(errors)} documented library modules are not in the development tree.', file=sys.stderr)
        return 1
    print(f'Documented library modules checked in {checked} files against the development tree.')
    return 0


if __name__ == '__main__':
    sys.exit(main())
