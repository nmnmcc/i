#!/usr/bin/env python3
"""Check that library modules the documentation names exist in its library.

The library is the one `docs/scripts/library_baseline.py` defines, the same
one the pages describe and the examples run against. A module the docs
promise but that library does not have is a page nobody can run. A page
about a later release says so with a visible first line
`> **Unpublished.** ...` and is left out.

Only `i/<module>` claims are checked in the user-facing pages. Design notes
and the standard are left out: both may name modules before the library ships
them.
"""
import argparse
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / 'docs' / 'scripts'))
import library_baseline

DOCS = ('README.md', 'docs/**/*.md', 'docs/**/*.mdx')
SKIP = ('docs/content/docs/standard', 'docs/content/docs/library/generated', 'docs/design', 'docs/spec.md')
CLAIM = re.compile(r'(?<![\w./-])i/([a-z][a-z0-9_]*(?:/[a-z][a-z0-9_]*)*)')
UNPUBLISHED = re.compile(r'(?m)^>\s*\*\*Unpublished\.')


def modules(baseline):
    """The modules of the library the site documents, from the directory the
    pages and examples read."""
    names = set()
    for directory in ('src', 'test'):
        for path in (baseline.root / directory).iterdir():
            if path.name.endswith(('.i', '.is')):
                names.add(path.stem)
    return names


def check_file(root, path, known, label):
    text = path.read_text(errors='replace')
    if UNPUBLISHED.search(text):
        return []
    errors = []
    for number, line in enumerate(text.splitlines(), 1):
        for match in CLAIM.finditer(line):
            module = match.group(1)
            if module not in known:
                errors.append(f'{path.relative_to(root)}:{number}: i/{module} is not in {label}')
    return errors


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--root', type=Path, default=ROOT)
    args = parser.parse_args()
    root = args.root.resolve()
    baseline = library_baseline.current(root)
    known = modules(baseline)
    label = baseline.label
    files = []
    for pattern in DOCS:
        files.extend(sorted(root.glob(pattern)))
    errors = []
    checked = 0
    for path in files:
        if not path.is_file() or {'node_modules', 'dist', '.astro'} & set(path.parts):
            continue
        relative = str(path.relative_to(root))
        if relative.startswith(SKIP):
            continue
        checked += 1
        errors.extend(check_file(root, path, known, label))
    if errors:
        print('\n'.join(errors), file=sys.stderr)
        print(f'{len(errors)} documented library modules are not in {label}.', file=sys.stderr)
        return 1
    print(f'Documented library modules checked in {checked} files against {label}.')
    return 0


if __name__ == '__main__':
    sys.exit(main())
