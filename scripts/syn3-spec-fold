#!/usr/bin/env python3
"""At the conversion to syntax three, folds the staged text of docs/spec.md
(its first comment): each `<!-- syn3-old -->` … `<!-- /syn3-old -->` block is
deleted with its markers, the `<!-- syn3-new -->` and `<!-- /syn3-new -->`
marker lines are deleted, and each ```` ```i future-SYN3 ```` fence becomes
```` ```i ````. The staging comment itself is deleted. Running it again
changes nothing. Called by scripts/syn3-convert-all.

    scripts/syn3-spec-fold [FILE...]   (default: docs/spec.md)
"""
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
for path in sys.argv[1:] or [str(ROOT / "docs/spec.md")]:
    p = Path(path)
    text = p.read_text()
    old = text
    text = re.sub(r"(?m)^<!-- Text between syn3-old markers is.*?-->\n", "", text, flags=re.S)
    text = re.sub(r"(?ms)^<!-- syn3-old -->\n.*?^<!-- /syn3-old -->\n", "", text)
    text = re.sub(r"(?m)^<!-- /?syn3-new -->\n", "", text)
    text = re.sub(r"(?m)^```i future-SYN3[ \t]*$", "```i", text)
    if "syn3-old" in text:
        sys.exit(f"syn3-spec-fold: FAILED: {path}: an unmatched syn3-old marker is left")
    if text != old:
        p.write_text(text)
        print(f"syn3-spec-fold: {path} folded")
