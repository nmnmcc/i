#!/usr/bin/env python3
"""Rewrite the value-level chain separator `|` to `&` in i source that is not a
whole .i/.is file.

The sources this tool owns are embedded ones: Markdown/MDX fences, i source
inside Rust string literals, and i source inside the snippet registry JSON.
Each is assembled exactly the way its owner assembles it -- scripts/check-snippets
with scripts/check-snippets.json, docs/scripts/check-examples.py and
docs/scripts/run-examples.py with docs/scripts/examples.json and
docs/scripts/example_fences.py -- then the assembled text is handed to the
current parser, which reports the byte offset of every value-level chain
separator it found as a `ExprKind::Chain` node (a `|` token between two branch
spans, or the `|` head of a Lisp chain). Those offsets, mapped back through the
assembly's origin map, are the only bytes this tool changes: `|` becomes `&`.

No character shape, no neighbouring character and no diagnostic difference is
ever the authority for a byte. The parse diagnostics and an AST fingerprint are
audited and reported, per source, but they do not select a byte.

The separator interface is one function, `chain_separators()`, which speaks the
protocol of crates/ilang-syntax/examples/chain-separators.rs (executor amp2's
migration helper): requests `<normal|lisp> <path>` on stdin, and per request
`FILE`, `SEP <offset>` lines, `DIAG <code> <hex message>`, `AST <fingerprint>`,
`END`. Set I_CHAIN_SEPARATORS to that example binary; the default is
`<root>/target/debug/examples/chain-separators`.

`|` -> `&` keeps the byte length, so every position in the host is unchanged.

Every considered source is reported: migrated (with host offsets), clean, no
bars, rejected by the parser but recovered (migrated from recovered nodes, which
carry their own span proof), design note, not i source, or needs a human, with
the reason. Nothing is dropped silently.

Modes: --dry-run (default), --write, --check. --check exits 1 while any
rewritable separator remains, so it is the idempotence gate after --write.
--verify-extraction checks the readers here against the owner readers.
"""
import argparse
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile

ROOT = Path(__file__).resolve().parent.parent
REGISTRY = ROOT / "scripts/check-snippets.json"
DOCS_REGISTRY = ROOT / "docs/scripts/examples.json"
SPEC_PATH = "docs/spec.md"
# Markdown owned by the example-runner fixtures; it is test input, not docs.
OWNER_SKIPPED = ("docs/scripts/run-examples-fixtures/",)
WRAP_OPEN = "m = () {\n"
WRAP_CLOSE = "\n}\n"
TAIL_OPEN = "m = () {\n(0) { 0 }"
LISP_OPEN = "(= migrate "
TYPE_OPEN = "(: migrate "
LISP_CLOSE = ")\n"


def owner_modules():
    """Load the owner extractors instead of restating their rules."""
    loader = importlib.machinery.SourceFileLoader("repo_snippets", str(ROOT / "scripts/check-snippets"))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    checker = importlib.util.module_from_spec(spec)
    loader.exec_module(checker)
    sys.path.insert(0, str(ROOT / "docs/scripts"))
    fences_loader = importlib.machinery.SourceFileLoader("owner_fences", str(ROOT / "docs/scripts/example_fences.py"))
    fences_spec = importlib.util.spec_from_loader(fences_loader.name, fences_loader)
    fences = importlib.util.module_from_spec(fences_spec)
    fences_loader.exec_module(fences)
    sys.path.pop(0)
    return checker, fences


checker, fences_owner = owner_modules()


# --------------------------------------------------------------------------
# Text with an origin for every character: (file, character offset) or None.
# The offset is a character offset in the decoded host file; it becomes a byte
# offset only where a byte is rewritten (hosts are UTF-8, so the two differ).
# --------------------------------------------------------------------------
class Text:
    __slots__ = ("chars", "origin")

    def __init__(self, chars=None, origin=None):
        self.chars = list(chars or "")
        self.origin = list(origin or [])

    def __str__(self):
        return "".join(self.chars)

    def __len__(self):
        return len(self.chars)

    def add(self, text, origin):
        assert len(text) == len(origin), (text, len(origin))
        self.chars.extend(text)
        self.origin.extend(origin)
        return self

    def extend(self, other):
        return self.add(str(other), other.origin)

    def replace_all(self, old, new, new_origin):
        """The owner's textual substitution, keeping every origin."""
        text = str(self)
        out = Text()
        at = 0
        while True:
            hit = text.find(old, at)
            if hit < 0:
                break
            out.add(text[at:hit], self.origin[at:hit])
            out.add(new, new_origin)
            at = hit + len(old)
        out.add(text[at:], self.origin[at:])
        return out


def byte_offset(host_text, offset):
    """Byte offset of a character offset, for the one byte we rewrite."""
    return len(host_text[:offset].encode())


def char_index(text, byte):
    """The character index of a byte offset in UTF-8 `text`.

    The separator driver reports byte offsets; every origin map here counts
    characters, because the host readers decode text first.
    """
    return len(text.encode("utf-8")[:byte].decode("utf-8"))


def plain(text, path, base=0):
    return Text(text, [(path, base + i) for i in range(len(text))])


# --------------------------------------------------------------------------
# Host readers. They mirror the owner readers and add origins; nothing else.
# --------------------------------------------------------------------------
RAW = re.compile(r'r(#+)?"')
CHAR = re.compile(r"'(?:\\(?:[nrt0\\'\"]|x[0-9a-fA-F]{2}|u\{[0-9a-fA-F_]+\})|[^'\\])'")


def rust_strings(text, path):
    """scripts/check-snippets.rust_strings with origins; see --verify-extraction."""
    i = 0
    while i < len(text):
        if text.startswith("//", i):
            end = text.find("\n", i)
            i = len(text) if end < 0 else end
            continue
        if text.startswith("/*", i):
            depth = 1
            i += 2
            while depth and i < len(text):
                if text.startswith("/*", i):
                    depth += 1
                    i += 2
                elif text.startswith("*/", i):
                    depth -= 1
                    i += 2
                else:
                    i += 1
            continue
        raw = RAW.match(text, i)
        if raw:
            start = i
            hashes = raw[1] or ""
            i = raw.end()
            end = text.index('"' + hashes, i)
            body = text[i:end]
            yield start, end + 1 + len(hashes), body, plain(body, path, i)
            i = end + 1 + len(hashes)
            continue
        if text[i] == '"':
            start = i
            i += 1
            value = Text()
            while i < len(text) and text[i] != '"':
                c = text[i]
                if c != "\\":
                    value.add(c, [(path, i)])
                    i += 1
                    continue
                escape = i
                i += 1
                c = text[i]
                i += 1
                if c in "\n\r":
                    while i < len(text) and text[i].isspace():
                        i += 1
                elif c in "nrt0":
                    value.add(dict(n="\n", r="\r", t="\t", **{"0": "\0"})[c], [(path, escape)])
                elif c in "\\\"'":
                    value.add(c, [(path, escape)])
                elif c == "x":
                    value.add(chr(int(text[i:i + 2], 16)), [(path, escape)])
                    i += 2
                elif c == "u":
                    end = text.index("}", i)
                    value.add(chr(int(text[i + 1:end].replace("_", ""), 16)), [(path, escape)])
                    i = end + 1
                else:
                    raise ValueError((start, c))
            yield start, i + 1, str(value), value
            i += 1
            continue
        if text[i] == "'":
            char = CHAR.match(text, i)
            if char:
                i = char.end()
                continue
        i += 1


def json_strings(text, path):
    """Every JSON string value with its key path and decoded origin."""
    collected = []

    def string_at(i):
        assert text[i] == '"', (path, i)
        i += 1
        value = Text()
        while text[i] != '"':
            c = text[i]
            if c != "\\":
                value.add(c, [(path, i)])
                i += 1
                continue
            escape = i
            i += 1
            c = text[i]
            i += 1
            unescape = {"n": "\n", "r": "\r", "t": "\t", "b": "\b", "f": "\f"}
            if c in unescape:
                value.add(unescape[c], [(path, escape)])
            elif c == "u":
                unit = int(text[i:i + 4], 16)
                i += 4
                if 0xD800 <= unit <= 0xDBFF and text[i:i + 2] == "\\u":
                    low = int(text[i + 2:i + 6], 16)
                    if 0xDC00 <= low <= 0xDFFF:
                        unit = 0x10000 + ((unit - 0xD800) << 10) + (low - 0xDC00)
                        i += 6
                value.add(chr(unit), [(path, escape)])
            else:
                value.add(c, [(path, escape)])
        return value, i + 1

    def scalar(i):
        match = re.compile(r"-?[0-9][0-9.eE+-]*|true|false|null").match(text, i)
        assert match, (path, i, text[i:i + 30])
        return match.end()

    def walk(i, where):
        while text[i].isspace():
            i += 1
        if text[i] == '"':
            value, end = string_at(i)
            collected.append((where, value))
            return end
        if text[i] == "[":
            i += 1
            index = 0
            while True:
                while text[i].isspace():
                    i += 1
                if text[i] == "]":
                    return i + 1
                i = walk(i, where + (index,))
                index += 1
                while text[i].isspace():
                    i += 1
                if text[i] == ",":
                    i += 1
        if text[i] == "{":
            i += 1
            while True:
                while text[i].isspace():
                    i += 1
                if text[i] == "}":
                    return i + 1
                key, i = string_at(i)
                key = str(key)
                while text[i].isspace():
                    i += 1
                assert text[i] == ":", (path, i)
                i += 1
                i = walk(i, where + (key,))
                while text[i].isspace():
                    i += 1
                if text[i] == ",":
                    i += 1
        return scalar(i)

    walk(0, ())
    yield from collected


def fence_blocks(text, path):
    """docs/scripts/example_fences.fences with origins; see --verify-extraction."""
    lines = text.splitlines(keepends=True)
    offsets = []
    at = 0
    for line in lines:
        offsets.append(at)
        at += len(line)
    index = 0
    while index < len(lines):
        opening = re.fullmatch(r'( {0,3})(`{3,}|~{3,})([^\n]*)\n?', lines[index])
        if not opening or (opening[2][0] == '`' and '`' in opening[3]):
            index += 1
            continue
        start = index
        index += 1
        source = Text()
        closing = re.compile(r' {0,3}' + re.escape(opening[2][0])
                             + '{' + str(len(opening[2])) + r',}[ \t]*\n?')
        while index < len(lines) and not closing.fullmatch(lines[index]):
            line = lines[index]
            spaces = len(line) - len(line.lstrip(' '))
            cut = min(spaces, len(opening[1]))
            body = line[cut:]
            source.add(body, [(path, offsets[index] + cut + k) for k in range(len(body))])
            index += 1
        yield opening[3].strip(), source, start + 1, index < len(lines)
        index += 1


# --------------------------------------------------------------------------
# Registries.
# --------------------------------------------------------------------------
REGISTRY_TEXTS = {}


def read(path):
    """The host file as text with no newline translation, so a character
    offset converts to the byte offset exactly once, here."""
    return (ROOT / path).read_bytes().decode("utf-8")


def load_registries():
    entries = json.loads(read(REGISTRY.relative_to(ROOT)))
    entries.pop("_syn2_old_forms", None)
    local = json.loads(read(DOCS_REGISTRY.relative_to(ROOT)))
    for file in (REGISTRY, DOCS_REGISTRY):
        rel = str(file.relative_to(ROOT))
        REGISTRY_TEXTS[rel] = {where: value for where, value in json_strings(read(rel), rel)}
    return entries, local


def registry_text(rel, entry_key, field):
    where = (entry_key,) + field
    if where not in REGISTRY_TEXTS[rel]:
        raise KeyError(f"{rel}: no string at {where}")
    return REGISTRY_TEXTS[rel][where]


# --------------------------------------------------------------------------
# Assemblies.
# --------------------------------------------------------------------------
class Assembly:
    def __init__(self, family, path, line, identity, surface, text, entry, registry):
        self.family = family
        self.path = path
        self.line = line
        self.identity = identity
        self.surface = surface
        self.text = text
        self.entry = entry
        self.registry = registry
        self.diagnostics = []
        self.ast = None
        self.separators = []      # assembled offsets, from the parser's Chain nodes
        self.migrated = []        # assembled offsets that map to a host byte
        self.status = None
        self.reason = ""
        self.chain_shaped = False

    @property
    def source(self):
        return str(self.text)


def assemble(family, path, line, identity, surface, body, entry, registry):
    """prefix + snippet + suffix, then the registry's substitutions, exactly as
    scripts/check-snippets and docs/scripts/check-examples.py do."""
    text = Text()
    if entry.get("prefix"):
        text.extend(registry_text(registry, identity, ("prefix",)))
    text.extend(body)
    if entry.get("suffix"):
        text.extend(registry_text(registry, identity, ("suffix",)))
    for index, pair in enumerate(entry.get("substitutions", []) or []):
        old, new = pair
        replacement = registry_text(registry, identity, ("substitutions", index, 1))
        text = text.replace_all(old, str(replacement), replacement.origin)
    return Assembly(family, path, line, identity, surface, text, entry, registry)


def tracked(*patterns):
    out = subprocess.check_output(
        ["git", "ls-files", "--cached", "--others", "--exclude-standard", "--", *patterns],
        cwd=ROOT, text=True).splitlines()
    return sorted(path for path in set(out) if (ROOT / path).is_file())


def extract(registry, docs_registry, include_design):
    """Every embedded source this tool owns, as its owner sees it, plus the
    sources it deliberately leaves alone (listed, with the reason)."""
    assemblies, listed = [], []

    for path in tracked("*.md", "*.mdx"):
        if path.startswith(OWNER_SKIPPED):
            listed.append(dict(family="markdown", path=path, line=0, status="owner_skipped",
                               reason="example-runner fixture Markdown: test input, not documentation"))
            continue
        text = read(path)
        generated = "/standard/generated/" in path
        identity_path = SPEC_PATH if generated else path
        for info, body, line, closed in fence_blocks(text, path):
            try:
                parsed = fences_owner.i_info(info)
            except ValueError as error:
                listed.append(dict(family="markdown", path=path, line=line, status="needs_human",
                                   reason="owner rejects the fence info string: " + str(error)))
                continue
            if parsed is None:
                continue
            kind, filename, codes = parsed
            if filename and Path(filename).suffix not in (".i", ".is"):
                continue  # toml/text project inputs, not i source
            if not closed:
                listed.append(dict(family="markdown", path=path, line=line, status="needs_human",
                                   reason="unclosed i fence"))
                continue
            surface = "lisp" if filename and filename.endswith(".is") else "normal"
            identity = checker.identity(identity_path, str(body))
            if path.startswith("docs/design/") and not include_design:
                listed.append(dict(family="design_note", path=path, line=line, status="design_note",
                                   identity=identity,
                                   reason="docs/design is a design note, not a current doc; listed, not rewritten"))
                continue
            entry = registry.get(identity) or docs_registry.get(identity) or {}
            registry_file = (str(REGISTRY.relative_to(ROOT)) if identity in registry
                             else str(DOCS_REGISTRY.relative_to(ROOT)))
            try:
                assemblies.append(assemble("markdown", path, line, identity, surface, body, entry, registry_file))
            except KeyError as error:
                listed.append(dict(family="markdown", path=path, line=line, status="unassembled",
                                   identity=identity, reason=str(error)))

    for path in tracked("*.rs"):
        if not path.startswith("crates/"):
            continue
        text = read(path)
        for start, end, value, body in rust_strings(text, path):
            identity = checker.identity(path, value)
            registered = identity in registry or identity in docs_registry
            if not (registered or checker.candidate(value) or re.match(r"\s*(?:import|export|case)\b", value)):
                continue
            entry = registry.get(identity) or docs_registry.get(identity) or {}
            registry_file = (str(REGISTRY.relative_to(ROOT)) if identity in registry
                             else str(DOCS_REGISTRY.relative_to(ROOT)))
            line = text.count("\n", 0, start) + 1
            try:
                assemblies.append(assemble("rust", path, line, identity, "normal", body, entry, registry_file))
            except KeyError as error:
                listed.append(dict(family="rust", path=path, line=line, status="unassembled",
                                   identity=identity, reason=str(error)))

    return assemblies, listed


# --------------------------------------------------------------------------
# The separator interface: the old parser's chain nodes, by byte offset.
# --------------------------------------------------------------------------
def separator_driver():
    if os.environ.get("I_CHAIN_SEPARATORS"):
        return Path(os.environ["I_CHAIN_SEPARATORS"]).resolve()
    return Path(os.environ.get("CARGO_TARGET_DIR", ROOT / "target")) / "debug/examples/chain-separators"


def chain_separators(requests):
    """Value-level chain separator offsets and parse facts for each request.

    `requests` is a list of (surface, source). Returns a list of dicts with
    `offsets` (ascending byte offsets in the given source), `diagnostics`
    ("CODE: message" strings) and `ast` (a fingerprint of the parsed tree).
    The protocol belongs to crates/ilang-syntax/examples/chain-separators.rs.
    """
    if not requests:
        return []
    tool = separator_driver()
    if not tool.is_file():
        raise SystemExit(f"separator driver not found: {tool} (set I_CHAIN_SEPARATORS)")
    with tempfile.TemporaryDirectory(prefix="and-chain-") as directory:
        lines = []
        for index, (surface, source) in enumerate(requests):
            # The protocol names a file; the assembler is in memory, so write
            # each assembly to its own file and keep the mapping here.
            path = Path(directory) / f"{index:05d}.src"
            path.write_text(source)
            lines.append(f"{surface} {path}")
        out = subprocess.check_output([str(tool)], input="\n".join(lines) + "\n", text=True)
    results = []
    current = None
    for line in out.splitlines():
        if line.startswith("FILE "):
            current = dict(offsets=[], diagnostics=[], ast=None)
            results.append(current)
        elif line.startswith("SEP "):
            current["offsets"].append(int(line[4:]))
        elif line.startswith("DIAG "):
            _, code, message = line.split(" ", 2)
            current["diagnostics"].append(code + ": " + bytes.fromhex(message).decode())
        elif line.startswith("AST "):
            current["ast"] = int(line[4:])
        elif line.startswith("FAIL "):
            raise SystemExit("separator driver refused a request: " + line)
    if len(results) != len(requests):
        raise SystemExit(f"separator driver returned {len(results)} groups for {len(requests)} requests")
    return results


# --------------------------------------------------------------------------
# Classification.
# --------------------------------------------------------------------------
def classify(assemblies):
    facts = chain_separators([(a.surface, a.source) for a in assemblies])
    for a, fact in zip(assemblies, facts):
        a.separators = fact["offsets"]
        a.diagnostics = fact["diagnostics"]
        a.ast = fact["ast"]
        if a.entry.get("not_source"):
            a.status = "not_source"
            a.reason = "owner registry marks this literal not i source: " + a.entry.get("reason", "")
            if a.separators:
                a.chain_shaped = True
                a.reason += " [chain text: keep it in step with the source it belongs to]"
        elif a.separators:
            a.status = "migrated"
            a.reason = (f"{len(a.separators)} chain separator(s) reported by the parser's chain nodes"
                        + ("" if not a.diagnostics
                           else "; the parser rejects this assembly and recovered the nodes it reported"))
        elif a.diagnostics:
            a.status = "parse_rejected"
            a.reason = "assembled, parser rejects and reports no chain node: " + a.diagnostics[0]
        elif a.surface == "lisp" and re.search(r"\(\|", a.source):
            # A quoted Lisp chain template: the `|` head is data inside a
            # quote, so the parser has no Chain node to report it from.
            a.status = "needs_human"
            a.reason = ("Lisp chain head inside a quote/template: the parser sees data, not a chain node, "
                        "so no separator is reported; the Lisp `&` head means this template needs `&` too")
        else:
            a.status = "no_bars"

    # Only the bytes a chain node names are rewritten, and only where the origin
    # map reaches an actual `|` in the host file.
    edits = {}
    hosts = {}
    for a in assemblies:
        kept = []
        for i in a.separators:
            i = char_index(a.source, i)
            if a.source[i:i + 1] != "|":
                a.status = "needs_human"
                a.reason = f"parser reported a separator at {i}, but the assembly has {a.source[i:i + 1]!r} there"
                continue
            origin = a.text.origin[i]
            if origin is None:
                a.status = "needs_human"
                a.reason = "separator comes from a transformed fragment with no host byte"
                continue
            path, offset = origin
            host = hosts.setdefault(path, read(path))
            if host[offset:offset + 1] != "|":
                a.status = "needs_human"
                a.reason = f"host character at {path}:{offset} is not `|`"
                continue
            kept.append(i)
            edits.setdefault(path, set()).add(byte_offset(host, offset))
        a.migrated = kept
        if a.status == "migrated" and len(kept) != len(a.separators):
            a.status = "needs_human"
            a.reason = "some reported separators do not map to a host byte"

    # Chain text the owner gate does not extract, and text copied from a
    # migrated source: parse it and use the same chain-node offsets, shifted by
    # the wrapper. Two wrappers cover a whole expression and a chain tail.
    fragments = []
    unaccounted = []
    accounted = {(a.path, a.line) for a in assemblies}
    candidates = []
    for path in tracked("*.rs"):
        if not path.startswith("crates/"):
            continue
        text = read(path)
        for start, end, value, body in rust_strings(text, path):
            line = text.count("\n", 0, start) + 1
            if (path, line) in accounted or "|" not in value:
                continue
            candidates.append(dict(path=path, line=line, value=value, body=body,
                                   wraps=[("normal", WRAP_OPEN + value + WRAP_CLOSE, "block expression"),
                                          ("normal", TAIL_OPEN + value + WRAP_CLOSE, "chain tail"),
                                          ("lisp", LISP_OPEN + value + LISP_CLOSE, "Lisp expression"),
                                          ("lisp", TYPE_OPEN + value + LISP_CLOSE, "Lisp type"),
                                          ("lisp", value, "Lisp document"),
                                          ("normal", value, "source document")]))
    if candidates:
        requests = [(surface, wrap) for c in candidates for surface, wrap, _ in c["wraps"]]
        facts = chain_separators(requests)
        for index, c in enumerate(candidates):
            found = []
            parsed_clean = False
            for wrap_index, ((surface, wrap, label), prefix) in enumerate(zip(
                    c["wraps"], (WRAP_OPEN, TAIL_OPEN, LISP_OPEN, TYPE_OPEN, "", ""))):
                fact = facts[len(c["wraps"]) * index + wrap_index]
                parsed_clean = parsed_clean or not fact["diagnostics"]
                for i in fact["offsets"]:
                    local = char_index(wrap, i) - len(prefix)
                    if 0 <= local < len(c["value"]):
                        found.append((local, label))
            if not found:
                if parsed_clean:
                    # The parser read it (as an expression, a tail or a Lisp
                    # type) and found no chain node: it is not chain text.
                    unaccounted.append(dict(family="no-chain", path=c["path"], line=c["line"],
                                            status="no_chain", literal_line=c["line"],
                                            reason="chain-shaped characters, but the parser reports no chain "
                                                   "node in an expression, tail or Lisp-type context"))
                elif looks_like_branch(c["value"]):
                    unaccounted.append(dict(family="rust-unproven", path=c["path"], line=c["line"],
                                            status="needs_human", literal_line=c["line"],
                                            excerpt=c["value"].strip().splitlines()[0][:100],
                                            reason="chain-shaped text outside the owner's snippet gate that no "
                                                   "wrapper proves: a fragment, an expectation or a hint that a "
                                                   "human must move with the source it belongs to"))
                continue
            for local, label in sorted(set(found)):
                fragments.append(dict(path=c["path"], char=c["body"].origin[local][1],
                                      parent=label, literal_line=c["line"]))
    unique = {}
    for fragment in fragments:
        unique.setdefault((fragment["path"], fragment["char"]), fragment)
    fragments = list(unique.values())
    for fragment in fragments:
        host = hosts.setdefault(fragment["path"], read(fragment["path"]))
        offset = byte_offset(host, fragment["char"])
        if host[fragment["char"]] != "|":
            fragment["status"] = "needs_human"
            fragment["reason"] = "copied character is not `|` in the host"
            continue
        edits.setdefault(fragment["path"], set()).add(offset)
        fragment["offset"] = offset
    return edits, fragments, unaccounted


def looks_like_branch(value):
    """For the report only: text after a `|` that starts a function literal.
    This decides no byte; the parser's chain nodes decide every byte."""
    for i, c in enumerate(value):
        if c != "|":
            continue
        after = i + 1
        while after < len(value) and value[after].isspace():
            after += 1
        if after < len(value) and value[after] in "(<":
            return True
    return False


def line_col(path, offset):
    text = (ROOT / path).read_bytes()
    return text.count(b"\n", 0, offset) + 1, offset - text.rfind(b"\n", 0, offset)


def report(assemblies, listed, fragments, unaccounted, edits, mode, manifest_path):
    summary = {}
    records = []
    hosts = {}
    for a in assemblies:
        summary.setdefault(a.family, {}).setdefault(a.status, 0)
        summary[a.family][a.status] += 1
        record = dict(family=a.family, path=a.path, line=a.line, identity=a.identity, surface=a.surface,
                      status=a.status, reason=a.reason, diagnostics=a.diagnostics, ast=a.ast,
                      separators_reported=len(a.separators), migrated=len(a.migrated))
        if a.chain_shaped:
            record["chain_shaped"] = True
        if a.migrated:
            record["separators"] = []
            for i in a.migrated:
                path, char = a.text.origin[i]
                offset = byte_offset(hosts.setdefault(path, read(path)), char)
                line, column = line_col(path, offset)
                record["separators"].append(dict(file=path, offset=offset, line=line, column=column,
                                                 assembled_offset=i))
        records.append(record)
    for fragment in fragments:
        summary.setdefault("copied-text", {}).setdefault("migrated_coupled", 0)
        summary["copied-text"]["migrated_coupled"] += 1
        record = dict(family="copied-text", path=fragment["path"], status="migrated_coupled",
                      reason=("verbatim copy of part of " + fragment["parent"] + "; the same character moves with it"))
        if "offset" in fragment:
            line, column = line_col(fragment["path"], fragment["offset"])
            record["separators"] = [dict(file=fragment["path"], offset=fragment["offset"], line=line,
                                         column=column, literal_line=fragment["literal_line"])]
        records.append(record)
    for item in unaccounted:
        family = item.pop("family")
        summary.setdefault(family, {}).setdefault(item["status"], 0)
        summary[family][item["status"]] += 1
        records.append(item)
    records.extend(listed)

    if manifest_path:
        Path(manifest_path).write_text(json.dumps(dict(mode=mode, separator_driver=str(separator_driver()),
                                                       summary=summary, sources=records), indent=1) + "\n")

    for family in sorted(summary):
        counts = ", ".join(f"{status} {summary[family][status]}" for status in sorted(summary[family]))
        print(f"{family}: {counts}")
    if listed:
        extra = {}
        for item in listed:
            extra[item["status"]] = extra.get(item["status"], 0) + 1
        print("listed: " + ", ".join(f"{k} {v}" for k, v in sorted(extra.items())))
    total = sum(len(v) for v in edits.values())
    print(f"{mode}: {total} separator(s) in {len(edits)} file(s); "
          "proof: each one is a byte the parser's chain node reported, and the byte diff set equals this set")
    for path in sorted(edits):
        for offset in sorted(edits[path]):
            line, column = line_col(path, offset)
            print(f"  {path}:{line}:{column} `|` -> `&`")
    return total


def verify_extraction():
    """The readers here must agree with the owner readers, byte for byte."""
    problems = 0
    for path in tracked("*.rs"):
        text = read(path)
        mine = [(s, e, v) for s, e, v, _ in rust_strings(text, path)]
        owner = [(s, e, v) for s, e, v in checker.rust_strings(text)]
        if mine != owner:
            print(f"rust reader differs: {path}")
            problems += 1
    for path in tracked("*.md", "*.mdx"):
        text = read(path)
        mine = [(i, str(s), l, c) for i, s, l, c in fence_blocks(text, path)]
        owner = [(f.info, f.source, f.line, f.closed) for f in fences_owner.fences(text)]
        if mine != owner:
            print(f"fence reader differs: {path}")
            problems += 1
    for file in (REGISTRY, DOCS_REGISTRY):
        raw = read(file.relative_to(ROOT))
        rel = str(file.relative_to(ROOT))
        mine = {where: str(value) for where, value in json_strings(raw, rel)}
        flat = {}

        def flatten(value, where):
            if isinstance(value, str):
                flat[where] = value
            elif isinstance(value, list):
                for index, item in enumerate(value):
                    flatten(item, where + (index,))
            elif isinstance(value, dict):
                for key, item in value.items():
                    flatten(item, where + (key,))

        flatten(json.loads(raw), ())
        flat.pop(("_syn2_old_forms",), None)
        if mine != flat:
            print(f"json reader differs: {rel}")
            problems += 1
    print(f"verify-extraction: {'ok' if not problems else str(problems) + ' difference(s)'}")
    return problems


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--dry-run", action="store_true", help="report only (default)")
    mode.add_argument("--write", action="store_true", help="rewrite the reported separators")
    mode.add_argument("--check", action="store_true", help="exit 1 while a separator is still rewritable")
    parser.add_argument("--manifest", metavar="PATH", help="write the full per-source report as JSON")
    parser.add_argument("--include-design", action="store_true",
                        help="also migrate fences in docs/design (design notes are listed, not rewritten)")
    parser.add_argument("--verify-extraction", action="store_true",
                        help="check the readers here against the owner readers and exit")
    args = parser.parse_args()

    if args.verify_extraction:
        raise SystemExit(verify_extraction())
    if not separator_driver().is_file():
        raise SystemExit(f"separator driver not found: {separator_driver()} (set I_CHAIN_SEPARATORS)")

    registry, docs_registry = load_registries()
    assemblies, listed = extract(registry, docs_registry, args.include_design)
    edits, fragments, unaccounted = classify(assemblies)
    mode_name = "write" if args.write else "check" if args.check else "dry-run"
    if args.write:
        for path, offsets in sorted(edits.items()):
            host = bytearray((ROOT / path).read_bytes())
            for offset in offsets:
                assert host[offset:offset + 1] == b"|", (path, offset)
                host[offset] = ord("&")
            (ROOT / path).write_bytes(bytes(host))
    total = report(assemblies, listed, fragments, unaccounted, edits, mode_name, args.manifest)
    if args.check and total:
        raise SystemExit(1)


if __name__ == "__main__":
    main()
