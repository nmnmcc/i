#!/usr/bin/env python3
"""Rewrite a bracketless zero-payload constructor use into a call, in i source
that is not a whole .i/.is file.

`True` becomes `True()` in the normal surface and `(True)` in the Lisp surface
(`(. m C)` becomes `((. m C))`), in value and in pattern position. Types are
never touched. This is scripts/constructor-call-migrate for embedded sources:
Markdown/MDX fences, i source inside Rust string literals, and the i source
the snippet registries hold (prefixes, suffixes and substitution
replacements in scripts/check-snippets.json and docs/scripts/examples.json).

Each source is assembled exactly the way its owner assembles it --
scripts/check-snippets with scripts/check-snippets.json, docs/scripts/
check-examples.py with docs/scripts/examples.json and docs/scripts/
example_fences.py -- and every assembled character keeps its origin (host
file, character offset). The assembled text goes to the parser helper
crates/ilang-syntax/examples/constructor-sites, which reports the
constructor uses (`SITE`) and the constructors the source defines
(`ZERO`/`CTOR`). Only those sites, mapped back through the origin map onto the
exact written name in the host, are rewritten. No character shape decides a
byte.

Protocol (the helper's): a request `<normal|lisp> #<len>` followed by exactly
`<len>` bytes, or `<normal|lisp> <path>`; per request `FILE <path>` or
`SNIPPET <n>`, `IMPORT <hex alias> <hex path>`, `ZERO <name>`,
`CTOR <name> <fields>`, `SITE <value|pattern> <start> <end> <hex name>`,
`DIAG <code> <hex message>`, `END`, or a single `FAIL ...`. Offsets are bytes;
a qualified name covers the whole written form (`m.C`, `(. m C)`).

A name resolves, per assembled source, through: the source's own `ZERO`/
`CTOR` definitions, then the shipped prelude (`--prelude`, default
`<root>/lib/prelude.i`), then `True`/`False`. The first table that knows the
name decides; zero fields is rewritten, a payload is left alone, both arities
is `ambiguous` (reported, never rewritten), and a name in no table (and every
qualified name: module tables are not consulted for embedded sources) is
`unknown` (reported, not rewritten). A source the parser reports any `DIAG`
for is never rewritten.

Before anything is written the result is proved: the new host texts are
re-extracted and re-assembled by the same owner rules (registry keys moved to
the new snippet hash, a same-length change), every assembled source must equal
the old one with exactly the planned brackets inserted, and the migrated
sources must parse without a diagnostic and have no rewritable site left.
A failed proof writes nothing (exit 2).

Every considered source lands in one class: migrated, clean, unparsed,
needs a human (with the reason), or not i source; design notes and runner
fixtures are listed, not rewritten. Rust strings outside the owner's snippet
gate and inline code in Markdown prose that the parser reads as i with a
zero-payload use are listed as needing a human; they are never rewritten.

Modes: --dry-run (default), --write, --check (exit 1 while a rewritable site
remains; after --write it exits 0 and a second --write changes nothing).
--verify-extraction checks the readers here against the owner readers.

Options:
  --root PATH       the repository root (default: `git rev-parse --show-toplevel`)
  --parser PATH     the constructor-sites example ($CONSTRUCTOR_SITES_PARSER;
                    default `<root>/target/debug/examples/constructor-sites`)
  --prelude PATH    the prelude source (default `<root>/lib/prelude.i`)
  --manifest PATH   the per-source report with the unparsed, unknown,
                    ambiguous and needs-a-human lists (written on --write to
                    `<root>/constructor-call-embedded.json` by default, and in
                    every mode when given)
  --include-design  also migrate fences in docs/design
  --quiet           only the totals and the problems
"""
import argparse
import hashlib
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import subprocess
import sys

PROG = "constructor-call-migrate-embedded"
ROOT = None
REGISTRY = "scripts/check-snippets.json"
DOCS_REGISTRY = "docs/scripts/examples.json"
SPEC_PATH = "docs/spec.md"
# Markdown owned by the example-runner fixtures; it is test input, not docs.
OWNER_SKIPPED = ("docs/scripts/run-examples-fixtures/",)
BUILTIN_ZERO = ("True", "False")
# Wrappers for the report-only probes of text the owners do not extract.
PROBES = (("normal", "m = () {\n", "\n}\n", "block expression"),
          ("normal", "", "", "source document"),
          ("lisp", "(= m ", ")\n", "Lisp expression"),
          ("lisp", "", "", "Lisp document"))

checker = fences_owner = None
# path -> text: the host texts as they will be after the rewrite, during the proof.
OVERLAY = {}


def owner_modules():
    """Load the owner extractors instead of restating their rules."""
    loader = importlib.machinery.SourceFileLoader("repo_snippets", str(ROOT / "scripts/check-snippets"))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    snippets = importlib.util.module_from_spec(spec)
    loader.exec_module(snippets)
    sys.path.insert(0, str(ROOT / "docs/scripts"))
    fences_loader = importlib.machinery.SourceFileLoader("owner_fences", str(ROOT / "docs/scripts/example_fences.py"))
    fences_spec = importlib.util.spec_from_loader(fences_loader.name, fences_loader)
    fences = importlib.util.module_from_spec(fences_spec)
    fences_loader.exec_module(fences)
    sys.path.pop(0)
    return snippets, fences


# --------------------------------------------------------------------------
# Text with an origin for every character: (file, character offset) or None.
# The offset is a character offset in the decoded host file.
# --------------------------------------------------------------------------
class Text:
    __slots__ = ("chars", "origin")

    def __init__(self, chars=None, origin=None):
        self.chars = list(chars or "")
        self.origin = list(origin or [])

    def __str__(self):
        return "".join(self.chars)

    def __len__(self):
        return len(self.chars)

    def add(self, text, origin):
        assert len(text) == len(origin), (text, len(origin))
        self.chars.extend(text)
        self.origin.extend(origin)
        return self

    def extend(self, other):
        return self.add(str(other), other.origin)

    def replace_all(self, old, new, new_origin):
        """The owner's textual substitution (str.replace), keeping every origin."""
        text = str(self)
        out = Text()
        at = 0
        if not old:
            raise KeyError("empty substitution pattern")
        while True:
            hit = text.find(old, at)
            if hit < 0:
                break
            out.add(text[at:hit], self.origin[at:hit])
            out.add(new, new_origin)
            at = hit + len(old)
        out.add(text[at:], self.origin[at:])
        return out


def char_index(text, byte):
    """The character index of a byte offset in UTF-8 `text`."""
    return len(text.encode("utf-8")[:byte].decode("utf-8"))


def plain(text, path, base=0):
    return Text(text, [(path, base + i) for i in range(len(text))])


# --------------------------------------------------------------------------
# Host readers. They mirror the owner readers and add origins; nothing else.
# --------------------------------------------------------------------------
RAW = re.compile(r'r(#+)?"')
CHAR = re.compile(r"'(?:\\(?:[nrt0\\'\"]|x[0-9a-fA-F]{2}|u\{[0-9a-fA-F_]+\})|[^'\\])'")


def rust_strings(text, path):
    """scripts/check-snippets.rust_strings with origins; see --verify-extraction."""
    i = 0
    while i < len(text):
        if text.startswith("//", i):
            end = text.find("\n", i)
            i = len(text) if end < 0 else end
            continue
        if text.startswith("/*", i):
            depth = 1
            i += 2
            while depth and i < len(text):
                if text.startswith("/*", i):
                    depth += 1
                    i += 2
                elif text.startswith("*/", i):
                    depth -= 1
                    i += 2
                else:
                    i += 1
            continue
        raw = RAW.match(text, i)
        if raw:
            start = i
            hashes = raw[1] or ""
            i = raw.end()
            end = text.index('"' + hashes, i)
            body = text[i:end]
            yield start, end + 1 + len(hashes), body, plain(body, path, i)
            i = end + 1 + len(hashes)
            continue
        if text[i] == '"':
            start = i
            i += 1
            value = Text()
            while i < len(text) and text[i] != '"':
                c = text[i]
                if c != "\\":
                    value.add(c, [(path, i)])
                    i += 1
                    continue
                escape = i
                i += 1
                c = text[i]
                i += 1
                # An escaped character has no host character of its own: its
                # origin is the backslash, which no written name can match.
                if c in "\n\r":
                    while i < len(text) and text[i].isspace():
                        i += 1
                elif c in "nrt0":
                    value.add(dict(n="\n", r="\r", t="\t", **{"0": "\0"})[c], [(path, escape)])
                elif c in "\\\"'":
                    value.add(c, [(path, escape)])
                elif c == "x":
                    value.add(chr(int(text[i:i + 2], 16)), [(path, escape)])
                    i += 2
                elif c == "u":
                    end = text.index("}", i)
                    value.add(chr(int(text[i + 1:end].replace("_", ""), 16)), [(path, escape)])
                    i = end + 1
                else:
                    raise ValueError((start, c))
            yield start, i + 1, str(value), value
            i += 1
            continue
        if text[i] == "'":
            char = CHAR.match(text, i)
            if char:
                i = char.end()
                continue
        i += 1


def json_strings(text, path):
    """Every JSON string value with its key path and decoded origin."""
    collected = []

    def string_at(i):
        assert text[i] == '"', (path, i)
        i += 1
        value = Text()
        while text[i] != '"':
            c = text[i]
            if c != "\\":
                value.add(c, [(path, i)])
                i += 1
                continue
            escape = i
            i += 1
            c = text[i]
            i += 1
            unescape = {"n": "\n", "r": "\r", "t": "\t", "b": "\b", "f": "\f"}
            if c in unescape:
                value.add(unescape[c], [(path, escape)])
            elif c == "u":
                unit = int(text[i:i + 4], 16)
                i += 4
                if 0xD800 <= unit <= 0xDBFF and text[i:i + 2] == "\\u":
                    low = int(text[i + 2:i + 6], 16)
                    if 0xDC00 <= low <= 0xDFFF:
                        unit = 0x10000 + ((unit - 0xD800) << 10) + (low - 0xDC00)
                        i += 6
                value.add(chr(unit), [(path, escape)])
            else:
                value.add(c, [(path, escape)])
        return value, i + 1

    def scalar(i):
        match = re.compile(r"-?[0-9][0-9.eE+-]*|true|false|null").match(text, i)
        assert match, (path, i, text[i:i + 30])
        return match.end()

    def walk(i, where):
        while text[i].isspace():
            i += 1
        if text[i] == '"':
            value, end = string_at(i)
            collected.append((where, value))
            return end
        if text[i] == "[":
            i += 1
            index = 0
            while True:
                while text[i].isspace():
                    i += 1
                if text[i] == "]":
                    return i + 1
                i = walk(i, where + (index,))
                index += 1
                while text[i].isspace():
                    i += 1
                if text[i] == ",":
                    i += 1
        if text[i] == "{":
            i += 1
            while True:
                while text[i].isspace():
                    i += 1
                if text[i] == "}":
                    return i + 1
                key, i = string_at(i)
                key = str(key)
                while text[i].isspace():
                    i += 1
                assert text[i] == ":", (path, i)
                i += 1
                i = walk(i, where + (key,))
                while text[i].isspace():
                    i += 1
                if text[i] == ",":
                    i += 1
        return scalar(i)

    walk(0, ())
    yield from collected


def fence_blocks(text, path):
    """docs/scripts/example_fences.fences with origins; see --verify-extraction."""
    lines = text.splitlines(keepends=True)
    offsets = []
    at = 0
    for line in lines:
        offsets.append(at)
        at += len(line)
    index = 0
    while index < len(lines):
        opening = re.fullmatch(r'( {0,3})(`{3,}|~{3,})([^\n]*)\n?', lines[index])
        if not opening or (opening[2][0] == '`' and '`' in opening[3]):
            index += 1
            continue
        start = index
        index += 1
        source = Text()
        closing = re.compile(r' {0,3}' + re.escape(opening[2][0])
                             + '{' + str(len(opening[2])) + r',}[ \t]*\n?')
        while index < len(lines) and not closing.fullmatch(lines[index]):
            line = lines[index]
            spaces = len(line) - len(line.lstrip(' '))
            cut = min(spaces, len(opening[1]))
            body = line[cut:]
            source.add(body, [(path, offsets[index] + cut + k) for k in range(len(body))])
            index += 1
        yield opening[3].strip(), source, start + 1, index < len(lines)
        index += 1


def prose_code(text, path):
    """Inline code spans of the Markdown prose (outside every fence), for the
    report-only probe. Yields (line, span text, character offset)."""
    fenced = set()
    lines = text.splitlines(keepends=True)
    index = 0
    while index < len(lines):
        opening = re.fullmatch(r'( {0,3})(`{3,}|~{3,})([^\n]*)\n?', lines[index])
        if not opening or (opening[2][0] == '`' and '`' in opening[3]):
            index += 1
            continue
        closing = re.compile(r' {0,3}' + re.escape(opening[2][0])
                             + '{' + str(len(opening[2])) + r',}[ \t]*\n?')
        fenced.add(index)
        index += 1
        while index < len(lines) and not closing.fullmatch(lines[index]):
            fenced.add(index)
            index += 1
        fenced.add(index)
        index += 1
    at = 0
    for number, line in enumerate(lines):
        if number not in fenced:
            for match in re.finditer(r"(?<!`)(`+)(?!`)(.+?)(?<!`)\1(?!`)", line):
                yield number + 1, match[2], at + match.start(2)
        at += len(line)


# --------------------------------------------------------------------------
# Registries and host files.
# --------------------------------------------------------------------------
REGISTRY_TEXTS = {}


def read(path):
    """The host file as text with no newline translation."""
    if path in OVERLAY:
        return OVERLAY[path]
    return (ROOT / path).read_bytes().decode("utf-8")


def load_registries():
    entries = json.loads(read(REGISTRY))
    entries.pop("_syn2_old_forms", None)
    local = json.loads(read(DOCS_REGISTRY))
    REGISTRY_TEXTS.clear()
    for rel in (REGISTRY, DOCS_REGISTRY):
        REGISTRY_TEXTS[rel] = {where: value for where, value in json_strings(read(rel), rel)}
    return entries, local


def registry_text(rel, entry_key, field):
    where = (entry_key,) + field
    if where not in REGISTRY_TEXTS[rel]:
        raise KeyError(f"{rel}: no string at {where}")
    return REGISTRY_TEXTS[rel][where]


def tracked(*patterns):
    out = subprocess.check_output(
        ["git", "ls-files", "--cached", "--others", "--exclude-standard", "--", *patterns],
        cwd=ROOT, text=True).splitlines()
    return sorted(path for path in set(out) if (ROOT / path).is_file())


# --------------------------------------------------------------------------
# Assemblies.
# --------------------------------------------------------------------------
class Assembly:
    def __init__(self, family, path, line, identity, surface, text, entry, registry, ordinal, body):
        self.family = family
        self.path = path
        self.line = line
        self.identity = identity
        self.surface = surface
        self.text = text
        self.entry = entry
        self.registry = registry      # the registry file that holds the entry, if any
        self.ordinal = ordinal        # position among the host's extracted strings/fences
        self.body = body              # the host snippet (before prefix/suffix)
        self.diagnostics = []
        self.sites = []               # (kind, start, end, name), assembled bytes
        self.rewrite = []             # (kind, start char, end char, name, host edits)
        self.unknown = []
        self.ambiguous = []
        self.payload = 0
        self.status = None
        self.reason = ""
        self.would_rewrite = 0        # for not-i-source literals: sites a migration would touch

    @property
    def source(self):
        return str(self.text)

    def key(self):
        return (self.family, self.path, self.ordinal)


def assemble(family, path, line, identity, surface, body, entry, registry, ordinal):
    """prefix + snippet + suffix, then the registry's substitutions, exactly as
    scripts/check-snippets and docs/scripts/check-examples.py do."""
    text = Text()
    if entry.get("prefix"):
        text.extend(registry_text(registry, identity, ("prefix",)))
    text.extend(body)
    if entry.get("suffix"):
        text.extend(registry_text(registry, identity, ("suffix",)))
    for index, pair in enumerate(entry.get("substitutions", []) or []):
        old, new = pair
        replacement = registry_text(registry, identity, ("substitutions", index, 1))
        text = text.replace_all(old, str(replacement), replacement.origin)
    return Assembly(family, path, line, identity, surface, text, entry, registry, ordinal, body)


def which_registry(identity, registry, docs_registry):
    if identity in registry:
        return REGISTRY
    if identity in docs_registry:
        return DOCS_REGISTRY
    return None


def markdown_paths():
    return tracked("*.md", "*.mdx")


def rust_paths():
    return [path for path in tracked("*.rs") if path.startswith("crates/")]


def fence_identity_path(path):
    return SPEC_PATH if "/standard/generated/" in path else path


def extract(registry, docs_registry, include_design):
    """Every embedded source this tool owns, as its owner sees it, plus the
    sources it deliberately leaves alone (listed, with the reason)."""
    assemblies, listed = [], []

    for path in markdown_paths():
        if path.startswith(OWNER_SKIPPED):
            listed.append(dict(family="markdown", path=path, line=0, status="owner_skipped",
                               reason="example-runner fixture Markdown: test input, not documentation"))
            continue
        text = read(path)
        for ordinal, (info, body, line, closed) in enumerate(fence_blocks(text, path)):
            try:
                parsed = fences_owner.i_info(info)
            except ValueError as error:
                listed.append(dict(family="markdown", path=path, line=line, status="needs_human",
                                   reason="owner rejects the fence info string: " + str(error)))
                continue
            if parsed is None:
                continue
            kind, filename, codes = parsed
            if filename and Path(filename).suffix not in (".i", ".is"):
                continue  # toml/text project inputs, not i source
            if not closed:
                listed.append(dict(family="markdown", path=path, line=line, status="needs_human",
                                   reason="unclosed i fence"))
                continue
            surface = "lisp" if filename and filename.endswith(".is") else "normal"
            identity = checker.identity(fence_identity_path(path), str(body))
            if path.startswith("docs/design/") and not include_design:
                listed.append(dict(family="design_note", path=path, line=line, status="design_note",
                                   identity=identity,
                                   reason="docs/design is a design note, not a current doc; listed, not rewritten"))
                continue
            entry = registry.get(identity) or docs_registry.get(identity) or {}
            try:
                assemblies.append(assemble("markdown", path, line, identity, surface, body, entry,
                                           which_registry(identity, registry, docs_registry), ordinal))
            except KeyError as error:
                listed.append(dict(family="markdown", path=path, line=line, status="unassembled",
                                   identity=identity, reason=str(error)))

    for path in rust_paths():
        text = read(path)
        for ordinal, (start, end, value, body) in enumerate(rust_strings(text, path)):
            identity = checker.identity(path, value)
            registered = identity in registry or identity in docs_registry
            if not (registered or checker.candidate(value) or re.match(r"\s*(?:import|export|case)\b", value)):
                continue
            entry = registry.get(identity) or docs_registry.get(identity) or {}
            line = text.count("\n", 0, start) + 1
            try:
                assemblies.append(assemble("rust", path, line, identity, "normal", body, entry,
                                           which_registry(identity, registry, docs_registry), ordinal))
            except KeyError as error:
                listed.append(dict(family="rust", path=path, line=line, status="unassembled",
                                   identity=identity, reason=str(error)))

    return assemblies, listed


# --------------------------------------------------------------------------
# The parser interface.
# --------------------------------------------------------------------------
PARSER = None


def constructor_sites(requests):
    """Parser facts for each (surface, source) request, in order."""
    if not requests:
        return []
    data = bytearray()
    for surface, source in requests:
        encoded = source.encode("utf-8", "surrogatepass")
        data += f"{surface} #{len(encoded)}\n".encode() + encoded
    result = subprocess.run([str(PARSER)], input=bytes(data), capture_output=True)
    if result.returncode != 0:
        sys.stderr.write(result.stderr.decode("utf-8", "replace"))
        raise SystemExit(f"{PROG}: {PARSER} exited {result.returncode}")
    return parse_report(result.stdout.decode("utf-8", "surrogateescape"), len(requests))


def parse_report(text, expected):
    results = []
    current = None
    for line in text.splitlines():
        if line.startswith(("SNIPPET ", "FILE ")):
            current = dict(imports={}, zero=[], ctors=[], sites=[], diags=[], bad=[])
            results.append(current)
        elif line.startswith("FAIL "):
            results.append(dict(imports={}, zero=[], ctors=[], sites=[], diags=[],
                                bad=["FAIL " + line[5:]]))
            current = None
        elif line == "END":
            current = None
        elif current is None:
            if line.strip():
                raise SystemExit(f"{PROG}: stray parser line: {line}")
        elif line.startswith("IMPORT "):
            parts = line[7:].split(" ")
            if len(parts) != 2:
                current["bad"].append(line)
                continue
            alias, path = (bytes.fromhex(x).decode("utf-8", "replace") for x in parts)
            current["imports"][alias] = path
        elif line.startswith("ZERO "):
            current["zero"].append(line[5:])
        elif line.startswith("CTOR "):
            name, _, count = line[5:].rpartition(" ")
            current["ctors"].append((name, int(count)))
        elif line.startswith("SITE "):
            parts = line[5:].split(" ")
            if len(parts) != 4:
                current["bad"].append(line)
                continue
            kind, start, end, hexname = parts
            current["sites"].append((kind, int(start), int(end),
                                     bytes.fromhex(hexname).decode("utf-8", "replace")))
        elif line.startswith("DIAG "):
            code, _, hexmessage = line[5:].partition(" ")
            try:
                message = bytes.fromhex(hexmessage).decode("utf-8", "replace")
            except ValueError:
                message = hexmessage
            current["diags"].append(code + ": " + message)
        else:
            # A line this script does not understand: the source is treated
            # as unparsed rather than guessed at.
            current["bad"].append(line)
    if len(results) != expected:
        raise SystemExit(f"{PROG}: the parser returned {len(results)} groups for {expected} requests")
    return results


def arities(fact):
    table = {}
    for name in fact["zero"]:
        table.setdefault(name, set()).add(0)
    for name, count in fact["ctors"]:
        table.setdefault(name, set()).add(count)
    return table


def load_prelude(path):
    if path is None or not os.path.isfile(path):
        sys.stderr.write(f"{PROG}: no prelude at {path}; only True/False are built in\n")
        return {}
    text = Path(path).read_bytes().decode("utf-8")
    fact = constructor_sites([("normal", text)])[0]
    if fact["diags"] or fact["bad"]:
        sys.stderr.write(f"{PROG}: the prelude {path} does not parse; it gives no table\n")
        return {}
    return arities(fact)


def resolve(name, tables):
    """`("zero"|"payload"|"ambiguous"|"unknown", detail)`."""
    if "." in name:
        return ("unknown", "qualified name: module tables are not consulted for embedded sources")
    for where, table in tables:
        counts = table.get(name)
        if counts:
            if 0 in counts and any(c != 0 for c in counts):
                return ("ambiguous", f"{where} arities {sorted(counts)}")
            return ("zero" if 0 in counts else "payload", where)
    if name in BUILTIN_ZERO:
        return ("zero", "builtin")
    return ("unknown", "no definition in the source, the prelude or the builtins")


def written_problem(source, surface, start, end, name):
    """Why the assembled bytes at a site are not the written name the parser
    reported (or already have brackets), or None."""
    data = source.encode("utf-8", "surrogatepass")
    if not (0 <= start < end <= len(data)):
        return f"offsets {start}..{end} are outside the source"
    module, dot, base = name.rpartition(".")
    written = data[start:end]
    if dot and surface == "lisp":
        form = re.compile(rb"\(\.\s+" + re.escape(module.encode()) + rb"\s+" + re.escape(base.encode()) + rb"\s*\)\Z")
        if not form.match(written):
            return f"bytes {start}..{end} hold {written!r}, not {name!r}"
    elif written != name.encode():
        return f"bytes {start}..{end} hold {written!r}, not {name!r}"
    if surface == "normal" and data[end:end + 1] == b"(":
        return "already followed by `(`"
    if surface == "lisp" and data[start - 1:start] == b"(" and data[end:end + 1] == b")":
        return f"already written `({name})`"
    return None


def host_edits(a, surface, cs, ce):
    """The host insertions for a site at assembled characters cs..ce, or a
    reason it has no faithful host form. The written name must be the very
    characters of one host file, in order."""
    origins = a.text.origin[cs:ce]
    if any(o is None for o in origins):
        return None, "the name comes from text with no host character"
    path, first = origins[0]
    if any(o != (path, first + k) for k, o in enumerate(origins)):
        return None, "the written name is not one contiguous run of host characters"
    host = read(path)
    if host[first:first + (ce - cs)] != a.source[cs:ce]:
        return None, f"the host characters at {path}:{first} are not the written name"
    after = first + (ce - cs)
    if surface == "normal":
        return [(path, after, "()")], None
    return [(path, first, "("), (path, after, ")")], None


def classify(assemblies, prelude):
    facts = constructor_sites([(a.surface, a.source) for a in assemblies])
    for a, fact in zip(assemblies, facts):
        a.diagnostics = fact["diags"] + fact["bad"]
        a.sites = fact["sites"]
        tables = [("source", arities(fact)), ("prelude", prelude)]
        planned, problems = [], []
        for kind, start, end, name in a.sites:
            verdict, detail = resolve(name, tables)
            if verdict == "payload":
                a.payload += 1
                continue
            if verdict == "ambiguous":
                a.ambiguous.append((name, start, detail))
                continue
            if verdict == "unknown":
                a.unknown.append((name, start, detail))
                continue
            problem = written_problem(a.source, a.surface, start, end, name)
            if problem is None:
                cs, ce = char_index(a.source, start), char_index(a.source, end)
                edits, problem = host_edits(a, a.surface, cs, ce)
            if problem is not None:
                problems.append(f"{name} at {start}: {problem}")
                continue
            planned.append((kind, cs, ce, name, edits))
        if a.entry.get("not_source"):
            a.status = "not_source"
            a.reason = "owner registry marks this literal not i source: " + a.entry.get("reason", "")
            a.would_rewrite = len(planned) if not a.diagnostics else 0
            if a.would_rewrite:
                a.reason += (f" [{a.would_rewrite} zero-payload use(s) as i: keep it in step with the source"
                             " it belongs to]")
        elif a.diagnostics:
            a.status = "unparsed"
            a.reason = a.diagnostics[0] + ("" if len(a.diagnostics) == 1
                                           else f" (and {len(a.diagnostics) - 1} more)")
        elif problems:
            a.status = "needs_human"
            a.reason = "a reported site has no faithful host form: " + "; ".join(problems)
        else:
            a.rewrite = planned
            if a.ambiguous:
                a.status = "needs_human"
                a.reason = ("ambiguous constructor(s) " + ", ".join(sorted({n for n, *_ in a.ambiguous}))
                            + f"; {len(planned)} other site(s) rewritten")
            elif planned:
                a.status = "migrated"
                a.reason = f"{len(planned)} zero-payload use(s) reported by the parser"
            else:
                a.status = "clean"
    edits = {}
    for a in assemblies:
        for *_, host in a.rewrite:
            for path, at, text in host:
                edits.setdefault(path, set()).add((at, text))
    return edits


def apply_text(text, inserts):
    """Insert from the end so earlier positions stay valid. At one position a
    `)` (an earlier site's end) lands before a `(` (a later site's start)."""
    order = sorted(inserts, key=lambda item: (item[0], item[1] == "("))
    out = text
    for at, piece in reversed(order):
        out = out[:at] + piece + out[at:]
    return out


def expected_source(a):
    inserts = []
    for kind, cs, ce, name, _ in a.rewrite:
        if a.surface == "normal":
            inserts.append((ce, "()"))
        else:
            inserts.append((cs, "("))
            inserts.append((ce, ")"))
    return apply_text(a.source, inserts)


# --------------------------------------------------------------------------
# Probes of text the owners do not extract (report only).
# --------------------------------------------------------------------------
def probe(texts, names):
    """For each text that mentions a zero-payload name as a word, parse it in
    the probe wrappers; return {index: (wrapper label, sites)} for the texts the
    parser reads cleanly with a zero-payload use inside the text."""
    word = re.compile(r"(?<![\w.])(?:" + "|".join(map(re.escape, sorted(names))) + r")(?!\w)")
    chosen = [index for index, text in enumerate(texts) if word.search(text)]
    requests = [(surface, open_ + texts[index] + close) for index in chosen
                for surface, open_, close, _ in PROBES]
    facts = constructor_sites(requests)
    found = {}
    for n, index in enumerate(chosen):
        for w, (surface, open_, close, label) in enumerate(PROBES):
            fact = facts[n * len(PROBES) + w]
            if fact["diags"] or fact["bad"]:
                continue
            table = arities(fact)
            low, high = len(open_.encode()), len(open_.encode()) + len(texts[index].encode())
            hits = [name for _, start, end, name in fact["sites"]
                    if low <= start and end <= high and "." not in name
                    and (table.get(name) == {0} or (not table.get(name) and name in names))]
            if hits:
                found[index] = (label, hits)
                break
    return found


def probes(assemblies, names):
    extracted = {(a.family, a.path, a.ordinal) for a in assemblies}
    items = []
    for path in rust_paths():
        text = read(path)
        for ordinal, (start, end, value, body) in enumerate(rust_strings(text, path)):
            if ("rust", path, ordinal) in extracted:
                continue
            items.append(dict(family="rust-fragment", path=path, line=text.count("\n", 0, start) + 1,
                              text=value))
    for path in markdown_paths():
        if path.startswith(OWNER_SKIPPED) or (path.startswith("docs/design/")):
            continue
        for line, span, at in prose_code(read(path), path):
            items.append(dict(family="prose", path=path, line=line, text=span))
    found = probe([item["text"] for item in items], names)
    merged = {}
    for index, (label, hits) in sorted(found.items()):
        item = items[index]
        group = merged.setdefault((item["family"], item["path"], item["line"]),
                                  dict(labels=set(), names=set(), excerpts=[]))
        group["labels"].add(label)
        group["names"].update(hits)
        group["excerpts"].append(item["text"].strip().splitlines()[0][:100] if item["text"].strip() else "")
    out = []
    for (family, path, line), group in merged.items():
        label = " / ".join(sorted(group["labels"]))
        reason = ("Rust string outside the owner's snippet gate that the parser reads as a " + label
                  if family == "rust-fragment" else
                  "inline code in Markdown prose that the parser reads as a " + label)
        out.append(dict(family=family, path=path, line=line, status="needs_human",
                        excerpts=group["excerpts"], names=sorted(group["names"]),
                        reason=reason + " with zero-payload use(s) " + ", ".join(sorted(group["names"]))
                        + "; not extracted as source, so not rewritten"))
    return out


# --------------------------------------------------------------------------
# The proof and the rewrite.
# --------------------------------------------------------------------------
def raw_snippets(path, text):
    """(identity path, raw snippet) of every string/fence of a host, in order."""
    if path.endswith((".md", ".mdx")):
        return [str(body) for _, body, _, _ in fence_blocks(text, path)]
    if path.endswith(".rs"):
        return [value for _, _, value, _ in rust_strings(text, path)]
    return None


def identity_path(path):
    return fence_identity_path(path) if path.endswith((".md", ".mdx")) else path


def plan_texts(edits):
    """The new host texts, with the registry keys of rewritten snippets moved
    to their new hash. Returns (texts, rekeyed, problems)."""
    texts = {path: apply_text(read(path), inserts) for path, inserts in edits.items()}
    rekeyed, problems = [], []
    moves = {REGISTRY: [], DOCS_REGISTRY: []}
    registries = {rel: json.loads(read(rel)) for rel in moves}
    for path, new in texts.items():
        old_list = raw_snippets(path, read(path))
        if old_list is None:
            continue
        new_list = raw_snippets(path, new)
        if len(old_list) != len(new_list):
            problems.append(f"{path}: {len(old_list)} snippets before, {len(new_list)} after")
            continue
        for old, fresh in zip(old_list, new_list):
            if old == fresh:
                continue
            old_id = checker.identity(identity_path(path), old)
            new_id = checker.identity(identity_path(path), fresh)
            for rel, data in registries.items():
                if old_id in data:
                    moves[rel].append((old_id, new_id))
    for rel, pairs in moves.items():
        if not pairs:
            continue
        text = texts.get(rel, read(rel))
        for old_id, new_id in pairs:
            assert len(old_id) == len(new_id)
            if new_id in registries[rel]:
                problems.append(f"{rel}: {new_id} is already a key")
                continue
            key = re.compile('"' + re.escape(json.dumps(old_id)[1:-1]) + r'"(?=\s*:)')
            hits = list(key.finditer(text))
            if len(hits) != 1:
                problems.append(f"{rel}: key {old_id} found {len(hits)} times")
                continue
            at = hits[0].start() + 1
            text = text[:at] + json.dumps(new_id)[1:-1] + text[at + len(old_id):]
            rekeyed.append(dict(registry=rel, old=old_id, new=new_id))
        texts[rel] = text
    return texts, rekeyed, problems


def prove(assemblies, listed, edits, prelude, include_design):
    """Re-extract and re-assemble from the planned texts; every source must be
    the old one with exactly the planned brackets, and the migrated sources
    must parse cleanly with nothing left to rewrite."""
    texts, rekeyed, problems = plan_texts(edits)
    if problems:
        return texts, rekeyed, problems
    OVERLAY.clear()
    OVERLAY.update(texts)
    try:
        registry, docs_registry = load_registries()
        after, after_listed = extract(registry, docs_registry, include_design)
        by_key = {a.key(): a for a in after}
        if len(after) != len(assemblies) or len(after_listed) != len(listed):
            problems.append(f"{len(assemblies)}/{len(listed)} sources and listings before, "
                            f"{len(after)}/{len(after_listed)} after")
        for a in assemblies:
            b = by_key.get(a.key())
            if b is None:
                problems.append(f"{a.path}:{a.line}: the source is no longer extracted")
                continue
            if b.source != expected_source(a):
                problems.append(f"{a.path}:{a.line}: re-assembled source differs from the planned one")
        changed = [by_key[a.key()] for a in assemblies if a.rewrite and a.key() in by_key]
        left = classify(changed, prelude)
        for a, b in zip([a for a in assemblies if a.rewrite], changed):
            if b.status not in ("clean",) and not (b.status == "needs_human" and b.ambiguous and not b.rewrite):
                problems.append(f"{a.path}:{a.line}: after the rewrite the source is {b.status}: {b.reason}")
        if left:
            problems.append(f"{sum(len(v) for v in left.values())} site(s) still rewritable after the rewrite")
    finally:
        OVERLAY.clear()
        load_registries()
    return texts, rekeyed, problems


# --------------------------------------------------------------------------
# Report.
# --------------------------------------------------------------------------
def line_col(text, at):
    return text.count("\n", 0, at) + 1, at - (text.rfind("\n", 0, at) + 1) + 1


def report(assemblies, listed, flagged, edits, rekeyed, mode, quiet):
    summary, records = {}, []
    for a in assemblies:
        summary.setdefault(a.family, {}).setdefault(a.status, 0)
        summary[a.family][a.status] += 1
        record = dict(family=a.family, path=a.path, line=a.line, identity=a.identity, surface=a.surface,
                      status=a.status, reason=a.reason, diagnostics=a.diagnostics,
                      sites_reported=len(a.sites), payload=a.payload, rewritten=len(a.rewrite))
        if a.registry:
            record["registry"] = a.registry
        if a.unknown:
            record["unknown"] = [dict(name=n, start=s, why=d) for n, s, d in a.unknown]
        if a.ambiguous:
            record["ambiguous"] = [dict(name=n, start=s, why=d) for n, s, d in a.ambiguous]
        if a.rewrite:
            record["sites"] = []
            for kind, cs, ce, name, host in a.rewrite:
                path, at, _ = host[-1]
                line, column = line_col(read(path), at)
                record["sites"].append(dict(kind=kind, name=name, file=path, line=line, column=column,
                                            assembled_start=cs, assembled_end=ce))
        if a.would_rewrite:
            record["would_rewrite"] = a.would_rewrite
        records.append(record)
    for item in flagged:
        summary.setdefault(item["family"], {}).setdefault(item["status"], 0)
        summary[item["family"]][item["status"]] += 1
        records.append(item)
    extra = {}
    for item in listed:
        extra[item["status"]] = extra.get(item["status"], 0) + 1
        records.append(item)

    for family in sorted(summary):
        counts = ", ".join(f"{status} {summary[family][status]}" for status in sorted(summary[family]))
        print(f"{family}: {counts}")
    if extra:
        print("listed: " + ", ".join(f"{k} {v}" for k, v in sorted(extra.items())))

    problems = [r for r in records if r["status"] in ("unparsed", "needs_human", "unassembled")]
    for r in problems:
        if quiet and r["status"] == "unparsed":
            continue
        print(f"{r['status']} {r['path']}:{r['line']}: {r['reason']}")
    for a in assemblies:
        for name, start, detail in a.unknown:
            if not quiet:
                print(f"unknown {a.path}:{a.line} {name}: {detail}")
    for a in assemblies:
        if a.status == "not_source" and a.would_rewrite and not quiet:
            print(f"not i source {a.path}:{a.line}: {a.would_rewrite} zero-payload use(s) if it were i")
    total = sum(len(v) for v in edits.values())
    sites = sum(len(a.rewrite) for a in assemblies)
    verb = "rewrote" if mode == "write" else "to rewrite"
    print(f"{PROG}: {mode}: {sites} site(s) {verb} ({total} insertion(s)) in {len(edits)} file(s); "
          f"{sum(a.payload for a in assemblies)} payload use(s) left bare; "
          f"{sum(len(a.unknown) for a in assemblies)} unknown-name site(s); "
          f"{sum(len(a.ambiguous) for a in assemblies)} ambiguous site(s); "
          f"{len(rekeyed)} registry key(s) moved")
    if not quiet:
        for path in sorted(edits):
            text = read(path)
            for at, piece in sorted(edits[path]):
                line, column = line_col(text, at)
                print(f"  {path}:{line}:{column} insert `{piece}`")
        for move in rekeyed:
            print(f"  {move['registry']}: {move['old']} -> {move['new']}")
    return records, summary, sites


def verify_extraction():
    """The readers here must agree with the owner readers, byte for byte."""
    problems = 0
    for path in tracked("*.rs"):
        text = read(path)
        mine = [(s, e, v) for s, e, v, _ in rust_strings(text, path)]
        owner = [(s, e, v) for s, e, v in checker.rust_strings(text)]
        if mine != owner:
            print(f"rust reader differs: {path}")
            problems += 1
        for _, _, value, body in rust_strings(text, path):
            # Every literal character maps back to itself in the host.
            for c, origin in zip(str(body), body.origin):
                if text[origin[1]] != c and text[origin[1]] != "\\":
                    print(f"rust origin differs: {path}:{origin[1]}")
                    problems += 1
                    break
    for path in tracked("*.md", "*.mdx"):
        text = read(path)
        mine = [(i, str(s), l, c) for i, s, l, c in fence_blocks(text, path)]
        owner = [(f.info, f.source, f.line, f.closed) for f in fences_owner.fences(text)]
        if mine != owner:
            print(f"fence reader differs: {path}")
            problems += 1
        for _, body, _, _ in fence_blocks(text, path):
            if any(text[o[1]] != c for c, o in zip(str(body), body.origin)):
                print(f"fence origin differs: {path}")
                problems += 1
    for rel in (REGISTRY, DOCS_REGISTRY):
        raw = read(rel)
        mine = {where: str(value) for where, value in json_strings(raw, rel)}
        flat = {}

        def flatten(value, where):
            if isinstance(value, str):
                flat[where] = value
            elif isinstance(value, list):
                for index, item in enumerate(value):
                    flatten(item, where + (index,))
            elif isinstance(value, dict):
                for key, item in value.items():
                    flatten(item, where + (key,))

        flatten(json.loads(raw), ())
        if mine != flat:
            print(f"json reader differs: {rel}")
            problems += 1
    # The assembly is the owner's: prefix + source + suffix, then substitutions.
    registry, docs_registry = load_registries()
    assemblies, _ = extract(registry, docs_registry, True)
    for a in assemblies:
        owner = a.entry.get("prefix", "") + str(a.body) + a.entry.get("suffix", "")
        for old, new in a.entry.get("substitutions", []):
            owner = owner.replace(old, new)
        if owner != a.source:
            print(f"assembly differs: {a.path}:{a.line}")
            problems += 1
    print(f"verify-extraction: {'ok' if not problems else str(problems) + ' difference(s)'}"
          f" ({len(assemblies)} assembled sources)")
    return 1 if problems else 0


def main(argv):
    global ROOT, PARSER, checker, fences_owner
    parser = argparse.ArgumentParser(prog=PROG, description=__doc__.splitlines()[0])
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--dry-run", action="store_true", help="report only (default)")
    mode.add_argument("--write", action="store_true", help="insert the brackets")
    mode.add_argument("--check", action="store_true", help="exit 1 while a rewritable site remains")
    parser.add_argument("--root", help="the repository root")
    parser.add_argument("--parser", help="the constructor-sites example binary")
    parser.add_argument("--prelude", help="the prelude source")
    parser.add_argument("--manifest", metavar="PATH", help="the per-source report (JSON)")
    parser.add_argument("--include-design", action="store_true",
                        help="also migrate fences in docs/design (design notes are listed, not rewritten)")
    parser.add_argument("--quiet", action="store_true", help="only the totals and the problems")
    parser.add_argument("--verify-extraction", action="store_true",
                        help="check the readers here against the owner readers and exit")
    args = parser.parse_args(argv)

    root = args.root
    if root is None:
        root = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True).stdout.strip()
        if not root:
            raise SystemExit(f"{PROG}: run this inside the repository or pass --root")
    ROOT = Path(root).resolve()
    checker, fences_owner = owner_modules()
    if args.verify_extraction:
        return verify_extraction()

    PARSER = Path(args.parser or os.environ.get("CONSTRUCTOR_SITES_PARSER")
                  or ROOT / "target/debug/examples/constructor-sites").resolve()
    if not PARSER.is_file():
        raise SystemExit(f"{PROG}: parser helper not found: {PARSER}; build it with\n"
                         "  cargo build -p ilang-syntax --example constructor-sites\n"
                         "or pass --parser PATH (or set $CONSTRUCTOR_SITES_PARSER)")
    prelude = load_prelude(args.prelude or str(ROOT / "lib/prelude.i"))

    registry, docs_registry = load_registries()
    assemblies, listed = extract(registry, docs_registry, args.include_design)
    edits = classify(assemblies, prelude)
    names = set(BUILTIN_ZERO) | {n for n, c in prelude.items() if c == {0}}
    flagged = probes(assemblies, names)
    mode_name = "write" if args.write else "check" if args.check else "dry-run"

    texts, rekeyed, problems = prove(assemblies, listed, edits, prelude, args.include_design)
    records, summary, sites = report(assemblies, listed, flagged, edits, rekeyed, mode_name, args.quiet)
    for problem in problems:
        print(f"proof failed: {problem}")
    if problems:
        print(f"{PROG}: the planned rewrite is not proved; nothing written")
    elif args.write:
        for path, text in sorted(texts.items()):
            (ROOT / path).write_bytes(text.encode("utf-8"))

    manifest = args.manifest or (str(ROOT / "constructor-call-embedded.json") if args.write else None)
    if manifest:
        Path(manifest).write_text(json.dumps(dict(
            generated_by=f"scripts/{PROG} --{mode_name}", parser=str(PARSER), summary=summary,
            proof=problems or "ok", rekeyed=rekeyed,
            unparsed=[r for r in records if r["status"] == "unparsed"],
            needs_human=[r for r in records if r["status"] in ("needs_human", "unassembled")],
            unknown=[dict(path=r["path"], line=r["line"], **u) for r in records for u in r.get("unknown", [])],
            ambiguous=[dict(path=r["path"], line=r["line"], **u) for r in records for u in r.get("ambiguous", [])],
            sources=records), indent=1, ensure_ascii=False) + "\n")
        print(f"{PROG}: manifest {manifest}")
    if problems:
        return 2
    if args.check and sites:
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
