#!/usr/bin/env bash
# Verifies the project. The parts are independent, so CI runs them in
# parallel; with no arguments, all of them run one after another.
#
#   scripts/dev-verify            rust, i, js and editors
#   scripts/dev-verify rust       Rust formatting, Clippy, snippets and the workspace tests
#                                 (rust-lint: formatting, Clippy and snippets; rust-test: the tests)
#   scripts/dev-verify snippets   every i snippet in the repository parses, or gives its registered
#                                 diagnostics (scripts/old-syntax-check and its own tests)
#   scripts/dev-verify i          the release `i`, and with it the i sources
#   scripts/dev-verify editors    VS Code tests, tree-sitter tests and Zed build
#   scripts/dev-verify js         the JavaScript SDK and browser tests
#
# For CI, which builds once and runs the review corpus in shards:
#   DEV_VERIFY_I_BINARY=path      the i part uses this `i` instead of building it
#   DEV_VERIFY_SKIP_CORPUS=1      the i part leaves out the review corpus
#
# These parts are every test suite of the repository. Where each suite runs:
#   tests/spec/**                 spec cases with their header        rust-test (ilang-cli --test spec)
#   crates/*/tests, #[test]       per-crate Rust tests and fixtures   rust-test
#   tests/perf/many-tests, tests/r2-performance, tests/r2-examples,
#   tests/t1-blockers             fixtures of ilang-cli/ilang-check tests   rust-test
#   tests/review/cases/**         review corpus, expected.json and the
#                                 known failures in requirements.json  i (scripts/review-corpus run)
#   lib, std, bench, examples     i tests at --opt 0 and 2, formatting i
#   scripts/qa/generate.py        generated programs                   i (scripts/test-generation)
#   i snippets in .i/.rs/.js/.md  scripts/old-syntax-check             snippets
#   bindings/javascript, tests/browser                                 js
#   editors/**                                                         editors
# Measurements and one-off comparisons, not suites: scripts/bench, scripts/checker-bench,
# tests/perf/numeric, tests/t1/*, tests/r2-*.py. tests/syn3/services (expected.txt) is run
# by hand with I_SYNTAX=3 until syntax three is the default.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."

binaryen() {
  git submodule update --init crates/ilang-binaryen/binaryen
}

rust() {
  rust-lint
  rust-test
}

rust-lint() {
  binaryen
  cargo fmt --all -- --check
  cargo clippy --workspace --all-targets --locked -- -D warnings
  snippets
}

snippets() {
  scripts/old-syntax-check # builds the parser driver that its tests use
  python3 -I scripts/old-syntax-check-test
}

# DEV_VERIFY_TEST_GROUP splits the tests for CI, where one job would take close to an hour:
# check (ilang-check), spec, cli (the other tests of ilang-cli), rest (every other crate). Unset: all of them.
rust-test() {
  binaryen
  case "${DEV_VERIFY_TEST_GROUP:-}" in
    "") cargo test --workspace --locked ;;
    check) cargo test -p ilang-check --locked ;;
    spec) cargo test -p ilang-cli --locked --test spec ;;
    cli)
      targets=()
      for file in crates/ilang-cli/tests/*.rs; do
        name="$(basename "$file" .rs)"
        [ "$name" = spec ] || targets+=(--test "$name")
      done
      cargo test -p ilang-cli --locked --bins "${targets[@]}"
      ;;
    rest) cargo test --workspace --exclude ilang-cli --exclude ilang-check --locked ;;
    *) echo "dev-verify: unknown DEV_VERIFY_TEST_GROUP '$DEV_VERIFY_TEST_GROUP'" >&2; exit 2 ;;
  esac
}

i() {
  local i
  if [[ -n "${DEV_VERIFY_I_BINARY:-}" ]]; then
    i="$(realpath "$DEV_VERIFY_I_BINARY")"
  else
    binaryen
    cargo build --release --locked -p ilang-cli
    i="$(realpath "${CARGO_TARGET_DIR:-target}")/release/i"
  fi
  "$i" fmt --check lib std bench examples
  for level in 0 2; do
    "$i" test --project std --opt "$level"
    "$i" test --project examples/hello --opt "$level"
    "$i" test --project bench --opt "$level"
  done
  ./scripts/wasi-smoke "$i"
  if [[ "${DEV_VERIFY_SKIP_CORPUS:-}" != 1 ]]; then
    ./scripts/review-corpus run --binary "$i" --jobs 3
  fi
  ./scripts/test-generation --mode short --binary "$i"
}

js() {
  binaryen
  cargo build --locked -p ilang-cli
  npm ci --ignore-scripts
  npm test
  npm run test:browser
}

editors() {
  npm --prefix editors/vscode ci --ignore-scripts
  npm --prefix editors/vscode test
  (
    cd editors/tree-sitter-i
    npm ci
    npx tree-sitter generate
    git diff --exit-code -- src
    npx tree-sitter test
    cmp queries/highlights.scm ../zed/languages/i/highlights.scm
    for query in queries/highlights.scm ../zed/languages/i/{brackets,indents,outline}.scm; do
      npx tree-sitter query -q "$query" ../../examples/hello/src/main.i
    done
    while IFS= read -r -d '' source; do
      npx tree-sitter parse -q "$source"
    done < <(find ../../lib ../../std ../../examples -name '*.i' -print0)
  )
  (
    cd editors/zed
    local target_libdir
    target_libdir=$(rustc --print target-libdir --target wasm32-wasip1)
    if [[ -d "$target_libdir" ]]; then
      cargo check --locked --target wasm32-wasip1
    else
      cargo check --locked
    fi
  )
}

parts=("$@")
if [[ ${#parts[@]} -eq 0 ]]; then parts=(rust i js editors); fi
for part in "${parts[@]}"; do
  case "$part" in
    rust | rust-lint | rust-test | snippets | i | js | editors) "$part" ;;
    *) echo "dev-verify: unknown part '$part' (rust, rust-lint, rust-test, snippets, i, js or editors)" >&2; exit 2 ;;
  esac
done
