#!/usr/bin/env bash
set -euo pipefail
cd "${ILANG_ROOT:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}"
export CARGO_TARGET_DIR="${ILANG_CARGO_TARGET_DIR:-$PWD/target/cargo}"
git submodule update --init crates/ilang-binaryen/binaryen
cargo fmt --all -- --check
cargo clippy --workspace --all-targets --locked -- -D warnings
cargo test --workspace --locked "$@"
cargo build --workspace --locked
cargo build --release --locked -p ilang-cli
for level in 0 2; do
  "$CARGO_TARGET_DIR/release/i" test --project std --opt "$level"
  "$CARGO_TARGET_DIR/release/i" test --project examples/hello --opt "$level"
done
npm ci --ignore-scripts
npm test
npm run test:browser
