#!/usr/bin/env python3
"""Rewrites a bracketless zero-payload constructor use into a call.

`True` becomes `True()` in the normal surface and `(True)` in the Lisp
surface, in value and in pattern position, in the tracked `*.i` and `*.is`
files. The parser says where an uppercase constructor use is and which
constructors a source defines; this script only decides, from those
definitions, which uses name a constructor without a payload.

    scripts/constructor-call-migrate --dry-run   # list the sites, totals (default)
    scripts/constructor-call-migrate --write     # insert the brackets
    scripts/constructor-call-migrate --check     # exit 1 while a rewritable site remains

Run it from the repository root, or pass `--root`. It reads the tracked
`*.i` and `*.is` files (`git ls-files`).

The sites come from a small parser example:

    heavy direnv exec . cargo build -p ilang-syntax --example constructor-sites

`--parser` (or `$CONSTRUCTOR_SITES_PARSER`) points at that binary; by default
the script uses `target/debug/examples/constructor-sites` under the root. Its
protocol: one request `<normal|lisp> <path>` per line; per request the lines
`FILE <path>`, `IMPORT <hex alias> <hex path>`, `ZERO <name>`,
`CTOR <name> <field-count>`, `SITE <value|pattern> <start> <end> <hex name>`,
`DIAG <code> <hex>` and `END` (offsets are bytes), or a single
`FAIL <path> <reason>`. A site name written with a module is `m.Name`.

The library (`--lib`, by default `<root>/stdlib`, else `<root>/std`) gives a
table per module: every tracked source under `<lib>/src/`, keyed by its path
below `src/` without the extension (`request`, `util/list`), with the
constructors it defines. The built-in modules the compiler embeds,
`<root>/lib/i/**` when tracked, are library modules too, under the package
name `i` (as is the `--lib` package when its `i.toml` names it `i`). The
prelude, `<root>/lib/prelude.i` (or `--prelude`), gives the built-in names.

How an unqualified name resolves, for a site in file F:

1. Local: a constructor F itself defines (`CTOR`, or `ZERO` for zero fields).
2. Package: every constructor defined by a tracked source of the same package
   (the nearest ancestor directory of F holding an `i.toml`; a nested package
   is a package of its own; without one, F's own directory).
3. Prelude: the built-in names.
4. Library: every constructor of every library module.
5. Builtins: `True` and `False` have no payload (when no prelude says so).
6. Otherwise the name is `unknown` and the site is not rewritten.

The first table that knows the name decides: one arity is that arity, both
zero and non-zero is `ambiguous`, never rewritten.

A qualified name `m.Name` resolves `m` through F's imports (the alias is the
written one or the last part of the path), the way the checker does. For an
import `p/rest`: `p` = `i` is the built-in library; `p` = F's own package
name is the module file `<package>/src/rest.i` (or `.is`); `p` = a dependency
of F's package (`[dependencies]`, or `[dev-dependencies]`) is the library
when its path is `--lib`, else that package's module file when it is inside
the root; otherwise `p` = the `--lib` package's name is the library. A name
that module does not define, an alias F does not import, or any other import
is `unknown`.

A site is rewritten only when the name resolves to zero fields. A file the
parser reports any `DIAG` (or `FAIL`) for is never rewritten. Every file lands
in exactly one class, by priority: `skipped`, `unparsed`, `ambiguous` (some
site has an ambiguous name; its other zero-payload sites are still rewritten),
`rewritten`, `clean` (nothing to rewrite). Sites with an unknown name, and
sites whose bytes are not what the parser said (`refused`), are listed too.

Exit status: `--dry-run` 0; `--check` 1 while a rewritable site remains;
`--write` 3 when unparsed or ambiguous files (or refused sites) remain, else 0.
`--write` also records the unparsed and ambiguous files in
`<root>/constructor-call-unparsed.json` (or `--manifest`).

Options:
  --root PATH     the repository root (default: `git rev-parse --show-toplevel`)
  --parser PATH   the constructor-sites example binary
  --manifest PATH where `--write` records unparsed and ambiguous files
  --lib PATH      the library package (default: `<root>/stdlib`, else `<root>/std`)
  --prelude PATH  the prelude source (default: `<root>/lib/prelude.i` when present)
  --skip PATH     leave this tracked file alone (repeatable)
  --quiet         only the totals and the problem files
"""

import argparse
import json
import os
import re
import subprocess
import sys
import tomllib

PROG = "constructor-call-migrate"
# Nothing is skipped by default: the constructor rule covers every source.
# The spec fixtures that use the constructor as a function, or assert that the
# old form is an error, keep their form.
DEFAULT_SKIP = (
    "tests/spec/4.3/constructor_as_function_value.i",
    "tests/spec/4.3/constructor_bare_value.i",
    "tests/spec/4.3/constructor_pattern_bare.i",
)
BUILTIN_ZERO = ("True", "False")


def run_git(root, args):
    result = subprocess.run(["git", *args], cwd=root, capture_output=True)
    if result.returncode != 0:
        sys.stderr.write(
            "%s: git %s failed: %s\n"
            % (PROG, " ".join(args), result.stderr.decode("utf-8", "replace").strip())
        )
        raise SystemExit(2)
    return result.stdout


def tracked_sources(root):
    """Every tracked `*.i` file that exists, in a stable order.

    The Lisp surface is left to the hand edit that this rule needed: a
    template datum `(. m C)` is a qualified type reference as often as a
    constructor use, and no arity is knowable there. Its four rewritten sites
    (a pattern in each `sugar.is`, and `True`/`False`/`First` as values in
    `mp09_portable_hash`) are outside this tool.
    """
    out = run_git(root, ["ls-files", "-z", "--", "*.i"])
    paths = [p.decode("utf-8", "surrogateescape") for p in out.split(b"\0") if p]
    return sorted(p for p in set(paths) if os.path.isfile(os.path.join(root, p)))


def surface(path):
    return "lisp" if path.endswith(".is") else "normal"


def query(binary, root, paths):
    """Runs the example once over `paths` (relative to `root`, or absolute);
    returns `path -> result`."""
    if not paths:
        return {}
    text = "".join(
        "%s %s\n" % (surface(p), os.path.join(root, p)) for p in paths
    )
    result = subprocess.run(
        [binary], input=text.encode("utf-8", "surrogateescape"), capture_output=True
    )
    if result.returncode != 0:
        sys.stderr.write(result.stderr.decode("utf-8", "replace"))
        raise SystemExit("%s: %s exited %d" % (PROG, binary, result.returncode))
    by_abs = parse_report(result.stdout.decode("utf-8", "surrogateescape"))
    return {p: by_abs.get(os.path.join(root, p)) for p in paths}


def parse_report(text):
    results = {}
    current = None
    for number, line in enumerate(text.splitlines(), 1):
        if line.startswith("FILE "):
            current = {"imports": {}, "zero": [], "ctors": [], "sites": [],
                       "diags": [], "bad": []}
            results[line[5:]] = current
        elif line.startswith("FAIL "):
            path, _, reason = line[5:].partition(" ")
            results[path] = {"fail": reason}
            current = None
        elif line == "END":
            current = None
        elif current is None:
            if line.strip():
                sys.stderr.write("%s: stray parser line %d: %s\n" % (PROG, number, line))
        elif line.startswith("IMPORT "):
            parts = line[7:].split(" ")
            if len(parts) != 2:
                current["bad"].append(line)
                continue
            alias, path = (bytes.fromhex(x).decode("utf-8", "replace") for x in parts)
            current["imports"][alias] = path
        elif line.startswith("ZERO "):
            current["zero"].append(line[5:])
        elif line.startswith("CTOR "):
            name, _, count = line[5:].rpartition(" ")
            current["ctors"].append((name, int(count)))
        elif line.startswith("SITE "):
            parts = line[5:].split(" ")
            if len(parts) != 4:
                current["bad"].append(line)
                continue
            kind, start, end, hexname = parts
            name = bytes.fromhex(hexname).decode("utf-8", "replace")
            current["sites"].append((kind, int(start), int(end), name))
        elif line.startswith("DIAG "):
            code, _, hexmessage = line[5:].partition(" ")
            try:
                message = bytes.fromhex(hexmessage).decode("utf-8", "replace")
            except ValueError:
                message = hexmessage
            current["diags"].append((code, message))
        else:
            # An unknown line is a protocol the script does not understand:
            # the file is treated as unparsed rather than guessed at.
            current["bad"].append(line)
    return results


def package_root(root, path):
    """The nearest ancestor directory (relative) holding an `i.toml`, or None."""
    directory = os.path.dirname(path)
    while True:
        if os.path.isfile(os.path.join(root, directory, "i.toml")):
            return directory
        if not directory:
            return None
        directory = os.path.dirname(directory)


def scope_of(root, path):
    found = package_root(root, path)
    if found is not None:
        return ("package", found)
    return ("directory", os.path.dirname(path))


def local_arities(result):
    """`name -> set of field counts` the file itself defines."""
    table = {}
    for name in result["zero"]:
        table.setdefault(name, set()).add(0)
    for name, count in result["ctors"]:
        table.setdefault(name, set()).add(count)
    return table


def verdict_of(counts, where):
    zero = 0 in counts
    payload = any(c != 0 for c in counts)
    if zero and payload:
        # Both arities: not a guess we make, wherever the definitions are.
        return ("ambiguous", "%s arities %s" % (where, sorted(counts)))
    return ("zero" if zero else "payload", where)


def resolve(name, tables):
    """`tables` is `[(where, name -> arities)]`, first match wins.

    Returns `("zero"|"payload"|"ambiguous"|"unknown", detail)`.
    """
    for where, table in tables:
        counts = table.get(name)
        if counts:
            return verdict_of(counts, where)
    if name in BUILTIN_ZERO:
        return ("zero", "builtin")
    return ("unknown", "no definition found")


def read_manifest(directory):
    """`(name, dependencies)` of the package at `directory`; `{}` when absent."""
    path = os.path.join(directory, "i.toml")
    try:
        with open(path, "rb") as handle:
            data = tomllib.load(handle)
    except (OSError, tomllib.TOMLDecodeError):
        return None, {}
    deps = {}
    for section in ("dev-dependencies", "dependencies"):
        for key, value in (data.get(section) or {}).items():
            if isinstance(value, dict) and isinstance(value.get("path"), str):
                deps[key] = os.path.realpath(os.path.join(directory, value["path"]))
            else:
                deps[key] = None
    name = data.get("name")
    if name is None and isinstance(data.get("package"), dict):
        name = data["package"].get("name")
    return name, deps


BUILTIN_PACKAGE = "i"


class Library:
    """The module tables of the library packages: `i` and the `--lib` package."""

    def __init__(self, directory, name, packages, prelude):
        self.directory = directory  # the `--lib` package, or None
        self.name = name  # its manifest name, or None
        # package name -> module path -> name -> arities
        self.packages = packages
        self.prelude = prelude  # name -> arities
        self.merged = {}
        for modules in packages.values():
            for table in modules.values():
                for ctor, counts in table.items():
                    self.merged.setdefault(ctor, set()).update(counts)

    def module(self, package, rest):
        return self.packages.get(package, {}).get(rest)


def module_key(rel):
    """`request` for `request.i`, `util/list` for `util/list.is`."""
    return os.path.splitext(rel)[0]


def module_tables(binary, directory, below):
    """`module -> name -> arities` of the tracked sources under `directory/below`."""
    patterns = ["%s/*.i" % below, "%s/*.is" % below]
    out = run_git(directory, ["ls-files", "-z", "--", *patterns])
    rels = sorted({p.decode("utf-8", "surrogateescape") for p in out.split(b"\0") if p})
    results = query(binary, directory, rels)
    modules = {}
    for rel in rels:
        result = results.get(rel)
        if unparsed_reason(result) is not None:
            sys.stderr.write("%s: library module %s does not parse; it gives no table\n"
                             % (PROG, os.path.join(directory, rel)))
            continue
        modules[module_key(rel[len(below) + 1:])] = local_arities(result)
    return modules


def load_library(binary, root, lib, prelude_path):
    packages = {}
    directory = name = None
    if lib is not None and os.path.isdir(lib):
        directory = os.path.realpath(lib)
        name, _deps = read_manifest(directory)
        packages.setdefault(name or "", {}).update(module_tables(binary, directory, "src"))
    builtin = os.path.join(root, "lib", BUILTIN_PACKAGE)
    if os.path.isdir(builtin):
        packages.setdefault(BUILTIN_PACKAGE, {}).update(
            module_tables(binary, os.path.join(root, "lib"), BUILTIN_PACKAGE))
    prelude = {}
    if prelude_path is not None and os.path.isfile(prelude_path):
        absolute = os.path.realpath(prelude_path)
        result = query(binary, "/", [absolute]).get(absolute)
        if unparsed_reason(result) is not None:
            sys.stderr.write("%s: the prelude %s does not parse; it gives no table\n"
                             % (PROG, prelude_path))
        else:
            prelude = local_arities(result)
    if not packages and not prelude:
        return None
    return Library(directory, name, packages, prelude)


def module_file(directory, rest):
    """The source file of module `rest` in the package at `directory`."""
    for base in (os.path.join(directory, "src"), directory):
        for ext in (".i", ".is"):
            candidate = os.path.join(base, rest + ext)
            if os.path.isfile(candidate):
                return os.path.realpath(candidate)
    return None


class Resolver:
    """Resolves the alias of a qualified site to a module's constructor table."""

    def __init__(self, root, binary, library, results):
        self.root = root
        self.binary = binary
        self.library = library
        self.manifests = {}
        # absolute module file -> result, filled from the tracked results
        self.files = {os.path.realpath(os.path.join(root, p)): r
                      for p, r in results.items()}

    def manifest(self, package):
        if package not in self.manifests:
            self.manifests[package] = read_manifest(os.path.join(self.root, package))
        return self.manifests[package]

    def target(self, path, import_path):
        """`("lib", module)`, `("file", absolute path)` or `(None, reason)`."""
        parts = import_path.split("/")
        if len(parts) < 2:
            return (None, "import `%s` is not a module path" % import_path)
        first, rest = parts[0], "/".join(parts[1:])
        package = package_root(self.root, path)
        own_name, deps = (None, {})
        if package is not None:
            own_name, deps = self.manifest(package)
        lib = self.library
        if first == BUILTIN_PACKAGE:
            return ("lib", (BUILTIN_PACKAGE, rest))
        if package is not None and first == own_name:
            found = module_file(os.path.join(self.root, package), rest)
            if found is None:
                return (None, "no module file for `%s`" % import_path)
            return ("file", found)
        if first in deps:
            dep = deps[first]
            if dep is None:
                return (None, "dependency `%s` is not a path dependency" % first)
            if lib is not None and dep == lib.directory:
                return ("lib", (lib.name, rest))
            if not (dep + os.sep).startswith(os.path.realpath(self.root) + os.sep):
                return (None, "dependency `%s` is outside the root" % first)
            found = module_file(dep, rest)
            if found is None:
                return (None, "no module file for `%s`" % import_path)
            return ("file", found)
        if lib is not None and lib.name is not None and first == lib.name:
            return ("lib", (lib.name, rest))
        return (None, "import `%s` is neither the library nor a path dependency"
                % import_path)

    def table(self, path, import_path):
        """`(where, name -> arities)` or `(None, reason)`."""
        kind, value = self.target(path, import_path)
        if kind is None:
            return (None, value)
        if kind == "lib":
            name = "%s/%s" % value
            table = self.library.module(*value) if self.library is not None else None
            if table is None:
                return (None, "library module `%s` not found" % name)
            return ("library module %s" % name, table)
        if value not in self.files:
            self.files.update(
                {k: v for k, v in query(self.binary, "/", [value]).items()})
        result = self.files.get(value)
        if unparsed_reason(result) is not None:
            return (None, "module file %s does not parse"
                    % os.path.relpath(value, self.root))
        return ("module %s" % os.path.relpath(value, self.root), local_arities(result))

    def resolve_qualified(self, path, imports, written):
        alias, _, name = written.rpartition(".")
        import_path = imports.get(alias)
        if import_path is None:
            return ("unknown", "`%s` is not imported" % alias)
        where, table = self.table(path, import_path)
        if where is None:
            return ("unknown", table)
        counts = table.get(name)
        if not counts:
            return ("unknown", "%s defines no `%s`" % (where, name))
        return verdict_of(counts, where)


def unparsed_reason(result):
    if result is None:
        return "the parser reported nothing"
    if "fail" in result:
        return "FAIL " + result["fail"]
    if result["bad"]:
        return "unexpected parser line: %s" % result["bad"][0]
    diags = result["diags"]
    if not diags:
        return None
    code, message = diags[0]
    suffix = "" if len(diags) == 1 else " (and %d more)" % (len(diags) - 1)
    return "%s: %s%s" % (code, message, suffix)


def plan(root, paths, results, skips, resolver):
    """Classifies every file and lists its insertions."""
    scopes = {p: scope_of(root, p) for p in paths}
    package_tables = {}
    for path in paths:
        result = results.get(path)
        if path in skips or unparsed_reason(result) is not None:
            # A file the parser cannot read contributes no definitions: a
            # recovered tree is not trusted for the symbol table either.
            # A skipped file still defines its constructors.
            if path not in skips:
                continue
            if result is None or "fail" in result:
                continue
        table = package_tables.setdefault(scopes[path], {})
        for name, counts in local_arities(result).items():
            table.setdefault(name, set()).update(counts)

    files = []
    for path in paths:
        entry = {"path": path, "surface": surface(path), "sites": [],
                 "ambiguous": [], "unknown": [], "refused": [], "payload": 0}
        files.append(entry)
        if path in skips:
            entry["class"] = "skipped"
            continue
        result = results.get(path)
        reason = unparsed_reason(result)
        if reason is not None:
            entry["class"] = "unparsed"
            entry["reason"] = reason
            entry["names"] = sorted({s[3] for s in (result or {}).get("sites", [])})
            continue
        data = read_bytes(root, path)
        local = local_arities(result)
        tables = [("local", local), ("package", package_tables.get(scopes[path], {}))]
        if resolver.library is not None:
            tables.append(("prelude", resolver.library.prelude))
            tables.append(("library", resolver.library.merged))
        for kind, start, end, name in result["sites"]:
            if "." in name:
                verdict, detail = resolver.resolve_qualified(path, result["imports"], name)
            else:
                verdict, detail = resolve(name, tables)
            if verdict == "payload":
                entry["payload"] += 1
                continue
            if verdict == "ambiguous":
                entry["ambiguous"].append((name, start, detail))
                continue
            if verdict == "unknown":
                entry["unknown"].append((name, start, detail))
                continue
            problem = site_problem(data, entry["surface"], start, end, name)
            if problem is not None:
                entry["refused"].append((name, start, problem))
                continue
            entry["sites"].append((kind, start, end, name))
        if entry["ambiguous"]:
            entry["class"] = "ambiguous"
        elif entry["sites"]:
            entry["class"] = "rewritten"
        else:
            entry["class"] = "clean"
    return files


def site_problem(data, surface_name, start, end, name):
    """Why the bytes at a site do not match what the parser said, or None."""
    if not (0 <= start < end <= len(data)):
        return "offsets %d..%d are outside the file" % (start, end)
    # A module-qualified site covers the whole written form (`m.C`, or
    # `(. m C)` in the Lisp surface); an unqualified one covers the name.
    module, dot, base = name.rpartition(".")
    written = data[start:end]
    if dot and surface_name == "lisp":
        form = re.compile(
            rb"\(\.\s+" + re.escape(module.encode("utf-8")) + rb"\s+"
            + re.escape(base.encode("utf-8")) + rb"\s*\)\Z")
        if not form.match(written):
            return "bytes %d..%d hold %r, not %r" % (start, end, written, name)
    else:
        expected = name if dot else base
        if written != expected.encode("utf-8"):
            return "bytes %d..%d hold %r, not %r" % (start, end, written, name)
    if surface_name == "normal":
        if data[end:end + 1] == b"(":
            return "already followed by `(`"
    else:
        if data[start - 1:start] == b"(" and data[end:end + 1] == b")":
            return "already written `(%s)`" % name
    return None


def read_bytes(root, path):
    with open(os.path.join(root, path), "rb") as handle:
        return handle.read()


def apply(data, surface_name, sites):
    """Inserts the brackets, from the last site back, so offsets stay valid."""
    inserts = []
    for _kind, start, end, _name in sites:
        if surface_name == "normal":
            inserts.append((end, b"()"))
        else:
            inserts.append((end, b")"))
            inserts.append((start, b"("))
    # Applied from the end. At equal offsets a `)` (an earlier site's end)
    # must land before a `(` (a later site's start): inserting `(` first and
    # then `)` at the same offset gives `)(`, so `(` sorts last.
    order = sorted(range(len(inserts)), key=lambda i: (inserts[i][0], inserts[i][1] == b"("))
    out = bytearray(data)
    for index in reversed(order):
        offset, text = inserts[index]
        out[offset:offset] = text
    return bytes(out)


def kinds(sites):
    counts = {}
    for kind, *_ in sites:
        counts[kind] = counts.get(kind, 0) + 1
    return ", ".join("%d %s" % (counts[k], k) for k in sorted(counts))


def report(files, quiet, verb):
    totals = {}
    for entry in files:
        totals[entry["class"]] = totals.get(entry["class"], 0) + 1
        cls = entry["class"]
        if cls == "rewritten" and not quiet:
            print("%s %s: %d site(s) (%s)" % (verb, entry["path"], len(entry["sites"]), kinds(entry["sites"])))
        elif cls == "unparsed":
            print("unparsed %s: %s" % (entry["path"], entry["reason"]))
        elif cls == "ambiguous":
            names = sorted({n for n, *_ in entry["ambiguous"]})
            print("ambiguous %s: %s; %d other site(s) %s" % (
                entry["path"], ", ".join(names), len(entry["sites"]),
                "rewritten" if verb == "rewrote" else "rewritable"))
        elif cls == "skipped" and not quiet:
            print("skipped %s" % entry["path"])
        for name, start, problem in entry["refused"]:
            print("refused %s:%d %s: %s" % (entry["path"], start, name, problem))
    unknown = {}
    for entry in files:
        for name, _start, _detail in entry["unknown"]:
            unknown.setdefault(name, set()).add(entry["path"])
    if unknown:
        print("unknown names (not rewritten): %s" % ", ".join(
            "%s (%d file(s))" % (n, len(unknown[n])) for n in sorted(unknown)))
        if not quiet:
            for entry in files:
                for name, start, detail in entry["unknown"]:
                    print("  unknown %s at %s:%d: %s" % (name, entry["path"], start, detail))
    sites = sum(len(e["sites"]) for e in files)
    all_sites = [s for e in files for s in e["sites"]]
    print("%s: %d file(s): %d rewritten, %d clean, %d unparsed, %d ambiguous, %d skipped" % (
        PROG, len(files), totals.get("rewritten", 0), totals.get("clean", 0),
        totals.get("unparsed", 0), totals.get("ambiguous", 0), totals.get("skipped", 0)))
    print("%s: %d site(s) %s (%s); %d payload use(s) left bare; %d ambiguous site(s); "
          "%d unknown-name site(s); %d refused site(s)" % (
              PROG, sites, "rewritten" if verb == "rewrote" else "to rewrite",
              kinds(all_sites) or "none", sum(e["payload"] for e in files),
              sum(len(e["ambiguous"]) for e in files),
              sum(len(e["unknown"]) for e in files),
              sum(len(e["refused"]) for e in files)))


def find_parser(root, explicit):
    for candidate in (explicit, os.environ.get("CONSTRUCTOR_SITES_PARSER")):
        if candidate:
            return candidate
    candidate = os.path.join(root, "target", "debug", "examples", "constructor-sites")
    if os.path.exists(candidate):
        return candidate
    raise SystemExit(
        "%s: no parser example found; build it with\n"
        "  heavy direnv exec . cargo build -p ilang-syntax --example constructor-sites\n"
        "or pass --parser PATH (or set $CONSTRUCTOR_SITES_PARSER)" % PROG
    )


def main(argv):
    parser = argparse.ArgumentParser(prog=PROG, description=__doc__.split("\n")[0])
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--dry-run", action="store_true", help="list the sites (default)")
    mode.add_argument("--write", action="store_true", help="insert the brackets")
    mode.add_argument("--check", action="store_true", help="fail while a site remains")
    parser.add_argument("--root", help="the repository root")
    parser.add_argument("--parser", help="the constructor-sites example binary")
    parser.add_argument("--manifest", help="where --write records problem files")
    parser.add_argument("--lib", help="the library package directory")
    parser.add_argument("--prelude", help="the prelude source")
    parser.add_argument("--skip", action="append", default=[], metavar="PATH",
                        help="leave this file alone (repeatable)")
    parser.add_argument("--quiet", action="store_true", help="only totals and problems")
    args = parser.parse_args(argv)

    root = args.root
    if root is None:
        root = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                              capture_output=True, text=True).stdout.strip()
        if not root:
            raise SystemExit("%s: run this inside the repository" % PROG)
    root = os.path.abspath(root)
    binary = os.path.abspath(find_parser(root, args.parser))
    skips = set(DEFAULT_SKIP)
    for path in args.skip:
        skips.add(os.path.relpath(os.path.abspath(os.path.join(root, path)), root)
                  if not os.path.isabs(path) else os.path.relpath(path, root))
    paths = tracked_sources(root)
    results = query(binary, root, [p for p in paths if p not in skips] +
                    [p for p in paths if p in skips])
    lib = args.lib
    if lib is None:
        for candidate in ("stdlib", "std"):
            if os.path.isdir(os.path.join(root, candidate)):
                lib = os.path.join(root, candidate)
                break
    prelude = args.prelude or os.path.join(root, "lib", "prelude.i")
    library = load_library(binary, root, lib, prelude)
    if library is None:
        sys.stderr.write("%s: no library package; no library table\n" % PROG)
    resolver = Resolver(root, binary, library, results)
    files = plan(root, paths, results, skips, resolver)

    if args.check:
        left = [e for e in files if e["sites"]]
        for entry in left:
            print("%s: %d rewritable site(s)" % (entry["path"], len(entry["sites"])))
        problems = [e for e in files if e["class"] in ("unparsed", "ambiguous")]
        if problems:
            sys.stderr.write("%s: %d unparsed or ambiguous file(s) are not checked fully\n"
                             % (PROG, len(problems)))
        if left:
            print("%s: %d rewritable site(s) in %d file(s) remain"
                  % (PROG, sum(len(e["sites"]) for e in left), len(left)))
            return 1
        print("%s: no rewritable site remains" % PROG)
        return 0

    if not args.write:
        report(files, args.quiet, "would rewrite")
        return 0

    for entry in files:
        if not entry["sites"]:
            continue
        data = read_bytes(root, entry["path"])
        new = apply(data, entry["surface"], entry["sites"])
        with open(os.path.join(root, entry["path"]), "wb") as handle:
            handle.write(new)
    report(files, args.quiet, "rewrote")
    manifest = args.manifest or os.path.join(root, "constructor-call-unparsed.json")
    with open(manifest, "w", encoding="utf-8") as handle:
        json.dump({
            "generated_by": "scripts/%s --write" % PROG,
            "parser": binary,
            "unparsed": [{"path": e["path"], "reason": e["reason"], "names": e["names"]}
                         for e in files if e["class"] == "unparsed"],
            "ambiguous": [{"path": e["path"],
                           "names": sorted({n for n, *_ in e["ambiguous"]}),
                           "sites": [{"name": n, "start": s, "why": d}
                                     for n, s, d in e["ambiguous"]]}
                          for e in files if e["class"] == "ambiguous"],
            "unknown": [{"path": e["path"], "name": n, "start": s, "why": d}
                        for e in files for n, s, d in e["unknown"]],
            "refused": [{"path": e["path"], "name": n, "start": s, "why": w}
                        for e in files for n, s, w in e["refused"]],
        }, handle, indent=2, ensure_ascii=False)
        handle.write("\n")
    print("%s: manifest %s" % (PROG, os.path.relpath(manifest, root)))
    if any(e["class"] in ("unparsed", "ambiguous") or e["refused"] for e in files):
        return 3
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
