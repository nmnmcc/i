#!/usr/bin/env python3
"""Prove the instantiated annotation templates which cannot be parsed as literals.
Snapshot with the pinned OLD parser, then verify with the NEW parser, using the
same driver path in both phases. The input file records the exact instantiated
before/after programs and their Rust hosts, including rejected calls.
"""
import argparse
import gzip
import json
from pathlib import Path
import runpy

ROOT = Path(__file__).resolve().parent.parent
M = runpy.run_path(str(ROOT / 'scripts/migrate-annotations'))
p = argparse.ArgumentParser(description=__doc__)
p.add_argument('mode', choices=['snapshot', 'verify'])
p.add_argument('--baseline', type=Path, required=True)
p.add_argument('--binary', type=Path, default=ROOT/'target/debug/examples/pattern-annotations')
p.add_argument('--report', type=Path, default=ROOT/'tests/review/annotation-template-proof.json')
a = p.parse_args()
inputs = json.loads((ROOT/'tests/review/annotation-template-inputs.json').read_text())
if a.mode == 'snapshot':
    sources = [dict(source=i['before'], lisp=False, kind='file') for i in inputs]
    results = M['parse'](sources, a.binary)
    with gzip.open(a.baseline, 'wt') as f:
        json.dump(dict(inputs=inputs, results=results), f)
    print(f'saved {len(inputs)} instantiated OLD template trees')
else:
    with gzip.open(a.baseline, 'rt') as f:
        old = json.load(f)
    assert old['inputs'] == inputs, 'template inputs changed since snapshot'
    sources = [dict(source=i['after'], lisp=False, kind='file') for i in inputs]
    results = M['parse'](sources, a.binary)
    records = []
    for item, before, after in zip(inputs, old['results'], results):
        records.append(dict(path=item['path'], name=item['name'],
                            tree_sha256=M['digest'](M['tree'](before['tree'])),
                            equal=M['tree'](before['tree']) == M['tree'](after['tree']),
                            diagnostics_equal=before['diagnostics'] == after['diagnostics']))
    differences = [i for i in records if not i['equal'] or not i['diagnostics_equal']]
    a.report.write_text(json.dumps(dict(old_parser='078107490', compared=len(records),
                                       differences=differences, entries=records), indent=2)+'\n')
    print(f'{len(records)} instantiated template trees compared; {len(differences)} differences')
    if differences:
        raise SystemExit(1)
