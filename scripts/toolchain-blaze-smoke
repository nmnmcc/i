#!/usr/bin/env python3
"""Compare Blaze with pinned Cargo in an isolated, generated Rust workspace."""

import argparse
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import time


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--keep", action="store_true", help="keep the successful fixture and logs")
    args = parser.parse_args()
    root = Path(os.environ.get("ILANG_ROOT", Path(__file__).resolve().parents[1]))
    # Blaze treats every source beneath a directory named `target` as immutable.
    # Keep fixture sources in project state so the edit checks exercise its watcher.
    state = root / ".devenv" / "state"
    state.mkdir(parents=True, exist_ok=True)
    workspace = Path(tempfile.mkdtemp(prefix="blaze-smoke-", dir=state))
    blaze = os.environ.get("ILANG_BLAZE", "blaze")
    cargo = shutil.which("cargo") or "cargo"
    base = os.environ.copy()
    cargo_env = dict(base, CARGO_TARGET_DIR=str(workspace / "target-cargo"))
    blaze_env = dict(
        base,
        BLAZE_HOME=str(workspace / ".blaze"),
        RA_JIT_CACHE=str(workspace / ".blaze" / "cache"),
    )
    blaze_env.pop("CARGO_TARGET_DIR", None)
    results = []
    started_blaze = False
    succeeded = False

    def command(label, argv, env, expected=None):
        nonlocal started_blaze
        if argv[0] == blaze:
            started_blaze = True
        print(f"{label} ...", flush=True)
        start = time.monotonic()
        result = subprocess.run(argv, cwd=workspace, env=env, capture_output=True, text=True)
        elapsed = time.monotonic() - start
        passed = result.returncode == 0 and (expected is None or result.stdout == expected)
        results.append({
            "case": label,
            "command": argv,
            "seconds": round(elapsed, 3),
            "exit_code": result.returncode,
            "passed": passed,
            "stdout": result.stdout,
            "stderr": result.stderr,
        })
        (workspace / "results.json").write_text(json.dumps(results, indent=2) + "\n")
        if not passed:
            sys.stdout.write(result.stdout)
            sys.stderr.write(result.stderr)
            if expected is not None and result.stdout != expected:
                print(f"Expected stdout: {expected!r}; received: {result.stdout!r}", file=sys.stderr)
            raise RuntimeError(f"{label} failed (exit {result.returncode})")
        print(f"  passed ({elapsed:.2f}s)", flush=True)
        return result.stdout

    def generated(value):
        (workspace / "core" / "build.rs").write_text(
            'fn main() {\n'
            '    println!("cargo:rerun-if-changed=build.rs");\n'
            '    let out = std::path::PathBuf::from(std::env::var_os("OUT_DIR").unwrap());\n'
            f'    std::fs::write(out.join("generated.rs"), "const GENERATED: i64 = {value};").unwrap();\n'
            '}\n'
        )

    def library(argument, generated_value, layout=False, feature=False, feature_enabled=True):
        fields = ", pub ready: bool" if layout else ""
        ready = ', ready: cfg!(feature = "extra")' if feature else ", ready: true" if layout else ""
        expected = {"value": argument + generated_value}
        if layout:
            expected["ready"] = feature_enabled if feature else True
        snapshot = json.dumps(expected, separators=(",", ":"))
        (workspace / "core" / "src" / "lib.rs").write_text(
            'include!(concat!(env!("OUT_DIR"), "/generated.rs"));\n'
            '#[derive(Debug, serde::Serialize)]\n'
            f'pub struct Answer<T> {{ pub value: T{fields} }}\n'
            'pub fn render() -> String {\n'
            '    let offset = GENERATED;\n'
            '    let captured = |x: i64| x + offset;\n'
            f'    serde_json::to_string(&Answer {{ value: captured({argument}){ready} }}).unwrap()\n'
            '}\n'
            '#[cfg(test)]\n'
            'mod tests {\n'
            '    #[test]\n'
            '    fn generated_and_derived() {\n'
            f'        insta::assert_snapshot!(super::render(), @r#"{snapshot}"#);\n'
            '    }\n'
            '}\n'
        )
        return snapshot + " forwarded\n"

    def blaze_round(label, expected):
        command(label + " tests", [blaze, "test", "-p", "ilang-smoke-core"], blaze_env)
        command(label + " output", [blaze, "run", "-q", "-p", "ilang-smoke-app", "--", "forwarded"], blaze_env, expected)

    try:
        for executable, prefix in [("rustc", "rustc 1.99.1 "), (cargo, "cargo 1.99.1 ")]:
            version = command(executable + " version", [executable, "--version"], cargo_env)
            if not version.startswith(prefix):
                raise RuntimeError(f"Expected {prefix.strip()}, got {version.strip()}; enter the Devenv shell")
        version = command("Blaze version", [blaze, "--version"], blaze_env)
        if not version.startswith("blaze 0.20261027.0 "):
            raise RuntimeError(f"Expected Blaze 0.20261027.0, got {version.strip()}; enter the Devenv shell")
        for package in ("core", "app"):
            (workspace / package / "src").mkdir(parents=True)
        (workspace / "Cargo.toml").write_text('[workspace]\nmembers = ["core", "app"]\nresolver = "3"\n')
        core_manifest = (
            '[package]\nname = "ilang-smoke-core"\nversion = "0.1.0"\nedition = "2024"\n'
            '[dependencies]\nserde = { version = "=1.0.229", features = ["derive"] }\n'
            'serde_json = "=1.0.154"\n[dev-dependencies]\ninsta = "=1.49.0"\n'
        )
        (workspace / "core" / "Cargo.toml").write_text(core_manifest)
        (workspace / "app" / "Cargo.toml").write_text(
            '[package]\nname = "ilang-smoke-app"\nversion = "0.1.0"\nedition = "2024"\n'
            '[dependencies]\nilang-smoke-core = { path = "../core" }\n'
        )
        (workspace / "app" / "src" / "main.rs").write_text(
            'fn main() { println!("{} {}", ilang_smoke_core::render(), std::env::args().nth(1).unwrap_or_default()); }\n'
        )
        generated(21)
        expected = library(21, 21)
        command("Cargo resolves the fixture lockfile", [cargo, "generate-lockfile"], cargo_env)
        command("Cargo baseline tests", [cargo, "test", "--locked", "--workspace"], cargo_env)
        command("Cargo baseline output", [cargo, "run", "--locked", "-q", "-p", "ilang-smoke-app", "--", "forwarded"], cargo_env, expected)
        command("Blaze selected-package build", [blaze, "build", "-p", "ilang-smoke-app"], blaze_env)
        blaze_round("Blaze baseline", expected)
        expected = library(22, 21)
        blaze_round("Function edit", expected)
        expected = library(22, 21, layout=True)
        blaze_round("Generic type layout and derive edit", expected)
        generated(22)
        expected = library(22, 22, layout=True)
        blaze_round("Build script edit", expected)
        (workspace / "core" / "Cargo.toml").write_text(core_manifest + '\n[features]\ndefault = ["extra"]\nextra = []\n')
        expected = library(22, 22, layout=True, feature=True)
        blaze_round("Manifest edit", expected)
        (workspace / "core" / "Cargo.toml").write_text(core_manifest + '\n[features]\ndefault = []\nextra = []\n')
        # Check the app before touching any Rust source: only the manifest changed.
        disabled = expected.replace('"ready":true', '"ready":false')
        command("Manifest-only feature disable output", [blaze, "run", "-q", "-p", "ilang-smoke-app", "--", "forwarded"], blaze_env, disabled)
        # The render body stays identical; only its inline test expectation changes.
        expected = library(22, 22, layout=True, feature=True, feature_enabled=False)
        command("Manifest feature disable tests", [blaze, "test", "-p", "ilang-smoke-core"], blaze_env)
        command("Stop fixture daemon", [blaze, "stop"], blaze_env)
        blaze_round("Daemon restart", expected)
        command("Cargo final tests", [cargo, "test", "--locked", "--workspace"], cargo_env)
        command("Cargo final output equals Blaze", [cargo, "run", "--locked", "-q", "-p", "ilang-smoke-app", "--", "forwarded"], cargo_env, expected)
        succeeded = True
        print("Blaze smoke passed: build scripts, derive macros, snapshots, edits, package selection, arguments and daemon restart.")
    finally:
        if started_blaze:
            subprocess.run([blaze, "stop"], cwd=workspace, env=blaze_env, timeout=30, check=False)
        if succeeded and not args.keep:
            shutil.rmtree(workspace)
        else:
            print(f"Fixture and results: {workspace}")


if __name__ == "__main__":
    try:
        main()
    except (RuntimeError, OSError, subprocess.SubprocessError) as error:
        print(f"Blaze smoke failed: {error}", file=sys.stderr)
        sys.exit(1)
