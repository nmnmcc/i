#!/usr/bin/env python3
"""Package already-built native Wleam release artifacts deterministically."""

from __future__ import annotations

import argparse
import gzip
import hashlib
import io
import json
import os
from pathlib import Path
import re
import stat
import struct
import subprocess
import sys
import tarfile
import tempfile
import tomllib


ROOT = Path(__file__).resolve().parent.parent
EXCLUDED_DIRECTORIES = {".git", ".wleam", "build", "target", "__pycache__"}


def command(*args: str) -> str:
    return subprocess.check_output(args, cwd=ROOT, text=True, stderr=subprocess.PIPE).strip()


def optional_git(*args: str) -> str | None:
    try:
        return command("git", *args)
    except (OSError, subprocess.CalledProcessError):
        return None


def elf_runtime(binary: bytes) -> dict:
    """Read the loader and runtime search paths without executing the artifact."""
    if binary[:4] != b"\x7fELF" or len(binary) < 64:
        return {}
    endian = "<" if binary[5] == 1 else ">"
    if binary[4] == 2:
        offset = struct.unpack_from(endian + "Q", binary, 32)[0]
        size, count = struct.unpack_from(endian + "HH", binary, 54)
        layout, file_offset, file_size, address, dynamic_layout = "IIQQQQQQ", 2, 5, 3, "qQ"
    else:
        offset = struct.unpack_from(endian + "I", binary, 28)[0]
        size, count = struct.unpack_from(endian + "HH", binary, 42)
        layout, file_offset, file_size, address, dynamic_layout = "IIIIIIII", 1, 4, 2, "iI"
    segments = []
    dynamic = []
    result = {}
    for index in range(count):
        header = struct.unpack_from(endian + layout, binary, offset + index * size)
        start, length = header[file_offset], header[file_size]
        segments.append((header[0], start, length, header[address]))
        if header[0] == 3:
            result["interpreter"] = binary[start : start + length].rstrip(b"\0").decode()
        if header[0] == 2:
            dynamic = list(struct.iter_unpack(endian + dynamic_layout, binary[start : start + length]))
    string_address = next((value for tag, value in dynamic if tag == 5), None)
    if string_address is not None:
        string_offset = next(start + string_address - virtual for kind, start, length, virtual in segments if kind == 1 and virtual <= string_address < virtual + length)

        def string(at: int) -> str:
            start = string_offset + at
            return binary[start : binary.index(b"\0", start)].decode()

        result["needed"] = [string(value) for tag, value in dynamic if tag == 1]
        result["search_paths"] = [path for tag, value in dynamic if tag in (15, 29) for path in string(value).split(":")]
    return result


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--binaries", type=Path, help="directory containing release wleam and wleam-runner")
    parser.add_argument("--target", help="Rust target triple; defaults to rustc's host")
    parser.add_argument("--output", type=Path, default=ROOT / "target/release", help="archive output directory")
    parser.add_argument("--nix-runtime", action="store_true", help="include the ELF Nix runtime closure and an import script")
    args = parser.parse_args()

    manifest = tomllib.loads((ROOT / "Cargo.toml").read_text())
    version = manifest["workspace"]["package"]["version"]
    rustc = command("rustc", "-vV")
    target = args.target or next(line.removeprefix("host: ") for line in rustc.splitlines() if line.startswith("host: "))
    if not all(re.fullmatch(r"[A-Za-z0-9_.+-]+", value) for value in (version, target)):
        raise ValueError("version and target must be safe archive names")
    epoch = int(os.environ.get("SOURCE_DATE_EPOCH", optional_git("show", "-s", "--format=%ct", "HEAD") or "0"))
    if not 0 <= epoch <= 0xFFFFFFFF:
        raise ValueError("SOURCE_DATE_EPOCH must be an integer between 0 and 4294967295")

    cargo_target = Path(os.environ.get("WLEAM_CARGO_TARGET_DIR", os.environ.get("CARGO_TARGET_DIR", ROOT / "target/cargo")))
    binaries = args.binaries or cargo_target / "release"
    suffix = ".exe" if "windows" in target else ""
    entries: dict[str, tuple[bytes, int]] = {}

    def add_file(source: Path, destination: str, executable: bool = False) -> None:
        if source.is_symlink() or not source.is_file():
            raise ValueError(f"required regular file is missing (or is a symlink): {source}")
        mode = source.stat().st_mode
        if executable and not mode & stat.S_IXUSR and not suffix:
            raise ValueError(f"release binary is not executable: {source}")
        entries[destination] = (source.read_bytes(), 0o755 if executable or mode & 0o111 else 0o644)

    def add_tree(source: Path, destination: str) -> None:
        if not source.is_dir():
            raise ValueError(f"required directory is missing: {source}")
        for path in sorted(source.rglob("*")):
            relative = path.relative_to(source)
            if any(part in EXCLUDED_DIRECTORIES for part in relative.parts) or path.suffix == ".pyc":
                continue
            if path.is_symlink():
                raise ValueError(f"release source must not contain symlinks: {path}")
            if path.is_file():
                add_file(path, f"{destination}/{relative.as_posix()}")

    for binary in ("wleam", "wleam-runner"):
        add_file(binaries / f"{binary}{suffix}", f"bin/{binary}{suffix}", executable=True)
    for name in ("LICENSE", "UPSTREAM.md", "README.md"):
        add_file(ROOT / name, name)
    add_file(ROOT / "vendor/gleam/LICENCE", "licenses/gleam-LICENCE")
    add_tree(ROOT / "docs", "docs")
    add_tree(ROOT / "stdlib", "share/wleam/stdlib")
    for name in ("wleam.mjs", "wleam.d.ts", "README.md"):
        add_file(ROOT / "bindings/javascript" / name, f"share/wleam/javascript/{name}")
    for name in ("Cargo.lock", "rust-toolchain.toml", "devenv.lock"):
        add_file(ROOT / name, f"share/wleam/build/{name}")

    runtimes = {name: runtime for name, (contents, _) in entries.items() if name.startswith("bin/") and (runtime := elf_runtime(contents))}
    runtime_paths = []
    if args.nix_runtime:
        roots = set()
        for runtime in runtimes.values():
            for path in [runtime.get("interpreter", ""), *runtime.get("search_paths", [])]:
                if match := re.match(r"(/nix/store/[a-z0-9]{32}-[^/]+)(?:/|$)", path):
                    roots.add(match.group(1))
        if not roots:
            raise ValueError("--nix-runtime requires ELF artifacts with Nix loader or runtime search paths")
        runtime_paths = command("nix-store", "--query", "--requisites", *sorted(roots)).splitlines()
        entries["runtime/nix-store.export"] = (subprocess.check_output(["nix-store", "--export", *runtime_paths]), 0o644)
        entries["runtime/paths.txt"] = (("\n".join(runtime_paths) + "\n").encode(), 0o644)
        entries["runtime/restore"] = (b'#!/usr/bin/env sh\nset -eu\ncd -- "$(dirname -- "$0")"\nexec nix-store --import < nix-store.export\n', 0o755)

    build = {
        "version": version,
        "target": target,
        "source_date_epoch": epoch,
        "source_commit": optional_git("rev-parse", "HEAD"),
        "packaging_rustc": rustc,
        "elf_runtime": runtimes,
        "nix_runtime_paths": runtime_paths,
        "sha256": {name: hashlib.sha256(contents).hexdigest() for name, (contents, _) in sorted(entries.items())},
    }
    entries["share/wleam/build/release.json"] = ((json.dumps(build, indent=2, sort_keys=True) + "\n").encode(), 0o644)

    name = f"wleam-{version}-{target}"
    args.output.mkdir(parents=True, exist_ok=True)
    archive = args.output / f"{name}.tar.gz"
    with tempfile.NamedTemporaryFile(dir=args.output, suffix=".partial", delete=False) as output:
        temporary = Path(output.name)
        try:
            with gzip.GzipFile(fileobj=output, mode="wb", filename="", mtime=epoch) as compressed:
                with tarfile.open(fileobj=compressed, mode="w", format=tarfile.PAX_FORMAT) as tar:
                    directories = {name}
                    for path in entries:
                        directories.update(str(parent) for parent in Path(name, path).parents if str(parent) != ".")
                    for directory in sorted(directories):
                        info = tarfile.TarInfo(directory)
                        info.type = tarfile.DIRTYPE
                        info.mode, info.mtime = 0o755, epoch
                        tar.addfile(info)
                    for path, (contents, mode) in sorted(entries.items()):
                        info = tarfile.TarInfo(f"{name}/{path}")
                        info.mode, info.mtime, info.size = mode, epoch, len(contents)
                        tar.addfile(info, io.BytesIO(contents))
            output.flush()
            os.fsync(output.fileno())
        except BaseException:
            temporary.unlink(missing_ok=True)
            raise
    temporary.replace(archive)
    checksum = hashlib.sha256(archive.read_bytes()).hexdigest()
    archive.with_suffix(archive.suffix + ".sha256").write_text(f"{checksum}  {archive.name}\n")
    print(archive)
    print(f"sha256: {checksum}")
    if any(runtime.get("interpreter", "").startswith("/nix/store/") for runtime in runtimes.values()):
        print("Native binaries use Nix runtime paths; see docs/release.md before installing on another host.")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, subprocess.CalledProcessError, StopIteration, struct.error) as error:
        print(f"dev-package: {error}", file=sys.stderr)
        sys.exit(1)
