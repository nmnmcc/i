#!/usr/bin/env bash
# Converts the whole repository to syntax three in place (docs/design/syntax-3.md
# §7.2 stage 8, §7.3): every tracked `.i` and `.is` file (lib, std, examples,
# tests, bench, editors, crates/*/tests), then the i snippets in Rust and
# JavaScript strings and Markdown fences (scripts/syn3-convert-embedded), then
# the hand rewrites (scripts/syn3-hand-rewrites).
#
#   scripts/syn3-convert-all [--since REV | --all]
#
# The conversion can run again on a newer tree: a file already in syntax three
# is left as it is (see `migrate-syntax3 convert`). Only the files changed
# since the last conversion commit (the newest commit whose subject begins
# "Convert the repository to syntax three" or "Re-run the conversion"), and new
# files, are read; this settles the few texts that both syntaxes read to
# different trees (`T = (A)` is an alias before and a labelled type after),
# because a converted file that nobody changed is not read again. `--since REV`
# names that commit; `--all` reads every file (a tree with no conversion yet).
#
# Fails (exit 1, and says which) when a file cannot be converted and is not in
# scripts/syn3-unconvertible.txt, the files that neither syntax reads (parse
# error fixtures of the syntax before syntax three). The migrator's notes go to
# target/syn3/notes.txt. The migrator is built from this repository, or taken
# from $SYN3_MIGRATE.
set -euo pipefail
repo=$(cd "$(dirname "$0")/.." && pwd)
cd "$repo"
since=$(git log -1 --format=%H -E --grep='^(Convert the repository to syntax three|Re-run the conversion)' || true)
if [ "${1:-}" = --since ]; then
	since=$2
	shift 2
elif [ "${1:-}" = --all ]; then
	since=
	shift
fi
bin=${SYN3_MIGRATE:-}
if [ -z "$bin" ]; then
	cargo build --release --locked -p ilang-syntax --features legacy --example migrate-syntax3
	bin=$repo/target/release/examples/migrate-syntax3
fi
out=$repo/target/syn3
mkdir -p "$out"
ctors=()
for d in lib std examples tests bench editors crates; do ctors+=(--ctors "$d"); done
mapfile -t files < <(git ls-files --cached --others --exclude-standard -- '*.i' '*.is' |
	grep -v '^crates/ilang-binaryen/' | sort -u)
if [ -n "$since" ]; then
	declare -A changed=()
	while IFS= read -r f; do changed[$f]=1; done < <(git diff --name-only "$since" -- '*.i' '*.is'; git ls-files --others --exclude-standard -- '*.i' '*.is')
	keep=()
	for f in "${files[@]}"; do [ -n "${changed[$f]:-}" ] && keep+=("$f"); done
	files=("${keep[@]}")
fi
"$repo/scripts/syn3-convert-embedded" --snapshot "$out/keys.json"
status=0
if [ ${#files[@]} -gt 0 ]; then
	"$bin" convert --write "${ctors[@]}" "${files[@]}" 2> "$out/notes.txt" || status=$?
fi
touch "$out/notes.txt"
tail -n 1 "$out/notes.txt"
"$repo/scripts/syn3-convert-embedded" --rekey "$out/keys.json"
# The failures that are expected: files that neither syntax reads.
sed -n 's/^\([^:]*\):\([0-9]*:\)\{0,1\} FAILED.*/\1/p' "$out/notes.txt" | sort -u > "$out/failed.txt"
grep -v '^#' "$repo/scripts/syn3-unconvertible.txt" | sed 's/ .*//' | sort -u > "$out/expected.txt"
unexpected=$(comm -23 "$out/failed.txt" "$out/expected.txt")
if [ -n "$unexpected" ]; then
	echo "syn3-convert-all: FAILED: files that cannot be converted (see target/syn3/notes.txt):" >&2
	echo "$unexpected" >&2
	grep -F -f <(echo "$unexpected") "$out/notes.txt" | grep FAILED >&2 || true
	exit 1
fi
[ "$status" = 0 ] || [ -s "$out/failed.txt" ] || exit "$status"
echo "syn3-convert-all: $(wc -l < "$out/failed.txt") files left as they are (scripts/syn3-unconvertible.txt)"
# The staged syntax-three text of the spec takes the place of the old text.
"$repo/scripts/syn3-spec-fold"
"$repo/scripts/syn3-convert-embedded" "$bin" "${ctors[@]}" 2> "$out/embedded.txt" || {
	grep FAILED "$out/embedded.txt" >&2
	exit 1
}
# The hand rewrites (§7.3) that the migrator cannot do from the text.
"$repo/scripts/syn3-hand-rewrites" "$repo"
