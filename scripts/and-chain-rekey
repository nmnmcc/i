#!/usr/bin/env python3
"""Re-key the snippet registry after the chain separator moved.

A registry entry (`scripts/check-snippets.json`, `docs/scripts/examples.json`)
is keyed `path:sha256(source)[:16]` over the snippet text its host file holds.
The `|` -> `&` migration changes bytes of such a snippet, so its key changes
and the entry, with its prefix, suffix, substitutions and recorded
diagnostics, becomes unreachable: the owner then assembles a different
program from the same source.

The correspondence is not guessed.  The OLD tree (the state before the rewrite,
`--old`) is read with its own extractor: an orphaned key is mapped only when a
snippet of that tree hashes *exactly* to it, and the same span in the new tree
differs from it in separator bytes only.  Nothing else is moved.

A substitution's *replacement* is i source too.  Its chain separators are moved
only where the OLD parser reports a separator of the assembled program
(`--parser`), one byte at a time, each flip checked by re-reading; a `|` in a
type or in a pattern stays.

    scripts/and-chain-rekey --old TREE --dry-run  [--parser PATH] [--json FILE]
    scripts/and-chain-rekey --old TREE --write    [--parser PATH] [--json FILE]

    scripts/and-chain-rekey --rename --old PRE_RENAME_TREE --dry-run|--write

`--rename` is the same rule for the rename step: an orphaned key is mapped only
when a snippet of the tree before the rename hashes exactly to it and this
tree's text is what the rename's own `edits_for` produces from that snippet.
The expected text is not re-derived by a pattern: the rename tool is imported
and asked.

Reported, never skipped silently: mapped, not related (an entry whose key was
already stale before the rewrite: `std/src/...` hosts the rename moved), and
unhandled with its reason.  Exit 2 while one entry is unhandled or an assembly
is not separator-only; only then nothing is written and no tree is called
renamed.
"""
import argparse
import hashlib
import json
import os
import subprocess
import sys
from importlib.machinery import SourceFileLoader

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
REGISTRIES = ("scripts/check-snippets.json", "docs/scripts/examples.json")


def digest(source):
    return hashlib.sha256(source.encode("utf-8", "surrogatepass")).hexdigest()[:16]


def identity(path, source):
    return path + ":" + digest(source)


def load_check(tree, tag):
    loader = SourceFileLoader("check_snippets_" + tag, os.path.join(tree, "scripts/check-snippets"))
    spec = __import__("importlib.util", fromlist=["x"]).spec_from_loader(loader.name, loader)
    module = __import__("importlib.util", fromlist=["x"]).module_from_spec(spec)
    here = os.getcwd()
    try:
        os.chdir(tree)
        loader.exec_module(module)
    finally:
        os.chdir(here)
    return module


def snippets_of(check):
    """{(path, start, end): (source, identity)} of one tree."""
    found = {}
    for item in check.snippets():
        found[(item["path"], item["start"], item["end"])] = (
            item["source"], check.identity(item["path"], item["source"]))
    return found


def assemble(entry, source):
    """The owner's assembly (prefix + source + suffix, then substitutions)."""
    text = entry.get("prefix", "") + source + entry.get("suffix", "")
    spans = []
    for index, (needle, replacement) in enumerate(entry.get("substitutions", [])):
        pieces = text.split(needle)
        if len(pieces) == 1:
            continue
        offset = 0
        built = []
        for piece in pieces[:-1]:
            built.append(piece)
            built.append(replacement)
            start = offset + len(piece)
            spans.append((index, start, start + len(replacement)))
            offset = start + len(replacement)
        built.append(pieces[-1])
        text = "".join(built)
    return text, spans


def separators(binary, text):
    request = ("normal #%d\n" % len(text.encode())).encode() + text.encode()
    done = subprocess.run([binary], input=request, capture_output=True)
    if done.returncode != 0:
        raise SystemExit("re-key: %s exited %d" % (binary, done.returncode))
    lines = done.stdout.decode().splitlines()
    if not lines or not lines[0].startswith("SNIPPET ") or "END" not in lines:
        raise SystemExit("re-key: %s did not answer the protocol" % binary)
    if not any(l.startswith("AST ") for l in lines):
        raise SystemExit("re-key: %s sent no AST line" % binary)
    return [int(l[4:]) for l in lines if l.startswith("SEP ")]


def load_rename_tool():
    """The rename tool as a module, so its own `edits_for` decides the edit."""
    loader = SourceFileLoader("repo_rename_tool", os.path.join(ROOT, "scripts/rename-std-to-i"))
    spec = __import__("importlib.util", fromlist=["x"]).spec_from_loader(loader.name, loader)
    module = __import__("importlib.util", fromlist=["x"]).module_from_spec(spec)
    here = os.getcwd()
    try:
        os.chdir(ROOT)
        loader.exec_module(module)
    finally:
        os.chdir(here)
    return module


def read_json(path):
    with open(path, encoding="utf-8") as handle:
        return json.load(handle)


def write_json(path, data):
    with open(path, "w", encoding="utf-8") as handle:
        handle.write(json.dumps(data, indent=2, ensure_ascii=False) + "\n")


def raw_snippets(check, tree):
    """The owner's extraction without the registry filter: every snippet text a
    host holds, so a key is found even when the filter would drop the literal."""
    import re as _re
    import subprocess as _sub
    paths = _sub.check_output(["git", "ls-files", "--cached", "--others", "--exclude-standard",
                               "--", "*.i", "*.md", "*.mdx", "*.rs", "*.js", "*.mjs"],
                              cwd=tree, text=True).splitlines()
    found = {}
    for path in sorted(set(paths)):
        file = os.path.join(tree, path)
        if not os.path.isfile(file):
            continue
        text = open(file, "rb").read().decode()
        if path.endswith(".i"):
            source = _re.sub(r"(?m)^// old-syntax-check:.*\n?", "", text)
            found.setdefault(path, set()).add(source)
        elif path.endswith((".md", ".mdx")):
            here = os.getcwd()
            try:
                os.chdir(tree)
                for item in check.markdown_snippets(path, text):
                    found.setdefault(path, set()).add(item["source"])
            finally:
                os.chdir(here)
        else:
            read = check.rust_strings if path.endswith(".rs") else check.js_strings
            for _start, _end, value in read(text):
                found.setdefault(path, set()).add(value)
    return found


def separator_flips(source, limit=10):
    """Every text that differs from `source` by `|` standing for `&`."""
    import itertools
    spots = [i for i, c in enumerate(source) if c == "|"]
    if not spots or len(spots) > limit:
        return None
    out = []
    for count in range(1, len(spots) + 1):
        for chosen in itertools.combinations(spots, count):
            chars = list(source)
            for i in chosen:
                chars[i] = "&"
            out.append("".join(chars))
    return out


def rename_mode(args, registries):
    """The rename's own edit, then the separator move, both checked by text.

    A key is mapped only when (1) some host text of the pre-rename tree hashes to
    it, (2) the rename tool's own `edits_for` turns that text into a text a host
    of this tree holds, and (3) where that text is not held, a `|` -> `&` variant
    of it (the separator move keeps every other byte) is.
    """
    rename = load_rename_tool()
    pre_raw = raw_snippets(load_check(args.old, "old"), args.old)
    new_raw = raw_snippets(load_check(ROOT, "new"), ROOT)
    pre_by_key = {}
    for path, sources in pre_raw.items():
        for source in sources:
            pre_by_key.setdefault(identity(path, source), (path, source))
    present = {name: set(data) for name, data in registries.items()}
    live = {name: {identity(p, s) for p, ss in new_raw.items() for s in ss if identity(p, s) in data}
            for name, data in registries.items()}

    mapped, not_related, unhandled = [], [], []
    stats = dict(entries=0, orphans=0, collision=0, unchanged=0)
    for name, data in registries.items():
        for key in list(data):
            stats["entries"] += 1
            if key in live[name]:
                continue
            stats["orphans"] += 1
            if key not in pre_by_key:
                not_related.append(dict(registry=name, key=key, path=key.rpartition(":")[0],
                                        reason="no host text of the pre-rename tree hashes to it: the entry was "
                                               "stale before this migration"))
                continue
            path, old_source = pre_by_key[key]
            expected, _edits = rename.edits_for(os.path.join(ROOT, path), old_source)
            if expected == old_source:
                stats["unchanged"] += 1
                not_related.append(dict(registry=name, key=key, path=path,
                                        reason="the rename's own edits_for leaves this text unchanged"))
                continue
            held = new_raw.get(path, set())
            new_source, flips = None, 0
            if expected in held:
                new_source = expected
            else:
                # The separator move keeps every byte and the length: a twin is a
                # text of the same host, the same length, differing in `|`/`&`
                # only.  One such text is the correspondence; two are ambiguous.
                twins = [text for text in held
                         if text != expected and len(text) == len(expected)
                         and all(a == b or (a in "|&" and b in "|&") for a, b in zip(expected, text))]
                if len(twins) == 1:
                    new_source = twins[0]
                    flips = sum(1 for a, b in zip(expected, new_source) if a != b)
                elif len(twins) > 1:
                    unhandled.append(dict(registry=name, key=key, path=path,
                                          reason="%d texts differ from the renamed one in separators only: ambiguous"
                                                 % len(twins)))
                    continue
            if new_source is None:
                unhandled.append(dict(registry=name, key=key, path=path,
                                      reason="the renamed text is not held here, nor a same-length text that "
                                             "differs in `|`/`&` only"))
                continue
            new_key = identity(path, new_source)
            if new_key in present[name]:
                stats["collision"] += 1
                unhandled.append(dict(registry=name, key=key, path=path,
                                      reason="the new key %s already exists" % new_key))
                continue
            mapped.append(dict(registry=name, path=path, old_key=key, new_key=new_key,
                               old_source=old_source, new_source=new_source,
                               renamed=expected, flips=flips, entry=data[key]))

    for m in mapped:
        entry = dict(m["entry"])
        old_text, _ = assemble(dict(entry), m["old_source"])
        new_text, _ = assemble(entry, m["new_source"])
        m["assembled"] = dict(old=old_text, new=new_text)
        if old_text == new_text:
            unhandled.append(dict(registry=m["registry"], path=m["path"], key=m["old_key"],
                                  reason="the assembly did not change although the key did"))
    needles = [(m["path"], n, m["new_source"].count(n)) for m in mapped
               for n, _ in m["entry"].get("substitutions", [])]

    print("re-key --rename: %d registry entr%s; %d orphaned"
          % (stats["entries"], "y" if stats["entries"] == 1 else "ies", stats["orphans"]))
    print("  mapped: %d" % len(mapped))
    print("  not related (stale before this migration): %d (unchanged by the rename %d)"
          % (len(not_related), stats["unchanged"]))
    print("  unhandled: %d (collision %d)" % (len(unhandled), stats["collision"]))
    print("  substitution needles: %d, of which 0 matches: %d"
          % (len(needles), sum(1 for _, _, n in needles if n == 0)))
    for m in mapped:
        print("  MAP %s  %s -> %s  (separator flips in the renamed text: %d)"
              % (m["path"], m["old_key"].rpartition(":")[2], m["new_key"].rpartition(":")[2], m["flips"]))
        print("      fields carried over: %s" % ", ".join(sorted(m["entry"])))
        for needle, replacement in m["entry"].get("substitutions", []):
            print("      substitution %r -> %r : %d needle match(es)"
                  % (needle, replacement[:40], m["new_source"].count(needle)))
        print("      text %d -> %d bytes by the rename's own edits_for%s"
              % (len(m["old_source"]), len(m["renamed"]),
                 ", then a `|`->`&` variant" if m["flips"] else ""))
        print("      assembled: %d -> %d bytes" % (len(m["assembled"]["old"]), len(m["assembled"]["new"])))
    for r in not_related:
        print("  NOT-RELATED %s %s : %s" % (r["path"], r["key"].rpartition(":")[2], r["reason"]))
    for u in unhandled:
        print("  UNHANDLED %s %s : %s" % (u["path"], u.get("key", "").rpartition(":")[2], u["reason"]))

    if args.json:
        with open(args.json, "w", encoding="utf-8") as handle:
            json.dump(dict(mode="rename", stats=stats, mapped=[dict(
                registry=m["registry"], path=m["path"], old_key=m["old_key"], new_key=m["new_key"],
                fields=sorted(m["entry"]),
                substitutions=[dict(needle=n, replacement=r, matches=m["new_source"].count(n))
                               for n, r in m["entry"].get("substitutions", [])],
                text_bytes=[len(m["old_source"]), len(m["renamed"]), len(m["new_source"])],
                separator_variant=m["flips"] > 0,
                assembled_bytes=[len(m["assembled"]["old"]), len(m["assembled"]["new"])],
                old_source=m["old_source"], renamed_source=m["renamed"], new_source=m["new_source"])
                for m in mapped], not_related=not_related, unhandled=unhandled), handle, indent=1)
            handle.write("\n")

    if unhandled:
        print("re-key --rename: %d unhandled: nothing is written" % len(unhandled))
        return 2
    if not args.write:
        print("re-key --rename: dry run (nothing written)")
        return 0
    for name, data in registries.items():
        mine = [m for m in mapped if m["registry"] == name]
        if not mine:
            continue
        for m in mine:
            entry = data.pop(m["old_key"])
            data[m["new_key"]] = entry
        write_json(os.path.join(ROOT, name), data)
        print("re-key --rename: wrote %s (%d entr%s)" % (name, len(mine), "y" if len(mine) == 1 else "ies"))
    return 0


def main(argv):
    parser = argparse.ArgumentParser(prog="and-chain-rekey", description=__doc__.splitlines()[0])
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--dry-run", action="store_true", help="report the mapping (default)")
    mode.add_argument("--write", action="store_true", help="move the entries")
    parser.add_argument("--old", metavar="TREE", required=True,
                        help="the tree before the rewrite (its own extractor is used)")
    parser.add_argument("--json", metavar="FILE", help="the mapping and the report as JSON")
    parser.add_argument("--parser", metavar="PATH", default=os.environ.get("I_CHAIN_SEPARATORS"),
                        help="the OLD chain-separators binary (default $I_CHAIN_SEPARATORS)")
    parser.add_argument("--no-replacements", action="store_true",
                        help="do not move the separators inside substitution replacements")
    parser.add_argument("--rename", action="store_true",
                        help="map the entries the std/ -> i/ rename orphaned, by the rename tool's own edits_for")
    parser.add_argument("--mid", metavar="TREE",
                        help="with --rename: the tree after the rename and before the separator move")
    args = parser.parse_args(argv)

    old_items = snippets_of(load_check(args.old, "old"))
    new_items = snippets_of(load_check(ROOT, "new"))
    old_by_path = {}
    for (path, start, end), (source, key) in old_items.items():
        old_by_path.setdefault(path, []).append((start, end, source, key))
    new_by_key = {}
    for (path, start, end), (source, key) in new_items.items():
        new_by_key.setdefault((path, start, end), (source, key))

    registries = {name: read_json(os.path.join(ROOT, name)) for name in REGISTRIES}
    if args.rename:
        return rename_mode(args, registries)
    present = {name: set(data) for name, data in registries.items()}
    live = {name: {kv[1] for kv in new_by_key.values() if kv[1] in data} for name, data in registries.items()}

    mapped, not_related, unhandled = [], [], []
    stats = dict(entries=0, orphans=0, replaced=0, source_mismatch=0)

    for name, data in registries.items():
        for key in data:
            stats["entries"] += 1
            if key in live[name]:
                continue  # still reachable: not an orphan
            stats["orphans"] += 1
            path, _, dig = key.rpartition(":")
            hits = [h for h in old_by_path.get(path, []) if h[3] == key]
            if not hits:
                not_related.append(dict(registry=name, key=key, path=path,
                                        reason="no snippet of the OLD tree hashes to it: its key was stale "
                                               "before the separator move (the rename moved those bytes)"))
                continue
            start, end, old_source, _ = hits[0]
            if (path, start, end) not in new_by_key:
                unhandled.append(dict(registry=name, key=key, path=path,
                                      reason="the OLD tree has the snippet at %d..%d, the new tree has no "
                                             "snippet there" % (start, end)))
                continue
            new_source, new_key = new_by_key[(path, start, end)]
            diff = [i for i in range(min(len(old_source), len(new_source)))
                    if old_source[i] != new_source[i]]
            separator_only = len(old_source) == len(new_source) and all(
                (old_source[i], new_source[i]) in (("|", "&"), ("&", "|")) for i in diff)
            if not separator_only:
                stats["source_mismatch"] += 1
                unhandled.append(dict(registry=name, key=key, path=path,
                                      reason="the same span differs by more than separators"))
                continue
            if new_key in present[name]:
                stats["replaced"] += 1
                unhandled.append(dict(registry=name, key=key, path=path,
                                      reason="the new key %s already exists" % new_key))
                continue
            mapped.append(dict(registry=name, path=path, start=start, end=end,
                               old_key=key, new_key=new_key, old_source=old_source,
                               new_source=new_source, entry=data[key], source_diff=diff))

    for m in mapped:
        entry = dict(m["entry"])
        subs = [list(s) for s in entry.get("substitutions", [])]
        flips = []
        if args.parser and not args.no_replacements and any("|" in r for _, r in subs):
            if not os.path.isfile(args.parser):
                raise SystemExit("re-key: no parser at %s" % args.parser)
            current, spans = assemble(dict(entry, substitutions=[tuple(s) for s in subs]), m["old_source"])
            sep = separators(args.parser, current)
            for index, start, end in spans:
                for p in [x for x in sep if start <= x < end]:
                    local = p - start
                    if subs[index][1][local:local + 1] != "|":
                        continue
                    trial = list(subs[index][1])
                    trial[local] = "&"
                    candidate = [tuple(s) for s in subs]
                    candidate[index] = (subs[index][0], "".join(trial))
                    text, _ = assemble(dict(entry, substitutions=candidate), m["old_source"])
                    if p in separators(args.parser, text):
                        continue
                    subs[index][1] = "".join(trial)
                    flips.append((subs[index][0], p, local))
                    current, _ = assemble(dict(entry, substitutions=[tuple(s) for s in subs]), m["old_source"])
                    sep = separators(args.parser, current)
        m["substitutions"] = subs
        m["flips"] = flips

    for m in mapped:
        entry = dict(m["entry"])
        entry["substitutions"] = m["substitutions"]
        old_text, _ = assemble(dict(m["entry"]), m["old_source"])
        new_text, _ = assemble(entry, m["new_source"])
        diff = [i for i in range(min(len(old_text), len(new_text))) if old_text[i] != new_text[i]]
        authorised = len(old_text) == len(new_text) and all(
            (old_text[i], new_text[i]) in (("|", "&"), ("&", "|")) for i in diff)
        m["assembled"] = dict(old=old_text, new=new_text, diff=diff, authorised=authorised)
        if not authorised:
            unhandled.append(dict(registry=m["registry"], path=m["path"], key=m["old_key"],
                                  reason="the new assembly differs by more than separators"))

    needle_misses = [(m["path"], n) for m in mapped for n, _ in m["substitutions"]
                     if m["new_source"].count(n) == 0]

    print("re-key: %d registry entr%s; %d orphaned by the separator move and here"
          % (stats["entries"], "y" if stats["entries"] == 1 else "ies", stats["orphans"]))
    print("  mapped: %d" % len(mapped))
    print("  not related (already stale before the move): %d" % len(not_related))
    print("  unhandled: %d (collision %d, span/source mismatch %d)"
          % (len(unhandled), stats["replaced"], stats["source_mismatch"]))
    print("  substitution needles that match 0 times in the new source: %d" % len(needle_misses))
    for path, needle in needle_misses:
        print("    %s needle %r" % (path, needle))
    for m in mapped:
        print("  MAP %s@%d..%d  %s -> %s  (%d separator byte(s) in the snippet)"
              % (m["path"], m["start"], m["end"], m["old_key"].rpartition(":")[2],
                 m["new_key"].rpartition(":")[2], len(m["source_diff"])))
        print("      fields carried over: %s" % ", ".join(sorted(m["entry"])))
        for needle, replacement in m["substitutions"]:
            print("      substitution %r -> %r : %d needle match(es)"
                  % (needle, replacement[:40], m["new_source"].count(needle)))
        for needle, offset, local in m["flips"]:
            print("      replacement of %r: assembly byte %d `|` -> `&`, named by the old parser"
                  % (needle, offset))
        a = m["assembled"]
        print("      assembled %d -> %d bytes, %d differing byte(s), separator only: %s"
              % (len(a["old"]), len(a["new"]), len(a["diff"]), a["authorised"]))
    for r in not_related:
        print("  NOT-RELATED %s %s : %s" % (r["path"], r["key"].rpartition(":")[2], r["reason"]))
    for u in unhandled:
        print("  UNHANDLED %s %s : %s" % (u["path"], u.get("key", "").rpartition(":")[2], u["reason"]))

    if args.json:
        with open(args.json, "w", encoding="utf-8") as handle:
            json.dump(dict(stats=stats, mapped=[dict(
                registry=m["registry"], path=m["path"], start=m["start"], end=m["end"],
                old_key=m["old_key"], new_key=m["new_key"], fields=sorted(m["entry"]),
                substitutions=[dict(needle=n, replacement=r, matches=m["new_source"].count(n))
                               for n, r in m["substitutions"]],
                flips=[dict(needle=n, assembly_offset=o, replacement_offset=l) for n, o, l in m["flips"]],
                source_diff=m["source_diff"],
                assembled=dict(old_bytes=len(m["assembled"]["old"]), new_bytes=len(m["assembled"]["new"]),
                               differing=m["assembled"]["diff"], separator_only=m["assembled"]["authorised"]),
                old_assembled=m["assembled"]["old"], new_assembled=m["assembled"]["new"]) for m in mapped],
                not_related=not_related, unhandled=unhandled), handle, indent=1)
            handle.write("\n")

    if unhandled:
        print("re-key: %d unhandled: nothing is written, no tree is called renamed" % len(unhandled))
        return 2
    if not args.write:
        print("re-key: dry run (nothing written)")
        return 0
    for name, data in registries.items():
        mine = [m for m in mapped if m["registry"] == name]
        if not mine:
            continue
        for m in mine:
            entry = data.pop(m["old_key"])
            entry["substitutions"] = m["substitutions"]
            data[m["new_key"]] = entry
        write_json(os.path.join(ROOT, name), data)
        print("re-key: wrote %s (%d entr%s)" % (name, len(mine), "y" if len(mine) == 1 else "ies"))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
