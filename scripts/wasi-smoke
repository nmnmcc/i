#!/usr/bin/env bash
# Runs WASI-target builds (spec B.7) in a stock Wasmtime and in Node's
# node:wasi, with no flags, and checks their output and exit codes.
set -euo pipefail
i="$1"
root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
mkdir -p "$work/stop/src"
printf 'name = "stop"\n' >"$work/stop/i.toml"
printf '@main\nmain = () { assert(1 + 1 == 3) }\n' >"$work/stop/src/main.i"
cat >"$work/node-wasi.mjs" <<'JS'
import { readFile } from "node:fs/promises";
import { WASI } from "node:wasi";
const wasi = new WASI({ version: "preview1", args: [], returnOnExit: true });
const module = await WebAssembly.compile(await readFile(process.argv[2]));
const instance = await WebAssembly.instantiate(module, wasi.getImportObject());
process.exitCode = wasi.start(instance);
JS

expect() { # what, want stdout, want stderr, want code, command...
  local what="$1" out="$2" err="$3" code="$4"
  shift 4
  local got=0
  "$@" >"$work/out" 2>"$work/err" || got=$?
  if [[ "$(cat "$work/out")" != "$out" || "$got" != "$code" ]] ||
    { [[ -n "$err" ]] && ! grep -qF -- "$err" "$work/err"; }; then
    echo "wasi-smoke: $what failed (exit $got)" >&2
    cat "$work/out" "$work/err" >&2
    exit 1
  fi
}

for level in 0 2; do
  "$i" build --project "$root/examples/hello" --target wasi --opt "$level" --out "$work/hello.wasm"
  "$i" build --project "$work/stop" --target wasi --opt "$level" --out "$work/stop.wasm"
  for runner in "${WASMTIME:-wasmtime} run" "node --no-warnings $work/node-wasi.mjs"; do
    # shellcheck disable=SC2086
    expect "hello ($runner, O$level)" "Hello from i!" "" 0 $runner "$work/hello.wasm"
    # shellcheck disable=SC2086
    expect "stop ($runner, O$level)" "" "assertion failed: assert" 1 $runner "$work/stop.wasm"
  done
done
echo "wasi-smoke: ok"
