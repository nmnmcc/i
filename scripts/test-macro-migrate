#!/usr/bin/env python3
"""Rewrite legacy test attributes using parser spans, preserving untouched text."""
import argparse
import runpy
import textwrap
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tomllib

ROOT = Path(__file__).resolve().parent.parent
BINARY = Path(os.environ.get('CARGO_TARGET_DIR', ROOT / 'target')) / 'debug/migrate-tests'


def package_of(path):
    for parent in path.resolve().parents:
        if (parent / 'i.toml').is_file():
            return parent
    return None


def rewrite(source, result):
    data = source.encode()
    edits = []
    for test in result['tests']:
        name = test['name']
        a, b = test['attr_start'], test['attr_end']
        start, end = test['binding_start'], test['binding_end']
        value_start, value_end = test['value_start'], test['value_end']
        edits.append((a, b, b''))
        if test['referenced'] or b'AssertionFailure(' in data[value_start:value_end]:
            edits.append((end, end, f'\n\ntest({json.dumps(name)}, () {{ {name}() }})'.encode()))
        else:
            edits.append((start, value_start, f'test({json.dumps(name)}, '.encode()))
            edits.append((value_end, value_end, b')'))
    imports = result['imports']
    if not result['has_test_import']:
        if imports:
            edits.append((imports[0] + 1, imports[0] + 1, b'\n\ttestlib = (test) = std/test\n\t'))
        else:
            prefix = re.match(r'(?:(?:[ \t]*//[^\n]*|[ \t]*)\n)*', source).group()
            at = len(prefix.encode())
            edits.append((at, at, b'(testlib = (test) = std/test)\n\n'))
    for start, end, replacement in sorted(edits, reverse=True):
        data = data[:start] + replacement + data[end:]
    return data.decode()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--embedded', action='store_true', help='also rewrite Rust/JS literals and Markdown i fences')
    parser.add_argument('--standalone', action='store_true', help='allow standalone editor/parser fixtures without a manifest')
    parser.add_argument('paths', nargs='+', type=Path)
    args = parser.parse_args()
    if not BINARY.exists() or BINARY.stat().st_mtime < (ROOT / 'crates/ilang-syntax/examples/legacy/migrate-tests.rs').stat().st_mtime:
        heavy, shell = ROOT.parent / 'cache/heavy', ROOT.parent.parent
        if not heavy.is_file():
            heavy, shell = ROOT / '.rd/cache/heavy', ROOT
        subprocess.run([str(heavy), 'direnv', 'exec', str(shell),
                        'cargo', 'build', '--manifest-path', str(ROOT / 'crates/ilang-syntax/examples/legacy/Cargo.toml'), '--bin', 'migrate-tests', '--target-dir', str(BINARY.parent.parent), '--locked'], cwd=ROOT, check=True)
    extract = runpy.run_path(str(ROOT / 'scripts/check-snippets'))
    allowed = {'.i', '.is'} | ({'.rs', '.js', '.mjs', '.md', '.txt'} if args.embedded else set())
    files = sorted({f for p in args.paths for f in (p.rglob('*') if p.is_dir() else [p])
                    if f.suffix in allowed and f.is_file()
                    and not {'target', 'node_modules', '.git'}.intersection(f.parts)})
    snippets = []
    for path in files:
        host = path.read_text()
        if path.suffix in {'.i', '.is'}:
            snippets.append((path, host, 0, len(host), host, 'file', False, ''))
        elif path.suffix == '.md':
            for m in re.finditer(r'(?m)^([ \t]*)```i[^\n]*\n(.*?)^\1```[ \t]*$', host, re.S):
                source = textwrap.dedent(m[2])
                snippets.append((path, host, m.start(2), m.end(2), source, 'markdown', False, m[1]))
        elif path.suffix == '.txt':
            # Tree-sitter corpus sections have source followed by a tree.
            for m in re.finditer(r'(?m)^={3,}\n[^\n]*\n={3,}\n(.*?)^-{3,}\n', host, re.S):
                snippets.append((path, host, m.start(1), m.end(1), m[1], 'corpus', False, ''))
        else:
            read = extract['rust_strings'] if path.suffix == '.rs' else extract['js_strings']
            for start, end, value in read(host):
                formatted = path.suffix == '.rs' and bool(re.search(r'format!\(\s*$', host[max(0, start-100):start]))
                source = value.replace('{{', '{').replace('}}', '}') if formatted else value
                snippets.append((path, host, start, end, source, 'embedded', formatted, ''))
    snippets = [s for s in snippets if re.search(r'(?m)^\s*@test\b', s[4])
                and 'test-macro-migrate: reject' not in s[4]
                and re.search(r'(?s)@test\b.*?=', s[4])]
    process = subprocess.run([str(BINARY)], input=''.join(json.dumps(re.sub(r'\{([a-z_]\w*)\}', lambda m: m[1] + '__', s[4]) if s[6] else s[4], ensure_ascii=False) + '\n' for s in snippets), text=True, capture_output=True, check=True)
    results = [json.loads(line) for line in process.stdout.splitlines()]
    assert len(results) == len(snippets), 'parser result count mismatch'
    failures, packages, count, changes = [], {}, 0, {}
    classifications = ROOT / 'scripts/check-snippets.json'
    config = json.loads(classifications.read_text())
    for (path, host, start, end, source, kind, formatted, indent), result in zip(snippets, results):
        label = f'{path}:{host[:start].count(chr(10)) + 1}'
        if 'error' in result:
            failures.append(f'{label}: {result["error"]}')
            continue
        if not result['tests']:
            continue
        if result['test_name_taken'] or (result['has_test_import'] and not re.search(r'\(test(?:[,)]|\s)', source)):
            failures.append(f'{label}: existing test name or std/test import requires review')
            continue
        package = package_of(path) if kind == 'file' else None
        if kind == 'file' and package is None and not args.standalone and not re.search(r'(?m)^// spec:', source):
            failures.append(f'{label}: no package manifest')
            continue
        rewritten = rewrite(source, result)
        replacement = rewritten
        if kind == 'embedded':
            if formatted:
                replacement = replacement.replace('{', '{{').replace('}', '}}')
                for placeholder in re.findall(r'(?<!\{)\{([a-z_]\w*)\}(?!\})', source):
                    replacement = replacement.replace('{{' + placeholder + '}}', '{' + placeholder + '}')
            literal = host[start:end]
            if path.suffix == '.rs' and literal.startswith('r'):
                hashes = re.match(r'r(#+)?"', literal)[1] or ''
                replacement = 'r' + hashes + '"' + replacement + '"' + hashes
            elif path.suffix in {'.js', '.mjs'} and literal.startswith('`'):
                replacement = '`' + replacement.replace('\\', '\\\\').replace('`', '\\`').replace('${', '\\${') + '`'
            else:
                replacement = json.dumps(replacement, ensure_ascii=False)
        elif kind == 'markdown':
            replacement = textwrap.indent(replacement, indent)
        changes.setdefault(path, []).append((start, end, replacement))
        if kind == 'file' and package is not None:
            source_module = path.resolve().is_relative_to(package / 'src')
            packages[package] = packages.get(package, False) or source_module
        relative = str(path.resolve().relative_to(ROOT)) if path.resolve().is_relative_to(ROOT) else None
        if relative:
            original = source.replace('{', '{{').replace('}', '}}') if formatted else source
            new = rewritten.replace('{', '{{').replace('}', '}}') if formatted else rewritten
            old_key = extract['identity'](relative, original)
            if old_key in config:
                config[extract['identity'](relative, new)] = config.pop(old_key)
        count += len(result['tests'])
    for path, edits in changes.items():
        host = path.read_text()
        for start, end, replacement in sorted(edits, reverse=True):
            host = host[:start] + replacement + host[end:]
        path.write_text(host)
    classifications.write_text(json.dumps(config, indent=2, ensure_ascii=False) + '\n')
    for package, source_module in packages.items():
        manifest = package / 'i.toml'
        text = manifest.read_text()
        manifest_data = tomllib.loads(text)
        if manifest_data.get('name') != 'std' and 'std' not in manifest_data.get('dependencies', {}) and (source_module or 'std' not in manifest_data.get('dev-dependencies', {})):
            relative = os.path.relpath(ROOT / 'std', package)
            dev_std = re.search(r'(?m)^std\s*=.*$', text) if 'std' in manifest_data.get('dev-dependencies', {}) else None
            dependency = (dev_std.group() + '\n') if dev_std else f'std = {{ path = {json.dumps(relative)} }}\n'
            table = 'dependencies' if source_module else 'dev-dependencies'
            if dev_std:
                text = text[:dev_std.start()] + text[dev_std.end():]
            section = re.search(r'(?m)^\[' + table + r'\][^\n]*\n', text)
            if section:
                text = text[:section.end()] + dependency + text[section.end():]
            else:
                text += '\n[' + table + ']\n' + dependency
        existing = manifest_data.get('test', {})
        if 'collection' in existing:
            if existing['collection'] != 'std/test.tests':
                failures.append(f'{manifest}: existing collection needs review')
            manifest.write_text(text)
            continue
        section = re.search(r'(?m)^\[test\][^\n]*\n', text)
        if section:
            text = text[:section.end()] + 'collection = "std/test.tests"\n' + text[section.end():]
        else:
            text += '\n[test]\ncollection = "std/test.tests"\n'
        manifest.write_text(text)
    print(f'{count} tests migrated in {len(packages)} packages')
    for failure in failures:
        print(failure, file=sys.stderr)
    return bool(failures)


if __name__ == '__main__':
    sys.exit(main())
