#!/usr/bin/env bash
# Checks the project: the local entry to what CI runs. The parts are
# independent, so CI runs them as parallel jobs; with no arguments, all of
# them run one after another.
#
#   scripts/checks            rust, i, js and editors
#   scripts/checks rust       Rust formatting, Clippy, snippets and the workspace tests
#                             (rust-lint: formatting, Clippy and snippets; rust-test: the tests)
#   scripts/checks snippets   every i snippet in the repository parses, or gives its registered
#                             diagnostics (scripts/check-snippets and its own tests), then the
#                             documentation checks doc-paths and no-compat, so a change that
#                             only touches documentation runs them too
#   scripts/checks doc-paths  every source path and library module the documentation
#                             names exists (scripts/check-doc-paths and
#                             scripts/check-doc-modules, with their counterexamples)
#   scripts/checks no-compat  no output fixture, spec expectation or user documentation page
#                             says how things used to be (scripts/check-no-compat and its
#                             counterexamples)
#   scripts/checks i          the release `i`, and with it the i sources;
#                             `scripts/dev-new-machine` proves that a copy of
#                             that `i` still makes, checks, runs and tests a
#                             package on a machine without the source tree,
#                             including README's first two examples. It needs
#                             unprivileged user namespaces or passwordless
#                             sudo, and fails without either;
#                             CHECKS_SKIP_NEW_MACHINE=1 skips it, which
#                             is an error in CI
#   scripts/checks editors    VS Code tests, tree-sitter tests and Zed build
#   scripts/checks js         the JavaScript SDK and browser tests
#
# For CI, which builds once and splits the slow sets into shards:
#   CHECKS_I_BINARY=path      the i part uses this `i` instead of building it
#   CHECKS_SKIP_CORPUS=1      the i part leaves out the review corpus
#   CHECKS_I_WORKERS=n|auto   passed to `i test --workers` (unset: the CLI default)
#   CHECKS_SHARD=k/n          the i part runs only shard k of n of the review corpus
#                             (scripts/review-corpus run --shard k/n); unset, the whole corpus
#   CHECKS_TEST_GROUP=...     rust-test runs one group of the tests (see rust-test below);
#                             `targets` runs exactly the targets in CHECKS_TEST_TARGETS
#   CHECKS_TEST_TARGETS=...   for CHECKS_TEST_GROUP=targets: `<crate>:<target>` words,
#                             crate ilang-check or ilang-cli; target `lib`, `bin`, `doc`,
#                             or the name of a file of the crate's tests/
#   CHECKS_BUDGET=seconds     the time budget of one shard, exported for the shard tooling
#                             (i-shard --budget); default 270
#
# These parts are every test suite of the repository. Where each suite runs:
#   tests/spec/**                 spec cases with their header        rust-test (ilang-cli --test spec)
#   crates/*/tests, #[test]       per-crate Rust tests and fixtures   rust-test
#   tests/perf/many-tests, tests/r2-performance, tests/r2-examples,
#   tests/t1-blockers             fixtures of ilang-cli/ilang-check tests   rust-test
#   tests/review/cases/**         review corpus, expected.json and the
#                                 known failures in requirements.json  i (scripts/review-corpus run)
#   lib, stdlib, bench, examples  i tests at --opt 0 and 2, formatting i
#   scripts/qa/generate.py        generated programs                   i (scripts/test-generation)
#   i snippets in .i/.rs/.js/.md  scripts/check-snippets               snippets
#   bindings/javascript, tests/browser                                 js
#   editors/**                                                         editors
# Measurements and one-off comparisons, not suites: scripts/bench, scripts/checker-bench,
# tests/perf/numeric, tests/t1/*, tests/r2-*.py. tests/syn3/services (expected.txt) is run
# by `cargo test -p ilang-cli --test syn3_fixtures` with the default parser.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
export CHECKS_BUDGET="${CHECKS_BUDGET:-270}"

binaryen() {
  git submodule update --init crates/ilang-binaryen/binaryen
}

rust() {
  rust-lint
  rust-test
}

rust-lint() {
  binaryen
  cargo fmt --all -- --check
  cargo clippy --workspace --all-targets --locked -- -D warnings
  snippets
}

snippets() {
  scripts/check-snippets # builds the parser driver that its tests use
  python3 -I scripts/check-snippets-test
  doc-paths
  no-compat
}

doc-paths() {
  python3 -I scripts/check-doc-paths
  python3 -I scripts/check-doc-paths-test
  python3 -I scripts/check-doc-modules
  python3 -I scripts/check-doc-modules-test
  if [[ -n "${I_BIN:-}" || -x target/release/i ]]; then
    python3 -I scripts/check-doc-examples
    python3 -I scripts/check-doc-examples-test
  fi
}

no-compat() {
  python3 -I scripts/check-no-compat
  python3 -I scripts/check-no-compat-test
}

# The slowest test targets of ilang-cli, which CI runs in a job of their own (cli-heavy);
# together they take about as long as the rest of the group cli. A new target goes to cli.
CLI_HEAVY_TESTS=(package_commands value_type_performance many_tests macro_budget collections r2_runtime http)

# CHECKS_TEST_GROUP splits the tests for CI, where one job would take close to an hour.
# Each group is one CI job, named by the test sets it runs:
#   check-heavy  test (ilang-check, value types)  ilang-check's value_types, about half of its time
#   check        test (ilang-check, other)        the rest of ilang-check
#   spec         (no job)                         the whole spec suite
#   spec-K/N     test (spec, K/N)                 the K-th of N shards of the spec suite
#   cli-heavy    test (ilang-cli, slow)           the targets in CLI_HEAVY_TESTS
#   cli          test (ilang-cli, other)          the other tests of ilang-cli
#   rest         test (workspace, other crates)   every other crate
#   targets      (planned shards)                 the targets in CHECKS_TEST_TARGETS
# Unset: all of them.
#
# CHECKS_TEST_TARGETS is a list of `<crate>:<target>` words, the units of a shard that
# i-shard planned from ci/costs.json. The crate is ilang-check or ilang-cli; the target
# `lib` runs --lib, `bin` (or `bin:<name>`) --bins, `doc` the doc tests, and any other
# `<name>` (or `test:<name>`) --test <name>. Each crate gets one `cargo test --no-fail-fast`
# with its targets in the order given (and its doc tests after it, which cargo cannot run
# in the same invocation); the crates run in the order they first appear.
test-targets() {
  local words=() word crate target
  read -r -a words <<<"${CHECKS_TEST_TARGETS:-}"
  if [[ ${#words[@]} -eq 0 ]]; then
    echo "checks: CHECKS_TEST_GROUP=targets needs CHECKS_TEST_TARGETS, a list of <crate>:<target>" >&2
    exit 2
  fi
  local crates=() check_args=() cli_args=() check_doc=0 cli_doc=0
  for word in "${words[@]}"; do
    crate="${word%%:*}"
    target="${word#*:}"
    if [[ "$word" != *:* || -z "$target" ]]; then
      echo "checks: '$word' in CHECKS_TEST_TARGETS is not <crate>:<target>" >&2
      exit 2
    fi
    case "$crate" in
      ilang-check | ilang-cli) ;;
      *) echo "checks: unknown crate '$crate' in CHECKS_TEST_TARGETS (ilang-check or ilang-cli)" >&2; exit 2 ;;
    esac
    [[ " ${crates[*]-} " == *" $crate "* ]] || crates+=("$crate")
    local args=()
    case "$target" in
      lib) args=(--lib) ;;
      bin | bin:*) args=(--bins) ;;
      doc) if [[ "$crate" = ilang-check ]]; then check_doc=1; else cli_doc=1; fi ;;
      test:*) args=(--test "${target#test:}") ;;
      *) args=(--test "$target") ;;
    esac
    if [[ "$crate" = ilang-check ]]; then check_args+=("${args[@]}"); else cli_args+=("${args[@]}"); fi
  done
  local status=0
  for crate in "${crates[@]}"; do
    if [[ "$crate" = ilang-check ]]; then
      [[ ${#check_args[@]} -eq 0 ]] || cargo test -p ilang-check --locked --no-fail-fast "${check_args[@]}" || status=1
      [[ $check_doc = 0 ]] || cargo test -p ilang-check --locked --no-fail-fast --doc || status=1
    else
      [[ ${#cli_args[@]} -eq 0 ]] || cargo test -p ilang-cli --locked --no-fail-fast "${cli_args[@]}" || status=1
      [[ $cli_doc = 0 ]] || cargo test -p ilang-cli --locked --no-fail-fast --doc || status=1
    fi
  done
  return "$status"
}

rust-test() {
  binaryen
  case "${CHECKS_TEST_GROUP:-}" in
    "") cargo test --workspace --locked ;;
    targets) test-targets ;;
    check-heavy) cargo test -p ilang-check --locked --test value_types ;;
    check)
      # Every target of ilang-check but value_types, which is check-heavy.
      targets=(--lib)
      for file in crates/ilang-check/tests/*.rs; do
        name="$(basename "$file" .rs)"
        [ "$name" = value_types ] || targets+=(--test "$name")
      done
      cargo test -p ilang-check --locked --no-fail-fast "${targets[@]}"
      cargo test -p ilang-check --locked --doc
      ;;
    spec) cargo test -p ilang-cli --locked --test spec ;;
    spec-*/*) I_SPEC_SHARD="${CHECKS_TEST_GROUP#spec-}" cargo test -p ilang-cli --locked --test spec ;;
    cli-heavy)
      targets=()
      for name in "${CLI_HEAVY_TESTS[@]}"; do targets+=(--test "$name"); done
      cargo test -p ilang-cli --locked --no-fail-fast "${targets[@]}"
      ;;
    cli)
      targets=()
      for file in crates/ilang-cli/tests/*.rs; do
        name="$(basename "$file" .rs)"
        [ "$name" = spec ] && continue
        [[ " ${CLI_HEAVY_TESTS[*]} " == *" $name "* ]] && continue
        targets+=(--test "$name")
      done
      cargo test -p ilang-cli --locked --no-fail-fast --bins "${targets[@]}"
      ;;
    rest) cargo test --workspace --exclude ilang-cli --exclude ilang-check --locked ;;
    *) echo "checks: unknown CHECKS_TEST_GROUP '$CHECKS_TEST_GROUP'" >&2; exit 2 ;;
  esac
}

i() {
  local i example manifest first=1
  if [[ -n "${CHECKS_SHARD:-}" && ! "$CHECKS_SHARD" =~ ^[1-9][0-9]*/[1-9][0-9]*$ ]]; then
    echo "checks: CHECKS_SHARD must be k/n, not '$CHECKS_SHARD'" >&2
    exit 2
  fi
  # CHECKS_I_PROJECTS comes from the plan: keys <project>@<opt> of the set
  # std-tests. The parts that are not a project run once, in the first shard.
  if [[ -n "${CHECKS_I_SHARD:-}" && "${CHECKS_I_SHARD%%/*}" != 1 ]]; then
    first=0
  fi
  if [[ -n "${CHECKS_I_BINARY:-}" ]]; then
    i="$(realpath "$CHECKS_I_BINARY")"
  else
    binaryen
    cargo build --release --locked -p ilang-cli
    i="$(realpath "${CARGO_TARGET_DIR:-target}")/release/i"
  fi
  # The library's own types, before the long tests. `i fmt` only parses and
  # prints, so a type error in lib/ or stdlib/ would otherwise show up after
  # minutes of tests; this keeps it to the file, line and column it is.
  if (( first )); then
    echo "checks: i check --project stdlib"
    "$i" check --project stdlib
  fi
  if (( first )); then
    "$i" fmt --check lib stdlib bench examples
    # Every example with an `i.toml` must type check on its own.
    for manifest in examples/*/i.toml; do
      example="$(dirname "$manifest")"
      echo "checks: i check $example"
      if ! "$i" check --project "$example"; then
        echo "checks: i check failed for $example" >&2
        exit 1
      fi
    done
    ./scripts/dev-new-machine "$i"
  fi
  if [[ -n "${CHECKS_I_PROJECTS:-}" ]]; then
    for project_opt in $CHECKS_I_PROJECTS; do
      if [[ -n "${CHECKS_I_WORKERS:-}" ]]; then
        "$i" test --project "${project_opt%@*}" --opt "${project_opt##*@}" --workers "$CHECKS_I_WORKERS"
      else
        "$i" test --project "${project_opt%@*}" --opt "${project_opt##*@}"
      fi
    done
  else
    for level in 0 2; do
      "$i" test --project stdlib --opt "$level"
      "$i" test --project examples/hello --opt "$level"
      "$i" test --project bench --opt "$level"
    done
  fi
  if (( first )); then
    ./scripts/wasi-smoke "$i"
    if [[ "${CHECKS_SKIP_CORPUS:-}" = 1 ]]; then
      :
    elif [[ -n "${CHECKS_SHARD:-}" ]]; then
      ./scripts/review-corpus run --binary "$i" --shard "$CHECKS_SHARD" --jobs 4
    else
      ./scripts/review-corpus run --binary "$i" --jobs 3
    fi
    ./scripts/test-generation --mode short --binary "$i"
  fi
}

js() {
  binaryen
  cargo build --locked -p ilang-cli
  npm ci --ignore-scripts
  npm test
  npm run test:browser
}

editors() {
  npm --prefix editors/vscode ci --ignore-scripts
  npm --prefix editors/vscode test
  (
    cd editors/tree-sitter-i
    npm ci
    npx tree-sitter generate
    git diff --exit-code -- src
    npx tree-sitter test
    cmp queries/highlights.scm ../zed/languages/i/highlights.scm
    for query in queries/highlights.scm ../zed/languages/i/{brackets,indents,outline}.scm; do
      npx tree-sitter query -q "$query" ../../examples/hello/src/main.i
    done
    while IFS= read -r -d '' source; do
      npx tree-sitter parse -q "$source"
    done < <(find ../../lib ../../stdlib ../../examples -name '*.i' -print0)
  )
  (
    cd editors/zed
    local target_libdir
    target_libdir=$(rustc --print target-libdir --target wasm32-wasip1)
    if [[ -d "$target_libdir" ]]; then
      cargo check --locked --target wasm32-wasip1
    else
      cargo check --locked
    fi
  )
}

parts=("$@")
if [[ ${#parts[@]} -eq 0 ]]; then parts=(rust i js editors); fi
for part in "${parts[@]}"; do
  case "$part" in
    rust | rust-lint | rust-test | snippets | doc-paths | no-compat | i | js | editors) "$part" ;;
    *) echo "checks: unknown part '$part' (rust, rust-lint, rust-test, snippets, doc-paths, no-compat, i, js or editors)" >&2; exit 2 ;;
  esac
done
