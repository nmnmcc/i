#!/usr/bin/env python3
"""Counterexamples for scripts/check-doc-examples."""
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path

CHECK = Path(__file__).resolve().with_name('check-doc-examples')
BINARY = os.environ.get('I_BIN', str(Path(__file__).resolve().parents[1] / 'target/release/i'))


def run(root):
    return subprocess.run([sys.executable, '-I', str(CHECK), '--root', str(root), '--docs'],
                          capture_output=True, text=True, env={**os.environ, 'I_BIN': BINARY})


def write(root, path, body):
    target = root / path
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(body)


def exemptions(root, entries):
    (root / 'scripts/check-doc-examples.json').write_text(json.dumps(entries) + '\n')


def main():
    with tempfile.TemporaryDirectory() as directory:
        root = Path(directory)
        write(root, 'stdlib/i.toml', 'name = "i"\n')
        write(root, 'stdlib/src/foo.i', '(\n\tadd\n)\nadd = (n : Int) -> Int { n + 1 }\n')
        write(root, 'stdlib/src/io.i', '(\n\tIo(..)\n)\nIo = (print = (String) -> ())\n')
        (root / 'scripts').mkdir()
        exemptions(root, {})

        write(root, 'docs/page.mdx', '```i\nfoo.add(1)\n```\n')
        result = run(root)
        assert result.returncode == 0, result.stderr

        # A documented example the compiler rejects fails, with its page.
        write(root, 'docs/page.mdx', '```i\nfoo.add(missing)\n```\n')
        result = run(root)
        assert result.returncode == 1, result.stdout
        assert 'docs/page.mdx:1' in result.stderr, result.stderr
        assert 'missing' in result.stderr, result.stderr

        # A reason suppresses a contextual example.
        key = [line for line in result.stderr.splitlines() if '[docs/page.mdx' in line][0]
        key = key[key.index('[docs/page.mdx'):].strip('[]')
        exemptions(root, {key: 'context: test'})
        result = run(root)
        assert result.returncode == 0, result.stderr

        # Two identical blocks are one key and one reason: both are exempt.
        write(root, 'docs/page.mdx',
              '```i\nfoo.add(missing)\n```\n\n```i\nfoo.add(missing)\n```\n')
        result = run(root)
        assert result.returncode == 0, result.stderr

        # Inserting a paragraph moves the block down without changing it: the
        # key is made from the block's content, so the same exemption still
        # suppresses it and the check passes.
        write(root, 'docs/page.mdx',
              'A paragraph the example does not need.\n\n```i\nfoo.add(missing)\n```\n')
        result = run(root)
        assert result.returncode == 0, result.stderr

        # A different broken block at the line the old key named is reported,
        # not excused: the content differs, so the key does not match and the
        # old entry is named as stale.
        write(root, 'docs/page.mdx', '```i\nfoo.add(also_missing)\n```\n')
        result = run(root)
        assert result.returncode == 1, result.stdout
        assert 'docs/page.mdx:1' in result.stderr, result.stderr
        assert 'also_missing' in result.stderr, result.stderr
        assert key in result.stderr, result.stderr
        assert 'stale reason' in result.stderr, result.stderr

        # A reason whose block now compiles is stale and fails.
        exemptions(root, {key: 'context: test'})
        write(root, 'docs/page.mdx', '```i\nfoo.add(1)\n```\n')
        result = run(root)
        assert result.returncode == 1, result.stdout
        assert 'stale reason' in result.stderr, result.stderr
        assert key in result.stderr, result.stderr

    print('check-doc-examples counterexamples pass.')
    return 0


if __name__ == '__main__':
    sys.exit(main())
