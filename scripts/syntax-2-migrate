#!/usr/bin/env python3
"""Migrate first-surface i using AST spans, retaining comments and host layout."""
import argparse
import collections
import difflib
import importlib.machinery
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tomllib

ROOT = Path(__file__).resolve().parent.parent
EXTRACT = importlib.machinery.SourceFileLoader('syntax_snippets', str(ROOT / 'scripts/old-syntax-check')).load_module()


def literal_edits(literal, before, after, rust):
    """Map decoded character edits back to a Rust/JS literal's original layout."""
    raw = re.match(r'r(#+)?"', literal) if rust else None
    begin = len(raw[0]) if raw else 1
    quote = literal[0] if not raw else '"'
    starts, ends, decoded = [], [], []
    i = begin
    while len(decoded) < len(before):
        start = i
        ch = literal[i]
        i += 1
        if ch == '\\' and not raw:
            escape = literal[i]
            i += 1
            if rust and escape in '\r\n':
                while i < len(literal) and literal[i].isspace():
                    i += 1
                continue
            if escape == 'u':
                if rust:
                    end = literal.index('}', i)
                    ch = chr(int(literal[i + 1:end].replace('_', ''), 16))
                    i = end + 1
                else:
                    ch = chr(int(literal[i:i + 4], 16))
                    i += 4
            elif escape == 'x':
                ch = chr(int(literal[i:i + 2], 16))
                i += 2
            else:
                ch = {'n': '\n', 'r': '\r', 't': '\t', '0': '\0'}.get(escape, escape)
        decoded.append(ch)
        starts.append(start)
        ends.append(i)
    if ''.join(decoded) != before:
        raise ValueError('literal decoder disagrees with the source extractor')

    def encode(text):
        if raw:
            return text
        out = text.replace('\\', '\\\\').replace(quote, '\\' + quote)
        out = out.replace('\n', '\\n').replace('\r', '\\r').replace('\t', '\\t')
        return out.replace('\0', '\\u{0}' if rust else '\\0')

    edits = []
    for kind, a, b, c, d in difflib.SequenceMatcher(None, before, after, autojunk=False).get_opcodes():
        if kind == 'equal':
            continue
        start = starts[a] if a < len(starts) else ends[-1] if ends else begin
        end = ends[b - 1] if b > a else start
        edits.append((start, end, encode(after[c:d])))
    for start, end, replacement in reversed(edits):
        literal = literal[:start] + replacement + literal[end:]
    return literal


def build():
    command = ['cargo', 'build', '-p', 'ilang-syntax', '--example', 'migrate-syntax2', '--locked']
    heavy = ROOT.parent / 'cache/heavy'
    shell = ROOT.parent.parent
    if not heavy.is_file():
        heavy, shell = ROOT / '.rd/cache/heavy', ROOT
    if heavy.is_file():
        command = [str(heavy), 'direnv', 'exec', str(shell)] + command
    subprocess.run(command, cwd=ROOT, check=True)
    command[-5:] = ['-p', 'ilang-check', '--example', 'migration-types', '--locked']
    subprocess.run(command, cwd=ROOT, check=True)


def migrate_many(sources):
    binary = Path(os.environ.get('CARGO_TARGET_DIR', ROOT / 'target')) / 'debug/examples/migrate-syntax2'
    data = ''.join(json.dumps(source, ensure_ascii=False) + '\n' for source in sources)
    process = subprocess.run([str(binary)], input=data, text=True, capture_output=True, check=True)
    return [json.loads(line) for line in process.stdout.splitlines()]


def package_of(path):
    for parent in path.parents:
        if (parent / 'i.toml').is_file():
            return parent
        if parent == ROOT:
            break
    return None


def entry_migration(item, result):
    """Return source, optional manifest declaration, and explicit manual work."""
    source = result['source']
    mains = result['mains']
    if not mains:
        return source, None, None
    if len(mains) != 1:
        return None, None, 'multiple legacy entries need review'
    name = mains[0]
    if name.startswith('<'):
        return None, None, 'invalid legacy entry annotation needs a reviewed fixture change'
    path = ROOT / item['path']
    single = item['kind'] != 'file' or item['path'].startswith('tests/spec/') and path.parent.name.replace('.', '').isdigit()
    package = package_of(path) if item['kind'] == 'file' and not single else None
    default_module = single or package is not None and path == package / 'src/main.i'
    if default_module and name == 'main':
        return source, None, None
    names = result['names']
    old = [token for token in names if token['name'] == name]
    if default_module and not any(token['name'] == 'main' for token in names) and len(old) == 1:
        token = old[0]
        # Rust offsets count UTF-8 bytes.
        data = source.encode()
        source = (data[:token['start']] + b'main' + data[token['end']:]).decode()
        return source, None, None
    if package is None:
        return None, None, f'legacy entry `{name}` needs a reviewed rename or [entries] declaration'
    relative = path.relative_to(package)
    if relative.parts[0] not in ('src', 'test'):
        return None, None, f'entry outside src/test: {relative}'
    module = '.'.join(relative.with_suffix('').parts[1:])
    return source, (package / 'i.toml', module + '.' + name), None


def add_entry(path, target):
    text = path.read_bytes().decode()
    data = tomllib.loads(text)
    existing = data.get('entries', {})
    for name, value in existing.items():
        if value == target:
            return name
    name = 'legacy'
    while name in existing:
        name += '_entry'
    line = f'{name} = {json.dumps(target)}\n'
    section = re.search(r'(?m)^\[entries\][^\n]*\n', text)
    if section:
        text = text[:section.end()] + line + text[section.end():]
    else:
        text += '\n[entries]\n' + line
    path.write_bytes(text.encode())
    return name


def main():
    parser = argparse.ArgumentParser(__doc__)
    parser.add_argument('paths', nargs='*')
    parser.add_argument('--repo', action='store_true', help='all extracted repository sources, including host literals')
    parser.add_argument('--write', action='store_true')
    parser.add_argument('--check', action='store_true', help='report changes without writing files')
    parser.add_argument('--report', type=Path)
    parser.add_argument('--use-built-tool', action='store_true', help='reuse an already built migration example')
    args = parser.parse_args()
    os.chdir(ROOT)
    if not args.check:
        args.write = True
    if not args.use_built_tool:
        build()
    selected = [str(Path(p)) for p in args.paths]
    items = [item for item in EXTRACT.snippets() if args.repo or any(item['path'] == p or item['path'].startswith(p.rstrip('/') + '/') for p in selected)]
    known = {item['path'] for item in items if item['kind'] == 'file'}
    for selected_path in selected:
        path = Path(selected_path)
        files = path.rglob('*.i') if path.is_dir() else [path]
        for file in files:
            name = str(file)
            if file.suffix == '.i' and file.is_file() and name not in known:
                source = file.read_bytes().decode()
                items.append({'path': name, 'kind': 'file', 'host': source,
                              'source': source, 'start': 0, 'end': len(source), 'line': 1})
                known.add(name)
    if not items:
        parser.error('name source files/directories, or use --repo')
    results = migrate_many([item['host'] if item['kind'] == 'file' else item['source'] for item in items])
    reviewed = json.loads((ROOT / 'scripts/syntax-2-reviewed.json').read_text())
    changes = collections.defaultdict(list)
    checked_packages = {}
    report = {'areas': {}, 'changed': [], 'manual': [], 'invalid': [], 'entries': [], 'reviewed': []}
    for item, result in zip(items, results):
        label = f"{item['path']}:{item['line']}"
        decision = reviewed.get(EXTRACT.identity(item['path'], item['source']), {})
        if decision.get('legacy_test'):
            report['reviewed'].append(label + ': legacy compatibility test')
            continue
        if result.get('diagnostics'):
            if result['diagnostics'] == decision.get('diagnostics'):
                report['reviewed'].append(label)
                continue
            report['invalid'].append({'source': label, 'diagnostics': result['diagnostics']})
            continue
        if result['empty']:
            package = package_of(ROOT / item['path']) if item['kind'] == 'file' else None
            records = {}
            if package is not None:
                if package not in checked_packages:
                    binary = Path(os.environ.get('CARGO_TARGET_DIR', ROOT / 'target')) / 'debug/examples/migration-types'
                    checked_packages[package] = json.loads(subprocess.run([str(binary), str(package)], cwd=ROOT, text=True, capture_output=True, check=True).stdout)
                records = checked_packages[package]
            path = str((ROOT / item['path']).relative_to(package)) if package else ''
            source_bytes = item['source'].encode()
            for case in result['empty']:
                if case in decision.get('empty', []):
                    report['reviewed'].append(label + ': ' + case)
                    continue
                offset = int(case.rsplit(' ', 1)[1])
                if case.startswith('empty tuple expression ') and offset in records.get(path, []):
                    continue
                line = item['line'] + source_bytes[:offset].count(b'\n')
                report['manual'].append({'source': f"{item['path']}:{line}", 'empty_tuples': case})
            if any(case['source'].startswith(item['path'] + ':') for case in report['manual']):
                continue
        after, declaration, error = entry_migration(item, result)
        if error:
            report['manual'].append({'source': label, 'entry': error})
            continue
        before = item['host'] if item['kind'] == 'file' else item['source']
        if after == before:
            continue
        if declaration:
            path, target = declaration
            name = add_entry(path, target) if args.write else '(pending)'
            report['entries'].append({'manifest': str(path), 'name': name, 'target': target, 'command': name})
        area = item['path'].split('/')[0]
        counts = report['areas'].setdefault(area, [0, 0, 0, 0])
        for i, count in enumerate(result['counts']):
            counts[i] += count
        report['changed'].append(label)
        if item['kind'] == 'file':
            replacement = after
        elif item['kind'] == 'markdown':
            host = item['host'][item['start']:item['end']]
            offset = host.index('\n') + 1
            replacement = host[:offset] + after + host[offset + len(item['source']):]
        else:
            literal = item['host'][item['start']:item['end']]
            replacement = literal_edits(literal, item['source'], after, item['path'].endswith('.rs'))
        changes[item['path']].append((item['start'], item['end'], replacement))
    if args.write:
        for path, edits in changes.items():
            source = (ROOT / path).read_bytes().decode()
            for start, end, replacement in sorted(edits, reverse=True):
                source = source[:start] + replacement + source[end:]
            (ROOT / path).write_bytes(source.encode())
    if args.report:
        args.report.parent.mkdir(parents=True, exist_ok=True)
        args.report.write_text(json.dumps(report, indent=2, ensure_ascii=False) + '\n')
    print(json.dumps({key: value if key == 'areas' else len(value) for key, value in report.items()}, indent=2))
    if report['invalid'] or report['manual']:
        for case in report['invalid'] + report['manual']:
            print(f"{case['source']}: {case.get('diagnostics', case.get('empty_tuples', case.get('entry')))}", file=sys.stderr)
        raise SystemExit(1)


if __name__ == '__main__':
    main()
