#!/usr/bin/env python3
"""Semantic diagnostic requirements must distinguish expected and stray cycles."""
import importlib.machinery
import importlib.util
from pathlib import Path
import unittest

loader = importlib.machinery.SourceFileLoader('corpus', str(Path(__file__).with_name('corpus.py')))
spec = importlib.util.spec_from_loader(loader.name, loader)
corpus = importlib.util.module_from_spec(spec)
loader.exec_module(corpus)


class DiagnosticRequirements(unittest.TestCase):
    def test_explicit_cycle_requirement_can_pass(self):
        self.assertTrue(corpus.diagnostic_codes_match('error[E0505]: recursive type', ['E0505']))

    def test_cycle_cannot_replace_a_provider_error(self):
        self.assertFalse(corpus.diagnostic_codes_match('error[E0505]: recursive type', ['E0515']))

    def test_stray_cycle_still_invalidates_an_unrelated_rejection(self):
        self.assertFalse(corpus.diagnostic_codes_match('error[E0505]: cycle\nerror[E0515]: provider', ['E0515']))

    def test_separate_provider_and_cycle_requirements_both_remain_required(self):
        both = 'error[E0505]: cycle\nerror[E0515]: provider'
        self.assertTrue(corpus.diagnostic_codes_match(both, ['E0515'], expected_cycle=True))
        self.assertFalse(corpus.diagnostic_codes_match('error[E0505]: cycle', ['E0515'], expected_cycle=True))
        self.assertFalse(corpus.diagnostic_codes_match('error[E0515]: provider', ['E0505'], expected_cycle=True))

    def test_missing_error_or_warning_does_not_satisfy_requirement(self):
        self.assertFalse(corpus.diagnostic_codes_match('warning[W0504]: unused', ['E0505']))


class AtomicGoldenWrites(unittest.TestCase):
    def test_failed_run_leaves_the_golden_and_reports(self):
        import contextlib
        import io
        import os
        import tempfile
        with tempfile.TemporaryDirectory() as directory:
            path = Path(directory) / 'expected.json'
            path.write_bytes(b'old\n')
            errors = io.StringIO()
            old = os.environ.get('UPDATE')
            os.environ['UPDATE'] = '1'
            try:
                with contextlib.redirect_stderr(errors):
                    corpus.commit_goldens([(path, 'new\n')], False)
            finally:
                if old is None:
                    del os.environ['UPDATE']
                else:
                    os.environ['UPDATE'] = old
            self.assertEqual(path.read_bytes(), b'old\n')
            self.assertIn(f'not updated: {path}', errors.getvalue())

    def test_successful_update_replaces_the_golden_completely(self):
        import tempfile
        with tempfile.TemporaryDirectory() as directory:
            path = Path(directory) / 'expected.json'
            path.write_bytes(b'old\n')
            corpus.commit_goldens([(path, 'new\n')], True)
            self.assertEqual(path.read_bytes(), b'new\n')
            self.assertEqual([entry.name for entry in Path(directory).iterdir()], ['expected.json'])

    def test_dump_writes_the_whole_value(self):
        import tempfile
        with tempfile.TemporaryDirectory() as directory:
            path = Path(directory) / 'expected.json'
            corpus.dump(path, {'outcome': {'check': {'exit': 0}}})
            self.assertEqual(corpus.json.loads(path.read_text()), {'outcome': {'check': {'exit': 0}}})
            self.assertEqual([entry.name for entry in Path(directory).iterdir()], ['expected.json'])


class K4AuditGoldenWrites(unittest.TestCase):
    def test_failed_audit_keeps_both_outputs_and_reports_them(self):
        import contextlib
        import io
        import os
        import sys
        directory = str(Path(__file__).resolve().parent)
        sys.path.insert(0, directory)
        try:
            loader = importlib.machinery.SourceFileLoader(
                'k4_audit_under_test', str(Path(directory) / 'k4_audit.py'))
            spec = importlib.util.spec_from_loader(loader.name, loader)
            audit = importlib.util.module_from_spec(spec)
            loader.exec_module(audit)
        finally:
            sys.path.remove(directory)
        def fail():
            raise RuntimeError('boom')
        audit._audit = fail
        errors = io.StringIO()
        old = os.environ.get('UPDATE')
        os.environ['UPDATE'] = '1'
        try:
            with contextlib.redirect_stderr(errors):
                with self.assertRaises(RuntimeError):
                    audit.audit()
        finally:
            if old is None:
                del os.environ['UPDATE']
            else:
                os.environ['UPDATE'] = old
        message = errors.getvalue()
        self.assertIn('not updated:', message)
        self.assertIn('k4-integration.json', message)
        self.assertIn('k4-integration.md', message)


if __name__ == '__main__':
    unittest.main()
