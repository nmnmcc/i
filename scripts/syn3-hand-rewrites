#!/usr/bin/env bash
# The hand rewrites of the conversion to syntax three (syntax-3.md §7.3),
# applied to a converted tree. Called by scripts/syn3-convert-all.
#
#   scripts/syn3-hand-rewrites ROOT
set -euo pipefail
root=$(cd "$1" && pwd)
python3 - "$root" <<'PY'
import pathlib, re, sys
root = pathlib.Path(sys.argv[1])

def rewrite(path, edits):
    p = root / path
    if not p.exists():
        return
    text = p.read_text()
    for old, new in edits:
        # Applied already (the conversion runs again on a newer tree).
        if new in text and old not in text:
            continue
        if old not in text:
            sys.exit(f"syn3-hand-rewrites: FAILED: {path}: expected text not found: {old!r}")
        text = text.replace(old, new)
    p.write_text(text)

# None left: the annotation of `std/test/list_test.i` `collect` (§7.3, a
# written need wider than the body's) is made by the migrator now
# (convert.rs `annotated`). New entries: rewrite(path, [(old, new)]).
PY
