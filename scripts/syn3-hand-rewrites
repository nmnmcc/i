#!/usr/bin/env bash
# The hand rewrites of the conversion to syntax three (syntax-3.md §7.3),
# applied to a converted tree. Called by scripts/syn3-convert-all.
#
#   scripts/syn3-hand-rewrites ROOT
set -euo pipefail
root=$(cd "$1" && pwd)
python3 - "$root" <<'PY'
import pathlib, re, sys
root = pathlib.Path(sys.argv[1])

def rewrite(path, edits):
    p = root / path
    if not p.exists():
        return
    text = p.read_text()
    for old, new in edits:
        if old not in text:
            sys.exit(f"syn3-hand-rewrites: {path}: expected text not found: {old!r}")
        text = text.replace(old, new)
    p.write_text(text)

# §7.3, "a written `! N` that is wider than what the body needs is kept as a
# type annotation on the binding": the migrator drops the needs of every
# function literal. This generator provides `Yield` to a body whose need has
# a row variable, and today's checker cannot show the inferred type (E0515),
# so the type is written on the binding.
rewrite("std/test/list_test.i", [(
    "collect = <A, N>(body: () <- (Yield(A), ..N) -> Nil) -> List(A) {",
    "collect: <A, N>(() <- (Yield(A), ..N) -> Nil) <- N -> List(A) = (body) {",
)])
PY
