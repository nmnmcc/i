#!/usr/bin/env bash
# The hand rewrites of the conversion to syntax three (syntax-3.md §7.3),
# applied to a converted tree. Called by scripts/syn3-convert-all.
#
#   scripts/syn3-hand-rewrites ROOT
set -euo pipefail
root=$(cd "$1" && pwd)
python3 - "$root" <<'PY'
import pathlib, re, sys
root = pathlib.Path(sys.argv[1])

def rewrite(path, edits):
    p = root / path
    if not p.exists():
        return
    text = p.read_text()
    for old, new in edits:
        # Applied already (the conversion runs again on a newer tree).
        if new in text and old not in text:
            continue
        if old not in text:
            sys.exit(f"syn3-hand-rewrites: FAILED: {path}: expected text not found: {old!r}")
        text = text.replace(old, new)
    p.write_text(text)

# The annotation of `std/test/list_test.i` `collect` (§7.3, a written need
# wider than the body's) is made by the migrator now (convert.rs `annotated`).

# §7.3 "labelled call of a function": the function is a value (`f = add`),
# so the text does not show its parameters (note `labelled-call`); stage 4's
# resolver-aware migrator would make it positional. `add(a, b)`.
rewrite("tests/spec/10.1/externals.i", [(
    "core.inspect(f(b = 1, a = 2))",
    "core.inspect(f(2, 1))",
)])
# `! Name = name` gave the key by its written type; `{ … } <- (name)` keys it
# by the type of `name`, which must be known there (E0225): the type goes on
# the parameter.
rewrite("tests/spec/9/environment.i", [(
    "count = (n, acc, name) {",
    "count = (n, acc, name: Name) {",
)])
PY
