#!/usr/bin/env bash
set -euo pipefail
cd "${ILANG_ROOT:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}"
devenv --version
rustc --version
cargo --version
blaze --version
blaze toolchain
printf 'Blaze backport: %s\n' "${ILANG_BLAZE_BACKPORT:-unknown (enter the Devenv shell)}"
wasmtime --version
wasm-tools --version
node --version
printf 'Playwright browser bundle: %s\n' "${ILANG_PLAYWRIGHT_VERSION:-unknown (enter the Devenv shell)}"
node -e 'const lock = require("./package-lock.json"); console.log("Playwright client (lockfile): " + lock.packages["node_modules/@playwright/test"].version)'
hyperfine --version
command time --version
watchexec --version
gleam --version
python3 --version
