#!/usr/bin/env python3
"""Syntax three, stage 4 (docs/design/syntax-3.md §7.3), for text that is not
checked as a package: comments of `.i` files, `i` fences in Markdown and i
snippets in Rust sources. Calls by label of functions whose parameters are
known (std, the library `i`, and functions defined in the same text) become
calls by position. The checked files are migrated by
`cargo run --release -p ilang-cli --example migrate-syntax3-labels`.

Usage: scripts/migrate-syntax3-labels-text [--check] [--code] [FILE...]
`--code` also rewrites the code of the given `.i` files (for calls in expanded
code that the checked migration lists as not migrated).
Without files: every tracked `.i`, `.md` and `.rs` file. Running it again
changes nothing.
"""
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
IDENT = r"[a-z_][a-z0-9_]*"
DEF = re.compile(r"(?m)^[ \t]*(" + IDENT + r")(?:\([A-Z][A-Za-z0-9_, ]*\))?(?:: | = )\(")
CALL = re.compile(r"(?<![\w.])((?:" + IDENT + r"\.)?" + IDENT + r")\(")
LABEL = re.compile(r"\s*(" + IDENT + r")\s*:(?![:=])\s*")
OPEN = "([{"
# Space and the `//` of a comment line before a part.
CODE = False
PREFIX = re.compile(r"(?:\s|//+ ?)*")
CLOSE = ")]}"


def close_of(text, i):
    """Index of the bracket closing the one at `i`, or None."""
    depth = 0
    j = i
    while j < len(text):
        c = text[j]
        if c == '"':
            j += 1
            while j < len(text) and text[j] != '"':
                j += 2 if text[j] == "\\" else 1
        elif text.startswith("<<", j) or text.startswith(">>", j):
            depth += 1 if text[j] == "<" else -1
            j += 1
        elif c in OPEN:
            depth += 1
        elif c in CLOSE:
            depth -= 1
            if depth == 0:
                return j
        elif c == "\n" and depth > 6:
            return None
        j += 1
    return None


def split_top(text):
    """Top-level comma-separated parts as (start, end) in `text`."""
    parts = []
    depth = 0
    start = 0
    j = 0
    while j < len(text):
        c = text[j]
        if c == '"':
            j += 1
            while j < len(text) and text[j] != '"':
                j += 2 if text[j] == "\\" else 1
        elif text.startswith("<<", j) or text.startswith(">>", j):
            depth += 1 if text[j] == "<" else -1
            j += 1
        elif c in OPEN:
            depth += 1
        elif c in CLOSE:
            depth -= 1
        elif c == "," and depth == 0:
            parts.append((start, j))
            start = j + 1
        elif c == "\n" and depth == 0:
            if PREFIX.fullmatch(text[start:j]) is None:
                parts.append((start, j))
                start = j
        j += 1
    if PREFIX.fullmatch(text[start:]) is None:
        parts.append((start, len(text)))
    return parts


def param_label(p):
    p = p.strip()
    if re.match(IDENT + r"\s*!\s", p):
        return "!"
    depth = 0
    for k, c in enumerate(p):
        if c in OPEN:
            depth += 1
        elif c in CLOSE:
            depth -= 1
        elif c == ":" and depth == 0:
            p = p[:k]
            break
    last = p.split("=")[-1].strip()
    return last if re.fullmatch(IDENT, last) and last != "_" else None


def params_at(text, open_at):
    end = close_of(text, open_at)
    if end is None:
        return None
    inner = text[open_at + 1 : end]
    labels = [param_label(inner[s:e]) for s, e in split_top(inner)]
    return [l for l in labels if l != "!"]


def definitions(text):
    out = {}
    for m in DEF.finditer(text):
        ps = params_at(text, m.end() - 1)
        if ps is not None and any(ps):
            out.setdefault(m.group(1), ps)
    return out


def library():
    table = {}
    for f in sorted((ROOT / "std/src").glob("*.i")) + sorted((ROOT / "lib/i").glob("*.i")):
        for name, ps in definitions(f.read_text()).items():
            table.setdefault(f"{f.stem}.{name}", ps)
    for name, ps in definitions((ROOT / "lib/prelude.i").read_text()).items():
        table.setdefault(name, ps)
    return table


def rewrite(text, table, allowed, report, where):
    """One pass: the innermost labelled calls in `allowed` ranges."""
    local = definitions(text)
    edits = []
    for m in CALL.finditer(text):
        at = m.start()
        if not allowed(at):
            continue
        name = m.group(1)
        if text[max(0, at - 3) : at] == "fn ":
            continue
        ps = local.get(name) or table.get(name)
        if ps is None and "." in name:
            ps = local.get(name.split(".")[1]) if name.split(".")[0] in ("self",) else None
        if ps is None:
            continue
        open_at = m.end() - 1
        end = close_of(text, open_at)
        if end is None:
            continue
        inner = text[open_at + 1 : end]
        parts = split_top(inner)
        labels = [LABEL.match(inner[s:e], PREFIX.match(inner[s:e]).end()) for s, e in parts]
        if not any(labels):
            continue
        before = text[:at].rstrip()
        piped = 1 if before.endswith("|>") else 0
        places = []
        pos = piped
        ok = True
        for (s, e), lab in zip(parts, labels):
            if lab is None:
                places.append(pos)
                pos += 1
            elif lab.group(1) in ps:
                places.append(ps.index(lab.group(1)))
            else:
                ok = False
        if not ok or len(set(places)) != len(places):
            report.append(f"{where(at)}: cannot place the arguments of `{name}`")
            continue
        values = []
        for (s, e), lab in zip(parts, labels):
            seg = inner[s:e]
            lead = PREFIX.match(seg).end()
            trail = len(seg) - len(seg.rstrip())
            body = seg[lead : len(seg) - trail]
            lab = LABEL.match(body)
            if lab is not None:
                body = body[lab.end() :]
            values.append((lead, trail, body))
        order = sorted(range(len(parts)), key=lambda k: places[k])
        new = []
        for k, (s, e) in enumerate(parts):
            seg = inner[s:e]
            lead = seg[: PREFIX.match(seg).end()]
            trail = seg[len(seg.rstrip()) :]
            new.append((s, e, lead + values[order[k]][2] + trail))
        if order != sorted(order):
            moved = [values[k][2] for k in order if not re.fullmatch(r"[\w.\"-]+", values[k][2])]
            if len(moved) > 1:
                report.append(f"{where(at)}: `{name}` reordered; check the order of {moved}")
        for s, e, r in new:
            edits.append((open_at + 1 + s, open_at + 1 + e, r))
    # Innermost first: drop edits inside the range of another call's edits
    # that overlap.
    edits.sort()
    out = []
    for e in edits:
        if out and e[0] < out[-1][1]:
            continue
        out.append(e)
    for s, e, r in reversed(out):
        text = text[:s] + r + text[e:]
    return text


def comment_ranges(text):
    ranges = []
    for m in re.finditer(r"(?m)//[^\n]*$", text):
        ranges.append((m.start(), m.end()))
    return ranges


def fence_ranges(text):
    return [(m.start(1), m.end(1)) for m in re.finditer(r"(?ms)^\s*```i[^\n]*\n(.*?)^\s*```", text)]


def string_ranges(text):
    out = []
    for m in re.finditer(r'r(#*)"(.*?)"\1', text, re.S):
        out.append((m.start(2), m.end(2)))
    for m in re.finditer(r'(?<![r#\w])"((?:[^"\\]|\\.)*)"', text, re.S):
        out.append((m.start(1), m.end(1)))
    return out


def migrate(path, table, check, report):
    text = path.read_text()
    if "syn3-labels: keep" in text:
        return 0
    old = text
    kind = path.suffix
    for _ in range(6):
        if kind == ".i" and CODE:
            ranges = [(0, len(text))]
        elif kind == ".i":
            ranges = comment_ranges(text)
        elif kind == ".md":
            ranges = fence_ranges(text)
        else:
            ranges = string_ranges(text)
        if not ranges:
            break
        def allowed(at, ranges=ranges):
            return any(s <= at < e for s, e in ranges)
        def where(at, text=text):
            return f"{path.relative_to(ROOT)}:{text[:at].count(chr(10)) + 1}"
        new = rewrite(text, table, allowed, report, where)
        if new == text:
            break
        text = new
    if text != old:
        if not check:
            path.write_text(text)
        return 1
    return 0


def main():
    args = sys.argv[1:]
    check = "--check" in args
    global CODE
    CODE = "--code" in args
    files = [Path(a).resolve() for a in args if a not in ("--check", "--code")]
    if not files:
        listed = subprocess.run(
            ["git", "ls-files", "*.i", "*.md", "*.rs"], cwd=ROOT, capture_output=True, text=True, check=True
        ).stdout.split()
        files = [ROOT / f for f in listed if not f.startswith(("tests/review/", "crates/ilang-syntax/tests/fixtures"))]
    table = library()
    report = []
    changed = sum(migrate(f, table, check, report) for f in files)
    for r in report:
        print(r)
    print(f"{changed} files {'to change' if check else 'changed'}")
    return 1 if check and changed else 0


if __name__ == "__main__":
    sys.exit(main())
