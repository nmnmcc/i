---
import Layout from '@/layouts/Layout.astro';
import { Home } from '@/components/home';
import { getEntry, render } from 'astro:content';
import '@/styles/home.css';

const home = await getEntry('home', 'index.mdx');
if (!home) throw new Error('The checked home-page content is missing.');
const { Content } = await render(home);
---

<Layout title={home.data.title} description={home.data.description}>
  <Home client:load pathname={Astro.url.pathname} params={Astro.params}>
    <div class="home-content">
      <Content />
    </div>
  </Home>
</Layout>
