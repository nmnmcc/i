{
  "name": "i-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "dev": "astro dev",
    "preview": "astro preview",
    "start": "astro dev",
    "types:check": "astro sync && tsc --noEmit",
    "astro": "astro",
    "generate": "python3 scripts/generate-standard.py && python3 scripts/generate-library-test && python3 scripts/generate-library.py && python3 scripts/generate-design-index.py",
    "prebuild": "npm run generate && python3 ../scripts/check-doc-modules",
    "predev": "npm run generate && python3 ../scripts/check-doc-modules",
    "check:links": "npm run check:spec-links && npm run check:fonts && npm run check:selector && python3 scripts/check-links.py && python3 ../scripts/check-doc-modules-test",
    "check:spec-links": "python3 scripts/check-spec-links-test && python3 scripts/check-spec-links.py",
    "check:placeholders": "python3 scripts/check-placeholders-test && python3 scripts/check-placeholders.py",
    "check:rendering": "python3 scripts/check-example-rendering.py",
    "check:format": "python3 scripts/format-fences-test && python3 scripts/format-fences.py",
    "check:examples": "npm run check:format && python3 scripts/check-examples.py && python3 scripts/run-examples.py --no-placeholders",
    "check:fonts": "python3 scripts/check-fonts-test && python3 scripts/check-fonts.py",
    "check:selector": "node --test scripts/home-selector-test.mjs",
    "check:home-layout": "node scripts/home-layout-test.mjs"
  },
  "dependencies": {
    "@astrojs/react": "7.1.7",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fumadocs/astro": "0.3.0",
    "@fumadocs/satteri": "0.8.0",
    "astro": "7.4.10",
    "fumadocs-core": "16.19.0",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.19.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "shiki": "4.6.0",
    "takumi-js": "2.20.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/mdx": "2.0.14",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2"
  }
}
