diff --git a/tests/spec/9.9/task_run_supplied_services.i b/tests/spec/9.9/task_run_supplied_services.i
new file mode 100644
index 0000000000000000000000000000000000000000..79454ae098b2aa624d29a8d05bdae3efe56df310
--- /dev/null
+++ b/tests/spec/9.9/task_run_supplied_services.i
@@ -0,0 +1,18 @@
+// spec: 9.9
+// expect: pass
+// run/test supply their callback's Scheduler; their caller supplies Runner.
+(
+	i/task
+	rng = i/random
+)
+
+only_runner: (() <- (task.Scheduler) -> Nil) <- (task.Runner) -> Nil = (
+	body
+) <- (runner: task.Runner) { task.run(body) }
+
+only_runner_test: (rng.Generator, () <- (task.Scheduler) -> Nil) <- (
+	Fail(task.ScheduleError),
+	task.Runner,
+) -> Nil = (seed, body) <- (runner: task.Runner) { task.test(seed, [], body) }
+
+main = () { Nil }
