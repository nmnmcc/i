#!/usr/bin/env python3
"""Font-byte, remote-URL and self-hosting regression fixtures."""
import importlib.util
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import unittest

SCRIPTS = Path(__file__).resolve().parent
spec = importlib.util.spec_from_file_location('fonts', SCRIPTS / 'check-fonts.py')
fonts = importlib.util.module_from_spec(spec)
spec.loader.exec_module(fonts)


class FontTests(unittest.TestCase):
    def local_fonts(self, dist):
        for name in fonts.FONT_FILES:
            shutil.copy(fonts.ROOT / 'docs/node_modules' / name, dist / Path(name).name)
        (dist / 'index.html').write_text('<html><body>Local fonts.</body></html>')

    def test_allowlisted_bytes(self):
        with tempfile.TemporaryDirectory() as scratch:
            dist = Path(scratch)
            self.local_fonts(dist)
            errors, count, size = fonts.audit(dist)
            self.assertEqual(errors, [])
            self.assertEqual(count, 4)
            self.assertGreater(size, 0)

    def test_failing_fixture_and_cli(self):
        result = subprocess.run([sys.executable, str(SCRIPTS / 'check-fonts.py'),
                                 '--dist', str(SCRIPTS / 'font-fixtures/failing')], capture_output=True, text=True)
        self.assertEqual(result.returncode, 1)
        self.assertIn('not an allowlisted DM font', result.stderr)
        self.assertIn('external stylesheet', result.stderr)
        self.assertIn('nonlocal font URL', result.stderr)

    def test_forged_filename_does_not_pass(self):
        with tempfile.TemporaryDirectory() as scratch:
            dist = Path(scratch)
            self.local_fonts(dist)
            (dist / Path(fonts.FONT_FILES[0]).name).write_bytes(b'not DM Sans')
            self.assertTrue(fonts.audit(dist)[0])

    def test_css_urls_and_family(self):
        for css in ('@font-face{font-family:Other;src:url(/font.woff2);font-display:swap}',
                    '@font-face{font-family:"DM Sans";src:url(//other.test/font.woff2);font-display:swap}',
                    '@font-face{font-family:"DM Mono";src:url(data:font/woff2;base64,AA);font-display:swap}',
                    '@import "https://fonts.example.org/css";'):
            self.assertTrue(fonts.css_errors(css, 'https://i.nmnm.cc'), css)
        local = '@font-face{font-family:"DM Sans";src:url(/local.woff2);font-display:swap}'
        self.assertFalse(fonts.css_errors(local, 'https://i.nmnm.cc'))

    def test_external_font_preload_and_inline_style(self):
        parser = fonts.PageFonts('https://i.nmnm.cc')
        parser.feed('<link rel="preload" as="font" href="https://other.test/font.woff2">')
        self.assertTrue(parser.errors)
        extensionless = fonts.PageFonts('https://i.nmnm.cc')
        extensionless.feed('<link rel="preload" as="font" href="https://other.test/font?id=1">')
        self.assertTrue(extensionless.errors)
        self.assertFalse(fonts.remote('https://i.nmnm.cc/local.woff2', 'https://i.nmnm.cc'))
        self.assertFalse(fonts.css_errors('body{background:url(https://images.example.org/photo.png)}', 'https://i.nmnm.cc'))


if __name__ == '__main__':
    unittest.main()
