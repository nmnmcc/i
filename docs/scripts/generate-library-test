#!/usr/bin/env python3
"""Contracts for checked library references; run the generator for the real CLI smoke test."""
import importlib.util
from pathlib import Path
import tempfile
import sys
import unittest
from unittest.mock import patch

spec = importlib.util.spec_from_file_location('library', Path(__file__).with_name('generate-library.py'))
library = importlib.util.module_from_spec(spec)
spec.loader.exec_module(library)


class LibraryPages(unittest.TestCase):
    def test_multiline_type_is_complete(self):
        source = '/// A stream.\nStdio = (\n\twrite = (String) <- (Fail(String)) -> (),\n)\nnext = 1\n'
        self.assertEqual(library.declaration(source, 'Stdio')[1],
                         'Stdio = (\n\twrite = (String) <- (Fail(String)) -> (),\n)')

    def test_comments_and_strings_do_not_close_type_definitions(self):
        source = 'Settings = (\n\tdefault = ")", // )\n\ttext = String,\n)\nnext = 1\n'
        self.assertEqual(library.declaration(source, 'Settings')[1], source.split('\nnext')[0])

    def test_missing_types_fail_before_replacing_pages(self):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            (root / 'stdlib/src').mkdir(parents=True)
            (root / 'stdlib/src/fs.i').write_text('(read_file)\nread_file = (path) { path }\n')
            out = root / 'pages'
            out.mkdir()
            page = out / 'i-fs.mdx'
            page.write_text('last complete generation\n')
            with patch.object(library, 'ROOT', root), patch.object(library, 'OUT', out), \
                    patch.object(library, 'BINARY', Path(sys.executable)), \
                    patch.object(library, 'checked_types', return_value={}):
                with self.assertRaisesRegex(SystemExit, 'Missing inferred signatures: i/fs.read_file'):
                    library.generate()
            self.assertEqual(page.read_text(), 'last complete generation\n')


if __name__ == '__main__':
    unittest.main()
